	journal = {Journal of Physics: Conference Series},
	volume = {3111},
	number = {1},
	pages = {},
	doi = {10.1088/1742-6596/3111/1/012009},
	url = {https://www.scopus.com/pages/publications/105019747406?origin=resultslist},
	affiliations = {School of Automation, Wuhan University of Technology, China},
	abstract = {With the continuous expansion of photovoltaic (PV) power generation scale and the rapid growth of electric vehicle (EV) ownership in rural areas, rural microgrids are facing challenges of three-phase unbalance, severe overload, and new energy consumption difficulties. To effectively enhance the new energy consumption capacity in rural areas, this paper proposes a regulation method for new energy consumption in rural microgrids. The BP neural network and LSTM model are used to accurately predict the PV power generation and load for the next 24 hours, respectively, providing data support for subsequent regulation. A comprehensive objective function is constructed, incorporating the minimization of three-phase unbalance degree, the reduction of forward/backward severe overload risks, and the maximization of PV consumption. The multi-objective particle swarm optimization (MOPSO) algorithm is introduced to optimize and solve the comprehensive objective function, obtaining optimal regulation index data to achieve precise control of devices such as charging piles and energy storage systems. Simulation results show that the proposed method can significantly reduce the three-phase unbalance degree of the distribution network, decrease the probability of severe overload, and improve the PV consumption rate, effectively ensuring the stable operation of rural microgrids and the efficient consumption of new energy. © Published under licence by IOP Publishing Ltd.},
	keywords = {Charge storage; Energy policy; Microgrids; Particle swarm optimization (PSO); Photovoltaics; Rural areas; Energy-consumption; Microgrid; New energies; Objective functions; Photovoltaic power generation; Photovoltaics; Rapid growth; Three phase; Three phasis; Vehicle ownership; Digital storage},
