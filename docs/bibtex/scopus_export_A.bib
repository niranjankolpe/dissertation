@ARTICLE{Deng2024,
	author = {Deng, Shunli and Cui, Shuangxi and Xu, Anchen},
	title = {Power Prediction of Regional Photovoltaic Power Stations Based on Meteorological Encryption and Spatio-Temporal Graph Networks},
	year = {2024},
	journal = {Energies},
	volume = {17},
	number = {14},
	pages = {},
	doi = {10.3390/en17143557},
	url = {https://www.scopus.com/pages/publications/85199640567?origin=resultslist},
	affiliations = {School of Electrical Engineering, Xinjiang University, Urumqi, 830047, China},
	abstract = {Distributed photovoltaic (PV) power stations generally lack historical meteorological data, which is one of the main reasons for their insufficient power prediction accuracy. To address this issue, this paper proposes a power prediction method for regional distributed PV power stations based on meteorological encryption and spatio-temporal graph networks. First, inverse distance weighted meteorological encryption technology is used to achieve the comprehensive coverage of key meteorological resources based on the geographical locations of PV power stations and the meteorological resources of weather stations. Next, the historical power correlations between PV power stations are analyzed, and highly correlated stations are connected to construct a topological graph structure. Then, an improved spatio-temporal graph network model is established based on this graph to deeply mine the spatio-temporal characteristics of regional PV power stations. Furthermore, a dual-layer attention mechanism is added to further learn the feature attributes of nodes and enhance the spatio-temporal features extracted by the spatio-temporal graph network, ultimately achieving power prediction for regional PV power stations. The simulation results indicate that the proposed model demonstrates excellent prediction accuracy, robustness, extensive generalization capability, and broad applicability. © 2024 by the authors.},
	author_keywords = {dual-layer attention mechanism; meteorological encryption; regional photovoltaic power prediction; spatio-temporal graph networks},
	keywords = {Graph neural networks; Graph theory; Meteorology; Weather forecasting; Attention mechanisms; Dual-layer attention mechanism; Dual-layers; Graph networks; Meteorological encryption; Photovoltaic power; Power predictions; Regional photovoltaic power prediction; Spatio-temporal graph network; Spatio-temporal graphs; Cryptography},
	correspondence_address = {S. Cui; School of Electrical Engineering, Xinjiang University, Urumqi, 830047, China; email: ysucsx@126.com},
