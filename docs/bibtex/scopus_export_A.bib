@CONFERENCE{Salameh2024188,
	author = {Salameh, Tareq and Farag, Mena Maurice and Hamid, Abdul Kadir and Hussein, Mousa},
	title = {Adaptive neuro-fuzzy inference system for DC power forecasting for grid-connected PV system in Sharjah},
	year = {2024},
	journal = {Materials Research Proceedings},
	volume = {43},
