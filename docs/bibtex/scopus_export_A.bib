@ARTICLE{Wu2026,
	author = {Wu, Shijun and Wang, Zichen and Shang, Bingqi and Xie, Haojie and Jiang, Jianhua},
	title = {“1 + N” mechanism and data hybrid-driven simplified modeling method for multi-unit systems and its application to multi-stack fuel cell systems},
	year = {2026},
	journal = {Applied Energy},
	volume = {425},
	pages = {},
	doi = {10.1016/j.apenergy.2026.128513},
	url = {https://www.scopus.com/pages/publications/105045690335?origin=resultslist},
	affiliations = {School of Artificial Intelligence and Automation, Key Laboratory of Education Ministry for Image Processing and Intelligent Control, Huazhong University of Science & Technology, Hubei, Wuhan, China; Shenzhen Research Institute of Huazhong University of Science and Technology, Guangdong, Shenzhen, China},
	abstract = {Complex multi-unit systems—such as fuel cells, multi-agent systems, and power networks—commonly face a fundamental trade-off between modeling accuracy and computational efficiency. These challenges stem from the strong nonlinear couplings and intricate interdependencies among units, which conventional deviation-compensation strategies or single-paradigm modeling methods fail to capture effectively. Taking a multi-stack solid oxide fuel cell (SOFC) system as an example, the stacks are structurally similar yet operate under diverse and highly dynamic conditions, making unified high-fidelity modeling computationally prohibitive. To address this issue, this study proposes a general “1 + N” knowledge–data-driven hybrid modeling framework, establishing a structured modeling strategy distinctly separated from conventional point-to-point residual-compensation methods. Within this architecture, the single (“1”) shared mechanistic model encapsulates the common transient response characteristics governing the stacks, while the “N” data-driven deviation models are dedicated to characterizing the inter-unit individual heterogeneities induced by system topology, diverse operating conditions. This hierarchical representation of “shared common mechanisms + individual deviation compensation” preserves strict physical consistency while systematically resolving the critical trade-off between escalating complexity and computational efficiency as the multi-unit system scale expands. Validation on a four-stack SOFC system under dynamic power-switching conditions (1000 W, 2000 W, 3000 W) shows that the proposed framework achieves high prediction accuracy, Under the severe dynamic load-switching transitions, the absolute RMSE is strictly controlled below 0.46 K for thermal characteristics, 0.06 V for stack voltage, 0.015 A for stack current, and within a mole fraction of 0.014 for fuel gas compositions. Compared with a high-fidelity mechanistic model, the computational cost is reduced by roughly 90%, and simulation speed increases by about 14 times. Beyond improving the efficiency and scalability of multi-stack SOFC modeling, this framework offers a unified, interpretable, and computationally efficient paradigm applicable to other multi-unit systems such as battery packs and photovoltaic arrays. © 2026 Elsevier Ltd},
