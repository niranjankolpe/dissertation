@ARTICLE{Tang2024,
	author = {Tang, Lingxi and Ashtine, Masaō and Hua, Weiqi and Wallom, David C.H.},
	title = {Sensitivity analysis of distributed photovoltaic system capacity estimation based on artificial neural network},
	year = {2024},
	journal = {Sustainable Energy, Grids and Networks},
	volume = {39},
