	doi = {10.1016/j.energy.2026.140556},
	url = {https://www.scopus.com/pages/publications/105037850541?origin=resultslist},
	affiliations = {Department of Architecture, Construction and Design, Polytechnic University of Bari, Bari, 70125, Italy},
	abstract = {Recognizing the central role of urban energy districts in meeting European decarbonization targets, the present study introduces a hybrid, multi-scale modelling and optimization framework that bridges urban- and system-scale analysis for prosumer residential districts. The proposed architecture integrates the GIS-driven City Energy Analyst (CEA), dynamic energy system simulation, and machine-learning (ML) surrogate models within an NSGA-III optimization environment. CEA serves as the urban building energy modelling (UBEM) backbone, capturing the spatial and morphological characteristics of the building stock, while TRNSYS resolves the transient behavior of an integrated multi-vector energy system comprising PV, battery, H<sub>2</sub> system, and EVs. A Sobol low-discrepancy design of experiments is used to sample the high-dimensional design space and generate data to train three different ML surrogate regressors. These surrogates are then embedded in NSGA-III multi-criteria optimization, enabling efficient exploration of Pareto-optimal solutions and the identification of balanced knee-point designs. As a case study, a real residential district in Southern Italy is used, where district loads are characterized by generating stochastic user-centric and EV charging profiles via an agent-based LPG-CEA workflow, whose aggregated results are validated against official ARERA statistics. The results show that all ML regressors achieve strong forecasting accuracy across the three techno-enviro-economic targets, with a maximum R2 exceeding 0.998, and that GPR consistently outperforms the tree-based ensemble models. The positive energy district scenario requires 23.5% higher upfront investment than the net-zero case but delivers a 35.7% reduction in life-cycle cost (LCC), the highest peak-shaving index (PSI = 0.450), and the highest round-trip efficiency (RTE) for the hydrogen storage subsystem. SHAP analysis further reveals that, after PV plant power, battery capacity is the second most influential driver of economic performance, whereas fuel-cell rated power is the dominant secondary contributor to environmental impact. © 2026 The Authors. Published by Elsevier Ltd. This is an open access article under the CC BY license. http://creativecommons.org/licenses/by/4.0/},
	author_keywords = {Electric vehicles (EVs); Hydrogen energy storage; Multi-objective optimization; Positive energy district (PED); Renewable energy communities (RECs); Urban building energy modelling (UBEM)},
	keywords = {Italy; Additives; Charging (batteries); Digital storage; Ecodesign; Economics; Electric vehicles; Forecasting; Housing; Hydrogen storage; Investments; Life cycle; Multiobjective optimization; Pareto principle; Secondary batteries; Stochastic systems; Sustainable development; Building energy model; Electric vehicle; Hydrogen energy storages; Multi-objectives optimization; Positive energies; Positive energy district; Renewable energy community; Urban building energy modeling; Urban buildings; alternative energy; artificial intelligence; battery; building; electric vehicle; energy storage; hydrogen; optimization; residential location; urban area; Design of experiments},
	correspondence_address = {A. Jahanbin; Department of Architecture, Construction and Design, Polytechnic University of Bari, Bari, 70125, Italy; email: aminhossein.jahanbin@poliba.it},
