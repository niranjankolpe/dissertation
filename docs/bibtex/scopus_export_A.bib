	title = {Hourly Forecasting of Solar Photovoltaic Power in Pakistan Using Recurrent Neural Networks},
	year = {2022},
	journal = {International Journal of Photoenergy},
	volume = {2022},
	pages = {},
	doi = {10.1155/2022/7015818},
	url = {https://www.scopus.com/pages/publications/85123172046?origin=resultslist},
	affiliations = {Department of Electrical Engineering, Mehran University of Engineering and Technology, Jamshoro, 76062, Pakistan; Department of Mechanical Engineering, Mehran University of Engineering and Technology, Jamshoro, 76062, Pakistan; Department of Computer Science, Faculty of Science and Technology, American International University - Bangladesh, Dhaka, 1229, Bangladesh},
	abstract = {The solar photovoltaic (PV) power forecast is crucial for steady grid operation, scheduling, and grid electricity management. In this work, numerous time series forecast methodologies, including the statistical and artificial intelligence-based methods, are studied and compared fastidiously to forecast PV electricity. Moreover, the impact of different environmental conditions for all of the algorithms is investigated. Hourly solar PV power forecasting is done to confirm the effectiveness of various models. Data used in this paper is of one entire year and is acquired from a 100 MW solar power plant, namely, Quaid-e-Azam Solar Park, Bahawalpur, Pakistan. This paper suggests recurrent neural networks (RNNs) as the best-performing forecasting model for PV power output. Furthermore, the bidirectional long-short-term memory RNN framework delivered high accuracy results in all weather conditions, especially under cloudy weather conditions where root mean square error (RMSE) was found lowest 0.0025, R square stands at 0.99, and coefficient of variation of root mean square error (RMSE) Cv was observed 0.0095%.  © 2022 Sohrab Khan et al.},
	keywords = {Forecasting; Mean square error; Meteorology; Recurrent neural networks; Scheduling; Solar concentrators; Solar power generation; Solar power plants; Condition; Grid electricity; Grid operation; Operations scheduling; Pakistan; Photovoltaic electricities; Power forecast; Root mean square errors; Solar photovoltaic power; Time series forecasts; Solar energy},
	correspondence_address = {A. Nahar; Department of Computer Science, Faculty of Science and Technology, American International University - Bangladesh, Dhaka, 1229, Bangladesh; email: afroza@aiub.edu},
	publisher = {Hindawi Limited},
	issn = {1110662X},
	language = {English},
	abbrev_source_title = {Int. J. Photoenergy},
	type = {Article},
	publication_stage = {Final},
