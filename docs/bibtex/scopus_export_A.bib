@ARTICLE{Jo2021,
	author = {Jo, Seung Chan and Jin, Young Gyu and Yoon, Yong Tae and Kim, Ho Chan},
	title = {Methods for integrating extraterrestrial radiation into neural network models for day-ahead pv generation forecasting},
	year = {2021},
