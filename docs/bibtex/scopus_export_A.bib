	year = {2023},
	journal = {Renewable Energy},
	volume = {216},
	pages = {},
	doi = {10.1016/j.renene.2023.119034},
	url = {https://www.scopus.com/pages/publications/85174928172?origin=resultslist},
	affiliations = {Department of Land Surveying and Geo-Informatics, The Hong Kong Polytechnic University, Hong Kong; Institute of High Performance Computing (IHPC), Agency for Science, Technology and Research (A*STAR), 1 Fusionopolis Way, Singapore, 138632, Singapore; Research Institute for Land and Space, The Hong Kong Polytechnic University, Hong Kong; Department of Civil and Environmental Engineering, Yonsei University, South Korea; Hong Kong Observatory, Kowloon, Hong Kong},
	abstract = {Harvesting solar energy on rooftops can be a promising solution for providing affordable energy. This requires accurately estimating spatio-temporal solar photovoltaic (PV) potential on urban surfaces. However, it is still a challenge to obtain a fast and accurate estimation of rooftop solar PV potential over large urban built-up areas. Thus, this study proposes a parametric-based method to estimate annual rooftop solar irradiation at a fine spatial resolution. Specifically, seven parameters (Digital Surface Model, Sky View Factor, shadow from buildings, shadow from terrain, building volume to façade ratio, slope, and aspect) are determined that having great importance in modeling rooftop solar irradiation. Three machine learning methods (Random Forest (RF), Gradient Boost Regression Tree (GBRT), and AdaBoost) trained by the selected parameters are cross-compared based on R<sup>2</sup>, Mean Absolute Error (MAE), and computation time. As a case study in Hong Kong, China, the RF outperformed GBRT and AdaBoost, with R<sup>2</sup>=0.77 and MAE=22.83kWh/m<sup>2</sup>/year. The time for training and prediction of rooftop solar irradiation is within 13 h, achieving a 99.32% reduction in time compared to the physical-based hemispherical viewshed algorithm. These results suggest that the proposed method can provide an accurate and fast estimation of rooftop solar irradiation for large datasets. © 2023 Elsevier Ltd},
	author_keywords = {Geographic information system; Machine learning; Parametric study; Rooftop solar irradiation},
	keywords = {China; Hong Kong; Adaptive boosting; Aspect ratio; Forestry; Geographic information systems; Large dataset; Parameter estimation; Solar energy; Solar power generation; Solar radiation; Accurate estimation; Fast estimation; Hong-kong; Machine-learning; Parametric study; Photovoltaic potentials; Random forests; Rooftop solar irradiation; Solar irradiation; Solar photovoltaics; accuracy assessment; building; GIS; machine learning; parameter estimation; solar radiation; viewshed; Machine learning},
