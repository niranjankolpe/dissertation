@ARTICLE{Benayad2025,
	author = {Benayad, Mohamed and Rochd, Abdelilah and Elhamaoui, Said and Babour, Nouhaila and Benayad, Ferdaous and Houran, Nouriddine and Simou, Mohamed Rabii and Maanan, Mehdi and Rhinane, Hassan},
	title = {Optimizing electric vehicle charging infrastructure powered by photovoltaics: A geospatial and multi-criteria analysis for sustainable urban mobility},
