	author = {Salman, Diaa and Siyad, Abdulaziz Ahmed and Kusaf, Mehmet and Elmi, Yonis},
	title = {Day Ahead Unit Commitment with High Penetration of Renewable Energy Sources and Electric Vehicle Charging Stations},
	year = {2024},
	journal = {International Journal of Engineering Trends and Technology},
	volume = {72},
