	title = {Duck Curve Management Using Deep Learning and Optimization Algorithms for Renewable Energy Integration},
	year = {2025},
	journal = {SSRG International Journal of Electronics and Communication Engineering},
	volume = {12},
	number = {5},
	pages = {271 - 284},
	doi = {10.14445/23488549/IJECE-V12I5P123},
