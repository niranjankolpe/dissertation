	keywords = {Long short-term memory; Solar energy; Energy systems; Forecasting algorithm; Long short-term memory long short-term memory; Machine learning algorithm ML; Machine learning algorithms; Photovoltaic forecasting algorithm; Photovoltaics; SARIMA / ARIMA; Short term memory; Transition energy; Transition energy system; Solar power generation},
