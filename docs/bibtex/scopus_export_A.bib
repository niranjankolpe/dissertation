	keywords = {Desalination; Distillation; Energy efficiency; Forecasting; Particle swarm optimization (PSO); Solar concentrators; Solar heating; Solar power generation; Artificial neural network modeling; Electrical heater; Humpback whale optimizer; Humpback whales; Optimizers; Solar desalination; Solar stills; Tubular solar still; Tubulars; Water yield; Neural networks},
