	title = {SkyGPT: Probabilistic ultra-short-term solar forecasting using synthetic sky images from physics-constrained VideoGPT},
	year = {2024},
	journal = {Advances in Applied Energy},
	volume = {14},
	pages = {},
	doi = {10.1016/j.adapen.2024.100172},
