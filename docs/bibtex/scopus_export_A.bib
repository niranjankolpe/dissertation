	title = {Dual-level optimization model based on CNN-SWA prediction for smoothing wind-solar hydrogen production power fluctuation},
	year = {2025},
	journal = {Energy Reports},
	volume = {14},
	pages = {3437 - 3450},
	doi = {10.1016/j.egyr.2025.10.041},
	url = {https://www.scopus.com/pages/publications/105020922756?origin=resultslist},
	affiliations = {School of Energy and Power Engineering, Inner Mongolia University of Technology, Hohhot, 010051, China; Key Laboratory of New Energy and Energy Storage Technology, Inner Mongolia University of Technology, Hohhot, 010051, China},
	abstract = {Wind-solar power-to-hydrogen is an effective way to produce clean energy in the form of hydrogen. However, the volatility and intermittency of wind and solar energy significantly impact the efficiency of hydrogen production and the stability of the overall system. To improve hydrogen production efficiency, this paper proposes a dual-level optimization model based on a Convolutional Neural Network-Sliding Window Algorithm (CNN-SWA) for forecasting. First, the paper constructs and trains the CNN-SWA prediction model using historical data to improve prediction accuracy. This model is then used to forecast wind and solar power generation, with the predicted power being input into an upper-level optimization model. The Particle Swarm Optimization (PSO) algorithm optimizes the distribution ratio between wind-solar power and battery power, helping to reduce fluctuations in hydrogen production. In the lower-level optimization model, paper establish an Analytical Hierarchy Process (AHP)-based weight evaluation model. The Multi-Objective Particle Swarm Optimization (MOPSO) algorithm is then utilized to optimize the configuration of energy storage system capacity, resulting in an improved weight evaluation model. Case studies demonstrate that after applying the upper-level optimization, hydrogen production fluctuations decreased by up to 24.65 %. With the lower-level optimization, these fluctuations reduced further by 5.81 %, energy storage costs decreased by 14.08 %, and the curtailment rate dropped by 0.74 %. These results confirm the effectiveness of the proposed optimization model. © 2025 The Authors.},
	author_keywords = {AHP weight evaluation model; Dual-level optimization; Hybrid energy storage; Wind-solar power forecasting},
	keywords = {Analytic hierarchy process; Digital storage; Energy efficiency; Forecasting; Hierarchical systems; Hydrogen production; Hydrogen storage; Multiobjective optimization; Solar energy; Solar power generation; Solar wind; Wind power; Analytical Hierarchy Process; Analytical hierarchy process weight evaluation model; Convolutional neural network; Dual-level optimization; Evaluation models; Hybrid energy storage; Optimisations; Optimization models; Power forecasting; Wind-solar power forecasting; Particle swarm optimization (PSO)},
