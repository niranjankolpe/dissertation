	keywords = {Decision trees; Energy utilization; Federated learning; Forecasting; Forestry; Machine learning; Privacy-preserving techniques; Smart power grids; Boosted decision trees; Distributed machine learning; Energy grids; Gradient boosted decision tree; Machine-learning; Smart energies; Smart energy grid; Tree-based; Uncertainty; Uncertainty bounds; Learning systems},
