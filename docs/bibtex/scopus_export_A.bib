@ARTICLE{Abdulrahman20241078,
	author = {Abdulrahman, Aysar A},
	title = {Heat pipes and nanofluids utilization for cooling photovoltaic panels: an application of hybrid machine learning and optimization models},
	year = {2024},
	journal = {International Journal of Low-Carbon Technologies},
	volume = {19},
	pages = {1078 - 1088},
