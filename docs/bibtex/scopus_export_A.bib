}

@ARTICLE{Osone2025172245,
	author = {Osone, Yuki and Kodaira, Daisuke},
	title = {Imbalance-Aware Scheduling for PV-Battery Storage Systems Using Deep Reinforcement Learning},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
