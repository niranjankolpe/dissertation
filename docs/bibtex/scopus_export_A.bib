@ARTICLE{Maican2025,
	author = {Maican, Camelia Adela and Pană, Cristina Floriana and Pătrașcu-Pană, Daniela Maria and Rădulescu, Virginia Maria},
	title = {Review of Fault Detection and Diagnosis Methods in Power Plants: Algorithms, Architectures, and Trends},
