@ARTICLE{Bhavsar2022,
	author = {Bhavsar, S. and Pitchumani, R. and Ortega-Vazquez, M.A.},
	title = {A reforecasting-based dynamic reserve estimation for variable renewable generation and demand uncertainty},
	year = {2022},
	journal = {Electric Power Systems Research},
	volume = {211},
