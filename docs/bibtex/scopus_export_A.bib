}

@ARTICLE{Singh2025189,
	author = {Singh, Manpreet and Singh, Lakhwinder},
	title = {Enhancing Power Quality in Grid-Integrated Hybrid Renewable Energy System using ANFIS-FBSO},
	year = {2025},
	journal = {Power Electronics and Drives},
	volume = {10},
	number = {1},
	pages = {189 - 209},
