	author = {Bin Yousuf, Kayes and Akter, Ashrafi and Noor, Hadid Ahmed and Hoque, Ashraful and Ahmed, Ashik},
	title = {A hybrid XGBoost-LSTM model with physics-informed features and uncertainty quantification for solar power forecasting},
	year = {2026},
