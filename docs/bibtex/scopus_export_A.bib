	year = {2025},
	journal = {Applied Energy},
	volume = {378},
	pages = {},
	doi = {10.1016/j.apenergy.2024.124744},
	url = {https://www.scopus.com/pages/publications/85208249173?origin=resultslist},
	affiliations = {Shanghai Research Institute for Intelligent Autonomous Systems, Tongji University, Shanghai, 201210, China; School of Electronics and Information Engineering, Tongji University, Shanghai, 201804, China; Guohao School, Tongji University, Shanghai, 200092, China; School of Automotive Studies, Tongji University, Shanghai, 201804, China},
	abstract = {Accurate forecasting of photovoltaic (PV) power is crucial for real-time grid balancing and storage system optimization. However, due to the intermittent and fluctuating nature of PV power generation, achieving accurate PV power forecasting remains a challenge. In this paper, we propose a novel approach for multi-site intra-hour PV power forecasting. Different from current work which predicts the power of each PV station independently, we predict the power of each PV station simultaneously by considering the inherent spatio-temporal correlation with other PV stations and develop a novel graph network named DEST-GNN. In DEST-GNN, an undirected graph is used to represent the dependence of these PV stations. Each PV station is represented by a node and the spatio-temporal correlation of any two PV stations is represented by an edge between them. To improve the accuracy of prediction, sparse spatio-temporal attention is adopted to filter out the weak associations of these PV stations. We then develop an adaptive graph convolution network (GCN) that adopts an adaptive adjacency matrix and a temporal convolution network to capture the hidden spatio-temporal dependency of these PV stations. Experimental studies using datasets from Alabama and California, provided by the National Renewable Energy Laboratory (NREL), demonstrate the effectiveness of DEST-GNN. For the Alabama dataset, DEST-GNN achieves a mean absolute error (MAE) of 0.49 over a 12-mon training scale. Furthermore, DEST-GNN attains an MAE of 0.42 on the California dataset, continuing to exhibit its strong forecasting capabilities. © 2024 Elsevier Ltd},
	author_keywords = {Adaptive graph convolution; Photovoltaic power forecasting; Sparse attention; Spatio-temporal correlation},
	keywords = {Alabama; California; United States; Adaptive graph convolution; Alabama; Multi-site; Photovoltaic power; Photovoltaic power forecasting; Photovoltaics; Power forecasting; Sparse attention; Spatiotemporal correlation; artificial neural network; correlation; data set; energy storage; optimization; photovoltaic system; power generation; spatiotemporal analysis},
	correspondence_address = {S. Shu; Shanghai Research Institute for Intelligent Autonomous Systems, Tongji University, Shanghai, 201210, China; email: shushaolong@tongji.edu.cn},
