	author = {Stover, Oliver and Karve, Pranav and Mahadevan, Sankaran},
	title = {Periodic Regression in the Principal Component Space for Multivariate, Multi-Horizon, Probabilistic Forecasting},
	year = {2026},
	journal = {Journal of Forecasting},
	volume = {45},
