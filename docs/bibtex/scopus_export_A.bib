}

@CONFERENCE{Sogno2025,
	author = {Sogno, R. and Zupan, E. and Waibel, C.},
	title = {Data-Driven Hourly Heating Demand Prediction for Residential Buildings},
	year = {2025},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {1554},
	number = {1},
	pages = {},
	doi = {10.1088/1755-1315/1554/1/012049},
	url = {https://www.scopus.com/pages/publications/105027130913?origin=resultslist},
	affiliations = {ETH Zurich, Zurich, Switzerland; ETH Zurich, Zurich, Switzerland; Flemish Institute for Technological Research (VITO), Mol, Belgium},
	abstract = {Simulation tools have become common practice for achieving energy-efficient designs in Swiss building planning. However, due to budget and time restraints, these simulations are often done at a monthly resolution. Neglecting to consider hourly resolution in an early stage is a critical oversight, as it is crucial to optimise building design and understand the integration of various building systems, especially during an early design stage. This project develops an algorithm to upsample monthly heating demand data from simulations of residential buildings into an annual hourly series. The calculation efficiency of this approach additionally opens the potential for the estimation and optimisation of urban heating demand on low-performance computer hardware. Time-resolved demand information is relevant for addressing the contemporary grid challenges on intermittent renewable energy integration by advanced controls of storage, load shifting, PV self-consumption, and sector coupling. The proposed approach uses neural networks for data upsampling (from monthly to hourly resolution) using a building simulation database containing information for approximately 1000 buildings in Zurich. It includes data such as internal loads, outdoor air temperature, envelope U-values, window-to-wall ratio, etc. Using a selection of these parameters together with weather data to train the models, the paper explores possible network architectures suitable for implementation of the described upsampling task. Different architectures are benchmarked against each other, mainly following the logic of an auto-encoder based on dense or LSTM layers. The results demonstrate that the chosen inputs allow accurate upsampling into hourly demand values with sufficient accuracy (R<sup>2</sup> > 0.98) to support early stage planning. Future pathways for this algorithm include generalising the model to more locations and validating it with real-world data. It is expected that a similar architecture can also be applied to cope with other building use types, as well as the upsampling of time series such as electricity demand, cooling demand, or PV generation. © Published under licence by IOP Publishing Ltd.},
	correspondence_address = {R. Sogno; ETH Zurich, Zurich, Switzerland; email: rino.sogno@gmail.com},
	editor = {Habert G. and De Wolf C. and Schluter A. and Passer A. and Saade M.R.M. and Lutzkendorf T. and Howe L. and Belizario-Silva F. and Xiong S. and Bendiek-Laranjo A. and Costalonga V. and Kim D.H.},
	publisher = {Institute of Physics},
	issn = {17551307},
	language = {English},
	abbrev_source_title = {IOP Conf. Ser. Earth Environ. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Bouakkaz2025158,
	author = {Bouakkaz, Abderraouf and Lahsasna, Adel and Mena, Antonio J Gil and Haddad, Salim and Ferrari, Mario Luigi and Jiménez-Castaneda, Rafael},
	title = {Evaluating and analyzing the performance of PV power output forecasting using different models of machine-learning techniques considering prediction accuracy},
	year = {2025},
	journal = {International Journal of Renewable Energy Development},
	volume = {14},
	number = {1},
	pages = {158 - 167},
	doi = {10.61435/ijred.2025.60547},
	url = {https://www.scopus.com/pages/publications/85214503766?origin=resultslist},
	affiliations = {Laboratoire de génie mécanique et matériaux, Université 20 aout 1955 Skikda, Bp26 route d’el Hadaik, Skikda, Algeria; Département d'informatique, Université 20 aout 1955 Skikda, Bp26 route d’el Hadaik, Skikda, Algeria; Department of Electrical Engineering, University of Cádiz, Escuela Politécnica Superior de Algeciras, Avda. Ramón Puyol, s/n, Cádiz, Algeciras, 11202, Spain; Thermochemical Power Group (TPG), University of Genoa, Genoa, Italy; Department of Electrical Engineering, Escuela Superior de ingeniería de Puerto real, Avda. de la Universidad de Cádiz, 10, Cádiz, Puerto Real, 15519, Spain},
	abstract = {Solar energy as a clean, renewable, and sustainable energy source has considerable potential to meet global energy needs. However, the intermittent and uncertain character of the solar energy source makes the power balance management a very challenging task. To overcome these shortcomings, providing accurate information about future energy production enables better planning, scheduling, and ensures effective strategies to meet energy demands. The present paper aims to assess the performance of PV power output forecasting in PV systems using various machine learning models, such as artificial neural networks (ANN), linear regression (LR), random forests (RF), and Support Vector Machines (SVM). These learning algorithms are trained on two different datasets with different time steps: in the first one, a historical weather forecast with a one hour time step, and in the second one, a dataset of on-site measurements with a 5-minute time step. To provide a reliable estimation of prediction accuracy for different learning algorithms, a k-fold cross-validation (CV) is applied. Through a comparison analysis, an assessment of the accuracy of these algorithms based on various metrics such as RMSE, MAE, and MRE is performed, providing a detailed evaluation of their performance. Results obtained from this study demonstrate that the random forest algorithm (RF) outperformed other algorithms in predicting PV output, achieving the smallest prediction error, where the best values for RMSE, MRE, MAE, and R² for the weather dataset were 0.856 W, 0.256%, 0.364 W, and 0.99999, respectively, while thevalues for RMSE, MRE, MAE, and R² for the on-site measurements dataset were 8.525 W, 11.163%, 3.922 W, and 0.99922, respectively. © 2025.The Author(s). Published by CBIORE.},
	author_keywords = {Accuracy of predictions; Cross-validation; Energy forecasting; Machine learning; Power production; Solar energy},
