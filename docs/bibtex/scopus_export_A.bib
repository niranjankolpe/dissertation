	keywords = {Forecasting; Photovoltaics; Solar energy; Solar power generation; Tidal power; Time series; Covariates; Features selection; Negative outputs; Neural-networks; Photovoltaic power; Photovoltaic power forecasting; Physically guided neural network; Power forecasting; Time-series dense encoder; Times series; Signal encoding},
