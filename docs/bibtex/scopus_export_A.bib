	keywords = {Computer architecture; Maximum power point trackers; Network architecture; Solar panels; Solar power generation; Artificial neural network; Global maximum power point tracking; Network-based; Photovoltaic; Photovoltaics; Powerloss; Solar panels; Tracking speed; Tracking time; Neural networks},
