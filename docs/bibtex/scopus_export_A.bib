	title = {Multi-Scale Seasonal-Convolutional and Decomposition-Attention Network for Day-Ahead Photovoltaic Power Forecasting},
	year = {2025},
	journal = {Proceedings of the 2nd International Conference on Intelligent Computing and Data Analysis, ICDA 2025},
	pages = {289 - 295},
	doi = {10.1145/3772726.3772771},
	url = {https://www.scopus.com/pages/publications/105026163994?origin=resultslist},
	affiliations = {College of Systems Engineering, National University of Defense Technology, Hunan, Changsha, China; Laboratory for Big Data and Decision, National University of Defense Technology, Hunan, Changsha, China},
	abstract = {Accurate day-ahead photovoltaic (PV) power forecasting is essential for grid stability and energy management, but solar energy's inherent variability poses significant challenges. While Numerical Weather Prediction (NWP)-informed artificial neural network methods show promise performance, current approaches inadequately consider slowly evolving seasonal patterns and fail to model hierarchical relationships within time series components and their cross-variable interactions. This paper proposes a Multi-Scale Seasonal-Convolutional and Decomposition-Attention Network (MSCDA-Net) for NWP-informed day-ahead PV power forecasting. The method incorporates a multi-scale seasonal feature extraction module that treats seasonal patterns as explicit variables using CNNs with varying kernel sizes, and a decomposition-enhanced multi-view attention module that decouples dynamic variables into trend and periodic components via moving average decomposition and applies self-attention mechanisms to model complex variable relationships. Extensive experiments on benchmark datasets demonstrate that MSCDA-Net achieves superior forecasting accuracy compared to state-of-the-art approaches, validating the effectiveness of the unified framework in handling both fast-changing and slow-changing variables while maintaining computational efficiency.  © 2025 Copyright held by the owner/author(s).},
