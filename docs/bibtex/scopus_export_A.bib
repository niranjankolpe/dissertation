@ARTICLE{Torres2024,
	author = {Torres, Julia and Palacios, Ana María and Fuentes, Manuel and Vivar, Marta},
	title = {Study of the Bunsen–Roscoe Reciprocity Law in Solar Water Disinfection (Optical Effect) for E. coli, E. faecalis and C. perfringens},
	year = {2024},
	journal = {Water (Switzerland)},
	volume = {16},
