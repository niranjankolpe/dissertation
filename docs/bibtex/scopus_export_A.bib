@ARTICLE{Nespoli202232900,
	author = {Nespoli, Alfredo and Leva, Sonia and Mussetta, Marco and Ogliari, Emanuele Giovanni Carlo},
	title = {A Selective Ensemble Approach for Accuracy Improvement and Computational Load Reduction in ANN-Based PV Power Forecasting},
