@ARTICLE{Zeng20249832,
	author = {Zeng, Hao and Kou, Yitian and Sun, Xiang},
	title = {How Sophisticated Are Neural Networks Needed to Predict Long-Term Nonadiabatic Dynamics?},
	year = {2024},
	journal = {Journal of Chemical Theory and Computation},
	volume = {20},
