	keywords = {Digital storage; Economics; Energy management; Energy management systems; Energy resources; Energy storage; Housing; Investments; Learning systems; Machine learning; Meteorology; Random forests; Weather forecasting; Energy; Energy optimization; Energy productions; Meteorological data; Photovoltaic installation; Photovoltaics; Random forests; Residential photovoltaic; Three models; Xgboost; Linear regression},
