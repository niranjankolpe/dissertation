	title = {Renewable energy-based power generation in Antarctica: Roadmap for optimal sizing, placement and uncertainties prediction using AI-guided technological advances; [Відновлювана енергетика в Антарктиді: дорожня карта для розрахунків оптимального обсягу, розміщення та прогнозу невизначеності з використанням ШІ-технологій]},
	year = {2025},
