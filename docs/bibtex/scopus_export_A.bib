@ARTICLE{Pan2024,
	author = {Pan, Chen and Liu, Yuqiao and Oh, Yeonjae and Lim, Changgyoon},
	title = {Short-Term Photovoltaic Power Forecasting Using PV Data and Sky Images in an Auto Cross Modal Correlation Attention Multimodal Framework},
	year = {2024},
	journal = {Energies},
	volume = {17},
	number = {24},
	pages = {},
	doi = {10.3390/en17246378},
	url = {https://www.scopus.com/pages/publications/85213245975?origin=resultslist},
	affiliations = {Department of Computer Engineering, Chonnam National University, Yeosu, 59626, South Korea; Department of Cultural Contents, Chonnam National University, Yeosu, 59626, South Korea},
	abstract = {The accurate prediction of photovoltaic (PV) power generation is crucial for improving virtual power plant (VPP) efficiency and power system stability. However, short-term PV power forecasting remains highly challenging due to the significant impact of weather changes, especially the complexity of cloud motion. To this end, this paper proposes an end-to-end innovative deep learning framework for data fusion based on multimodal learning, which utilizes a new auto cross modal correlation attention (ACMCA) mechanism designed in this paper for feature extraction and fusion by combining historical PV power generation time-series data and sky image data, thereby enhancing the model’s prediction performance under complex weather conditions. In this paper, the effectiveness of the proposed model was verified through a large number of experiments, and the experimental results showed that the model’s forecast skill (FS) reached 24.2% under all weather conditions 15 min in advance, and 24.32% under cloudy conditions with the largest fluctuations. This paper also compared the model with a variety of existing unimodal and multimodal models, respectively. The experimental results showed that the model in this paper outperformed other benchmark methods in all indices under different weather conditions, demonstrating stronger adaptability and robustness. © 2024 by the authors.},
	author_keywords = {attention mechanism; multimodal learning; short-term photovoltaic power forecasting; sky image; virtual power plant},
	keywords = {Attention mechanisms; Condition; Cross-modal correlation; Multi-modal learning; Photovoltaic power; Photovoltaic power generation; Power forecasting; Short-term photovoltaic power forecasting; Sky image; Virtual power plants},
