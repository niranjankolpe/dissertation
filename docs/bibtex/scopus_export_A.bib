@ARTICLE{Eldeghady2024,
	author = {Eldeghady, Ghada Shaban and Kamal, Hanan Ahmed and Moustafa Hassan, Mohamed A.},
	title = {Comparative analysis of the performance of supervised learning algorithms for photovoltaic system fault diagnosis},
	year = {2024},
	journal = {Science and Technology for Energy Transition (STET)},
	volume = {79},
	pages = {},
	doi = {10.2516/stet/2024024},
	url = {https://www.scopus.com/pages/publications/85193444473?origin=resultslist},
	affiliations = {Faculty of Engineering Electronics and Communications Department, Misr University for Science and Technology, 6th of October City, Giza, Egypt; Faculty of Engineering Electronics and Communications Department, Cairo University, Giza, Egypt; Faculty of Engineering Electrical Power Department, Cairo University, Giza, Egypt},
	abstract = {New trends were introduced in using PhotoVoltaic (PV) energy which are mostly attributable to new laws internationally having a goal to decrease the usage of fossil fuels. The PV systems efficiency is impacted significantly by environmental factors and different faults occurrence. These faults if they were not rapidly identified and fixed may cause dangerous consequences. A lot of methods have been introduced in the literature to detect faults that may occur in a PV system such as using Current-Voltage (I-V) curve measurements, atmospheric models and statistical methods. In this paper, various machine learning techniques in particular supervised learning techniques are used for PV array failure diagnosis. The main target is the identification and categorization of several faults that may occur such as shadowing, degradation, open circuit and short circuit faults that have a great impact on PV systems performance. The results showed the technique’s high ability of fault diagnosis capability. The K-Nearest Neighbor (KNN) technique showed the best fault prediction performance. It achieves prediction accuracy of 99.2% and 99.7% Area Under Curve-Receiver Operating Curve (AUC-ROC) score. This shows its superiority in fault prediction in PV systems over other used methods Decision Tree, Naïve Bayes, and Logistic Regression. © 2024 Editions Technip. All rights reserved.},
	author_keywords = {Decision tree; Logistic regression; Machine learning; PV},
