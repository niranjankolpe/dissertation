@CONFERENCE{Lu202586,
	author = {Lu, Kuan and Huo, Menghao and Li, Yuxiao and Zhu, Qiang and Chen, Zhenrui},
	title = {CT-PatchTST: Channel-Time Patch Time-Series Transformer for Long-Term Renewable Energy Forecasting},
	year = {2025},
	journal = {2025 10th International Conference on Computer and Information Processing Technology, ISCIPT 2025},
	pages = {86 - 95},
	doi = {10.1109/ISCIPT67144.2025.11265471},
