@ARTICLE{Abdel-Nasser2021144906,
	author = {Abdel-Nasser, Mohamed and Mahmoud, Karar and Lehtonen, Matti},
	title = {Hifa: Promising heterogeneous solar irradiance forecasting approach based on kernel mapping},
	year = {2021},
	journal = {IEEE Access},
