	keywords = {Energy management; Knowledge acquisition; Learning systems; Machine learning; Photovoltaic effects; Photovoltaics; Domain shift; Extreme learning machine; Learning machines; Linear calibration; Non negatives; Non-negative ridge gating; OOD/ID; Photovoltaic forecasting; Photovoltaics; Residual stacking; Robust scaling; Scalings; Calibration},
