	year = {2026},
	journal = {Results in Engineering},
	volume = {32},
	pages = {},
	doi = {10.1016/j.rineng.2026.112443},
	url = {https://www.scopus.com/pages/publications/105047850305?origin=resultslist},
	affiliations = {Electric Systems & Renewable Energies Laboratory, National School of Engineering of Sfax, University of Sfax, Sfax, Tunisia; Networked Objects, Control and Communication Systems (NOCCS) Laboratory, National Engineering School of Sousse, University of Sousse, Sousse, Tunisia; Electronic and Information Technology Laboratory(LETI), National School of Engineering of Sfax, University of Sfax, Sfax, Tunisia; Higher Institute of Applied Sciences and Technology of Sousse, University of Sousse, Sousse, Tunisia},
	abstract = {Machine learning (ML) enables accurate analysis and prediction in many fields, namely in photovoltaic (PV) systems, where power generation is strongly affected by variable climatic conditions. The prediction of PV internal parameters, sensitive to climatic and/or faulty conditions, remains helpful to predict the PV behavior precisely. Moreover, Electrochemical Impedance spectroscopy (EIS) is considered a powerful technique to extract the most crucial PV internal parameters of a PV cell for given climatic conditions and operation zone by means of dynamic PV impedance spectra. This technique is adopted in this paper for an outdoor experimental setup for a wide range of irradiance of a 30W- 18V PV system using Analog discovery 2. The obtained spectra are then used as a database for training three ML prediction tools, namely Recurrent Neural Networks (RNN), Long Short-Term Memory (LSTM), and Gated Recurrent Unit (GRU), to generate refined spectra fitted to predict precisely the PV internal parameters for a given irradiance value. Both LSTM- and GRU-based models consistently provide accurate and physically consistent estimates of the PV internal parameters, outperforming the conventional Simple RNN method. However, LSTM model is retained, as its predictions show closer agreement with the experimental measurements, demonstrating superior reliability in parameter identification. This solution streamlines the computational process, enabling fast and reliable estimation of PV system internal parameters, even in the presence of incomplete or missing irradiance data. The proposed approach significantly enhances the efficiency of EIS analysis and provides valuable insights into the health state and long-term performance of PV panels. © 2026 The Authors.},
	author_keywords = {EIS; GRU; Internal PV parameters prediction; LSTM; Simple RNN},
	keywords = {Computational methods; Forecasting; Learning systems; Parameter estimation; Photovoltaics; Spectrum analysis; Electrochemical-impedance spectroscopies; Gated recurrent unit; Internal parameters; Internal photovoltaic parameter prediction; Machine-learning; Parameter prediction; Photovoltaic parameters; Photovoltaics; Short term memory; Simple recurrent neural networks; Electrochemical impedance spectroscopy; Long short-term memory},
	correspondence_address = {S. Sallem; Electric Systems & Renewable Energies Laboratory, National School of Engineering of Sfax, University of Sfax, Sfax, Tunisia; email: souhir.sallem@enis.tn},
