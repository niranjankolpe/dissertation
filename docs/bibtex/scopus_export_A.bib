	author = {Jiang, Jianjian and Hu, Shizhao and Xu, Liang and Wang, Tianlin},
	title = {Short-Term PV power prediction based on VMD-CNN-IPSO-LSSVM hybrid model},
	year = {2024},
	journal = {International Journal of Low-Carbon Technologies},
	volume = {19},
