	keywords = {Bayesian networks; Data handling; Deep learning; Forecasting; Learning systems; Neural networks; Optimization; Photovoltaics; Solar concentrators; Solar energy; Solar power generation; Bayesian optimization; Machine-learning; Photovoltaic power; Photovoltaic power forecasting; Power forecasting; PV system; Solar photovoltaic power; Spatio-temporal relations; Spatio-temporal relationships; Spatiotemporal relation fused network; Principal component analysis},
