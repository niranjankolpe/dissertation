@CONFERENCE{Brandherm2026,
	author = {Brandherm, Boris and Schmeyer, Thomas and Sonnenberg, Gerhard and Chikobava, Margarita and Luxenburger, Andreas and Ndiaye, Alassane and Knoch, Sönke and Findeisen, Jens and Manser, Steffen},
	title = {Digital Twins for Decentralized Infrared Heating Systems in the Industrial Metaverse},
	year = {2026},
	journal = {Procedia CIRP},
	volume = {140},
