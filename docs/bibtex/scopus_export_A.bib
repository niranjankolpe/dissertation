@ARTICLE{Hassan2026108625,
	author = {Hassan, Ibrahem M. and Ali, Essam and Abdelrahem, Mohamed and Abdelshafy, Alaaeldin M.},
	title = {Optimal Techno-Economic Assessment of Battery-Hydrogen Hybrid Energy Systems Using Genetic Algorithms and LSTM-Based Solar Forecasting},
	year = {2026},
