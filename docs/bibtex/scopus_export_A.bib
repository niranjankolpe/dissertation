	keywords = {Data fusion; Solar energy; Solar power generation; Weather forecasting; Meteorological datasets; Photovoltaic forecasting; Photovoltaic generation dataset; Photovoltaic system modeling; Photovoltaic systems; Photovoltaics; Photovoltaics generations; Static system parameter; Static systems; System models; Systems parameters; Quality control},
