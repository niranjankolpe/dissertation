	title = {Comparative analysis of Kolmogorov–Arnold and recurrent neural networks for day-ahead photovoltaic forecasting with Metaheuristic optimization for cost and battery management at Green Energy Park, Morocco},
	year = {2025},
	journal = {Results in Engineering},
	volume = {28},
	pages = {},
	doi = {10.1016/j.rineng.2025.108203},
	url = {https://www.scopus.com/pages/publications/105022810805?origin=resultslist},
	affiliations = {Mohamed V University, Mohammadia School of Engineering, Department of Electrical Engineering, Rabat, Morocco; Green Energy Park Research Platform (GEP, IRESEN/UM6P), Ben Guerir, Morocco; CY Cergy-Paris University, GEII, Satie Laboratory, Paris, France},
	abstract = {Microgrid technology plays a crucial role in addressing major challenges in modern power systems. These include energy intermittency, cost management, energy allocation, and battery operation. This study presents an integrated approach that combines advanced solar power forecasting with metaheuristic optimization to improve microgrid efficiency under Moroccan time-of-use tariffs. The framework is structured in two stages. In the first stage, a forecasting model based on the Kolmogorov–Arnold neural network is compared with recurrent neural networks. Results show that the Kolmogorov–Arnold model provides superior predictive accuracy, reaching a root mean square error of 0.0421. The forecasted PV output is integrated into the cost optimization stage for microgrid operation. Three scenarios evaluated to optimize operational costs using metaheuristic algorithms, specifically Particle Swarm Optimization, Genetic Algorithm, and Gray Wolf Optimizer. Furthermore, the simulation, based on a Time-of-Use pricing strategy applied in the Solar Decathlon Africa smart village case study in Benguerir, Morocco, enabled effective demand response, resulting in cost reductions of 53.37 % with GWO, 49.79 % with GA, and 46.20 % with PSO. These findings highlight the importance of combining accurate day ahead PV forecasting with efficient cost optimization to develop scalable, sustainable, and effective microgrid energy management system solutions. © 2025 The Author(s).},
	author_keywords = {Battery energy storage system; Day-ahead photovoltaic forecasting; Kolmogorov–arnold neural network; Metaheuristic Optimization; Microgrid Energy Management; Time-of-Use Pricing Strategy},
	keywords = {Cost benefit analysis; Cost reduction; Energy management; Forecasting; Genetic algorithms; Heuristic algorithms; Microgrids; Particle swarm optimization (PSO); Secondary batteries; Solar energy; Battery energy storage systems; Day-ahead; Day-ahead photovoltaic forecasting; Energy; Kolmogorov; Kolmogorov–arnold neural network; Metaheuristic optimization; Microgrid; Microgrid energy management; Neural-networks; Photovoltaics; Pricing strategy; Time-of-use pricing; Time-of-use pricing strategy; Mean square error},
	correspondence_address = {E.-Q. Mouna; Mohamed V University, Mohammadia School of Engineering, Department of Electrical Engineering, Rabat, Morocco; email: Mouna.elqasery@um5r.ac.ma},
	publisher = {Elsevier B.V.},
	issn = {25901230},
	language = {English},
	abbrev_source_title = {Result.  Eng.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access}
}

@ARTICLE{Faßbender2025,
	author = {Faßbender, Max and Rößler, Nicolas and Wellmann, Christoph and Eisenbarth, Markus and Andert, Jakob},
	title = {Model Predictive Control for Charging Management Considering Mobile Charging Robots},
	year = {2025},
	journal = {Energies},
	volume = {18},
	number = {15},
	pages = {},
	doi = {10.3390/en18153948},
	url = {https://www.scopus.com/pages/publications/105013120555?origin=resultslist},
	affiliations = {Teaching and Research Area Mechatronics in Mobile Propulsion, Faculty of Mechanical Engineering, RWTH Aachen University, Aachen, 52062, Germany},
	abstract = {Mobile Charging Robots (MCRs), essentially high-voltage batteries mounted on mobile platforms, offer a flexible solution for electric vehicle (EV) charging, particularly in environments like supermarket parking lots with photovoltaic (PV) generation. Unlike fixed charging stations, MCRs must be strategically dispatched and recharged to maximize operational efficiency and revenue. This study investigates a Model Predictive Control (MPC) approach using Mixed-Integer Linear Programming (MILP) to coordinate MCR charging and movement, accounting for the additional complexity that EVs can park at arbitrary locations. The performance impact of EV arrival and demand forecasts is evaluated, comparing perfect foresight with data-driven predictions using long short-term memory (LSTM) networks. A slack variable method is also introduced to ensure timely recharging of the MCRs. Results show that incorporating forecasts significantly improves performance compared to no prediction, with perfect forecasts outperforming LSTM-based ones due to better-timed recharging decisions. The study highlights that inaccurate forecasts—especially in the evening—can lead to suboptimal MCR utilization and reduced profitability. These findings demonstrate that combining MPC with predictive models enhances MCR-based EV charging strategies and underlines the importance of accurate forecasting for future smart charging systems. © 2025 by the authors.},
	author_keywords = {DC charging; electric vehicles; energy management; long short-term memory network; mobile charging robot; model predictive control; smart charging},
	keywords = {Charging stations; Charging time; Electric machine control; Electric vehicles; Energy management; Forecasting; Integer programming; Long short-term memory; Mixed-integer linear programming; Prediction models; Predictive control systems; Robots; Secondary batteries; DC charging; Electric vehicle charging; Energy; Long short-term memory network; Memory network; Mobile charging; Mobile charging robot; Model-predictive control; Short term memory; Smart charging; Model predictive control},
	correspondence_address = {M. Faßbender; Teaching and Research Area Mechatronics in Mobile Propulsion, Faculty of Mechanical Engineering, RWTH Aachen University, Aachen, 52062, Germany; email: max.fassbender@rwth-aachen.de; J. Andert; Teaching and Research Area Mechatronics in Mobile Propulsion, Faculty of Mechanical Engineering, RWTH Aachen University, Aachen, 52062, Germany; email: andert@mmp.rwth-aachen.de},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
