	affiliations = {Cornell University, School of Electrical and Computer Engineering, Ithaca, NY, United States; Santa Clara University, School of Engineering, Santa Clara, CA, United States; Northeastern University, Department of Electrical and Computer Engineering, Boston, MA, United States; University of Houston, Department of Mechanical and Aerospace Engineering, Houston, TX, United States; Columbia University in the City of New York, Fu Foundation School of Engineering and Applied Science, New York, NY, United States},
	abstract = {Accurate forecasting of renewable energy generation is fundamental to enhancing the dynamic performance of modern power grids, especially under high renewable penetration. This paper presents Channel-Time Patch Time-Series Transformer (CT-PatchTST), a novel deep learning model designed to provide long-term, high-fidelity forecasts of wind and solar power. Unlike conventional time-series models, CT-PatchTST captures both temporal dependencies and inter-channel correlations - features that are critical for effective energy storage planning, control, and dispatch. Reliable forecasting enables proactive deployment of energy storage systems (ESSs), helping to mitigate uncertainties in renewable output, reduce system response time, and optimize storage operation based on location-specific flow and voltage conditions. Evaluated on real-world datasets from Denmark's offshore wind, onshore wind, and solar generation, CT-PatchTST outperforms existing methods in both accuracy and robustness. By enabling predictive, data-driven coordination of ESSs across integrated source-grid-load-storage systems, this work contributes to the design of more stable, responsive, and cost-efficient power networks.  © 2025 IEEE.},
	author_keywords = {dispatch optimization; Energy forecasting; energy storage systems; grid dynamic enhancement; multivariate time series; smart grid control; transformer models},
	keywords = {Deep learning; Electric load dispatching; Electric power system control; Electric power transmission networks; Energy storage; Forecasting; Learning systems; Offshore oil well production; Smart power grids; Time series; Dispatch optimization; Energy; Energy forecasting; Energy storage system; Grid control; Grid dynamic enhancement; Multivariate time series; Optimisations; Smart grid; Smart grid control; Storage systems; Transformer modeling; Digital storage},
	correspondence_address = {K. Lu; Cornell University, School of Electrical and Computer Engineering, Ithaca, United States; email: kl649@cornell.edu},
