	correspondence_address = {M.A. Aljabri; Department of Electrical Engineering, King Abdulaziz University, Jeddah, 21589, Saudi Arabia; email: maljabri0087@stu.kau.edu.sa},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
