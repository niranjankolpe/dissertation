	keywords = {Brain; Digital storage; Energy efficiency; Long short-term memory; Network architecture; Personnel training; Rankine cycle; Solar energy; Solar power generation; Solar radiation; Statistics; Deeponet; LSTM; Operator networks; Operator regression; Performance prediction; Solar irradiances; Solar thermal systems; Solar-thermal system modeling; Thermal systems modelling; Variable loads; Forecasting},
