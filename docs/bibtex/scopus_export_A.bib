}

@ARTICLE{Bouillon2025,
	author = {Bouillon, Némo and Boitier, Vincent},
	title = {Pixel-Wise Sky-Obstacle Segmentation in Fisheye Imagery Using Deep Learning and Gradient Boosting},
	year = {2025},
