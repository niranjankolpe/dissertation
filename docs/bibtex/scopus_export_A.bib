@CONFERENCE{Saffari2021,
	author = {Saffari, Mohsen and Khodayar, Mahdi and Jalali, Seyed Mohammad Jafar and Shafie-Khah, Miadreza and Catalao, Joao P.S.},
	title = {Deep convolutional graph rough variational auto-encoder for short-term photovoltaic power forecasting},
	year = {2021},
	journal = {SEST 2021 - 4th International Conference on Smart Energy Systems and Technologies},
	pages = {},
	doi = {10.1109/SEST50973.2021.9543326},
