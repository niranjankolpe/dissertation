	keywords = {Carrier transport; Conductive materials; Cost effectiveness; Couplings; Defect density; Defect engineering; Dissociation; Dynamics; Excitons; Extraction; Ionic conduction; Learning systems; Machine learning; Metal-Organic Frameworks; Nanostructured materials; Passivation; Solar cells; Solar energy; Solar power generation; Substrates; Charge dynamic engineering; Charge dynamics; Defect passivation; Density functional theory; Density-functional-theory; Machine learning; Machine-learning; Metal-organic framework; Metal-organic framework-derived nanomaterial; Metalorganic frameworks (MOFs); Density functional theory; Light absorption},
	correspondence_address = {O. Adedokun; Department of Pure and Applied Physics, Ladoke Akintola University of Technology, Ogbomoso, Nigeria; email: oadedokun@lautech.edu.ng},
