	url = {https://www.scopus.com/pages/publications/105021263072?origin=resultslist},
	affiliations = {Department of Automation and Systems Engineering, Federal University of Santa Catarina (UFSC), SC, Florianópolis, Brazil; Lisbon School of Engineering (ISEL), Polytechnic University of Lisbon (IPL), Lisbon, Portugal; Faculty of Engineering and Applied Sciences, University of Regina (UofR), Regina, SK, Canada; Department of Electrical Engineering, Federal University of Parana (UFPR), PR, Curitiba, Brazil; Graduate Program in Electrical Engineering, Federal University of Parana (UFPR), PR, Curitiba, Brazil; Graduate Program in Mechanical Engineering, Federal University of Parana (UFPR), PR, Curitiba, Brazil},
	abstract = {Accurate short and medium-term forecasting is important for mitigating uncertainty and enabling efficient energy grid management. While traditional machine learning and deep learning models offer improved accuracy, they often lack interpretability. To address these limitations, this study proposes a hybrid forecasting framework, called FNO-BiLSTM-NAM, that combines a Fourier Neural Operator (FNO) to extract spectral–temporal features, a Bidirectional Long Short-Term Memory (BiLSTM) network to model sequential dependencies, and a Neural Additive Model (NAM) to quantify feature-wise contributions. The model incorporates multi-scenario forecasting to support energy operators under different uncertainty levels. Experiments conducted on a dataset from a 5 MW PhotoVoltaic (PV) plant demonstrate the superiority of the model. For a 6-hour forecast horizon, the proposed FNO-BiLSTM-NAM model achieved a mean absolute error of 0.0712 and mean squared error of 0.0092, outperforming benchmark models across short- to medium-term horizons. Furthermore, the spectral analysis of the FNO revealed low-pass filtering behavior, highlighting the ability of the model to suppress high-frequency noise. Comparative experiments with five machine and deep learning baseline models confirm the robustness and generalization capacity of the framework. These results underscore the potential of the proposed model for enhancing PV energy forecasting accuracy while maintaining transparency across dynamic operating conditions. © 2025 The Authors},
	author_keywords = {Machine learning; Meteorological data; Multi-step forecasting; Neural additive model; Photovoltaic energy forecasting; Solar energy},
	keywords = {Additives; Deep learning; Learning systems; Mean square error; Meteorology; Neural networks; Solar power generation; Spectrum analysis; Uncertainty analysis; Weather forecasting; Additive models; Energy; Energy forecasting; Fourier; Machine-learning; Meteorological data; Multi-step forecasting; Neural additive model; Photovoltaic energy; Photovoltaic energy forecasting; accuracy assessment; alternative energy; forecasting method; machine learning; meteorology; photovoltaic system; solar power; spectral analysis; Solar energy},
