@ARTICLE{Al-Majidi2023,
	author = {Al-Majidi, Sadeq D. and Altai, Hisham Dawood Salman and Lazim, Mohammed H. and Al-Nussairi, Mohammed Kh. and Abbod, Maysam F. and Al-Raweshidy, Hamed S.},
	title = {Bacterial Foraging Algorithm for a Neural Network Learning Improvement in an Automatic Generation Controller},
	year = {2023},
	journal = {Energies},
	volume = {16},
	number = {6},
	pages = {},
	doi = {10.3390/en16062802},
	url = {https://www.scopus.com/pages/publications/85151449470?origin=resultslist},
	affiliations = {Department of Electrical Engineering, College of Engineering, University of Misan, Amarah, 62001, Iraq; Department of Electronic and Electrical Engineering, College of Engineering, Brunel University London, London, UB8 3PH, United Kingdom},
	abstract = {The frequency diversion in hybrid power systems is a major challenge due to the unpredictable power generation of renewable energies. An automatic generation controller (AGC) system is utilised in a hybrid power system to correct the frequency when the power generation of renewable energies and consumers’ load demand are changing rapidly. While a neural network (NN) model based on a back-propagation (BP) training algorithm is commonly used to design AGCs, it requires a complicated training methodology and a longer processing time. In this paper, a bacterial foraging algorithm (BF) was employed to enhance the learning of the NN model for AGCs based on adequately identifying the initial weights of the model. Hence, the training error of the NN model was addressed quickly when it was compared with the traditional NN model, resulting in an accurate signal prediction. To assess the proposed AGC, a power system with a photovoltaic (PV) generation test model was designed using MATLAB/Simulink. The outcomes of this research demonstrate that the AGC of the BF-NN-based model was effective in correcting the frequency of the hybrid power system and minimising its overshoot under various conditions. The BP-NN was compared to a PID, showing that the former achieved the lowest standard transit time of 5.20 s under the mismatching power conditions of load disturbance and PV power generation fluctuation. © 2023 by the authors.},
	author_keywords = {automatic generation controller; bacterial foraging algorithm; hybrid power system; neural network model; photovoltaic power generation},
	keywords = {Backpropagation; Controllers; Electric power system control; Learning systems; Solar energy; Automatic generation controllers; Bacterial foraging algorithm; Controller systems; Hybrid power; Hybrid power system; Neural network learning; Neural network model; Photovoltaic power generation; Renewable energies; Neural network models},
