	affiliations = {Xi'An University of Science and Technology, College of Electrical and Control Engineering, Xi'an, 710054, China; Xi'An Jiaotong University, Department of Electrical Engineering, Xi'an, 710049, China; Henan Xuji Jibao Electrical Automation Company Ltd., Xuchang, 461000, China; Xi'An University of Technology, Department of Electrical Engineering, Xi'an, 710048, China; Machines and Control Research Institute, University of Nottingham, Power Electronics, Nottingham, NG7 2RD, United Kingdom; Universidad Andrés Bello, Centro de Transformación Energética, Facultad de Ingeniería, Santiago, 8330012, Chile},
