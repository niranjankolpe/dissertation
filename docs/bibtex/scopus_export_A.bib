	keywords = {Deep learning; Defects; Electric power transmission networks; Environmental technology; Learning systems; Reliability analysis; Solar concentrators; Solar energy; Solar panels; Solar power generation; Characterization; Data driven; Data-driven analytic; Machine-learning; Module performance; Performance degradation; Performance reliability; Photovoltaic modules; Photovoltaics; Solar photovoltaic modules; Degradation},
	correspondence_address = {O.A. Alimi; Fort Hare Institute of Technology, University of Fort Hare, Alice, 5700, South Africa; email: oalimi@ufh.ac.za},
