@CONFERENCE{Navarro20231609,
	author = {Navarro, Pedro and Serrano, Juan Miguel and Roca, Lidia and Palenzuela, Patricia and Lucas, Manuel and Ruiz, Javier},
	title = {Comparison between an artificial neural network and Poppe's model for wet cooling tower performance prediction in CSP plants},
