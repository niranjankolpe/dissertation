@ARTICLE{Zhang2026,
	author = {Zhang, Yuhan and Sun, Qiaochu and Zhao, Jiang},
	title = {Accelerating the Design of Double-Absorber Solar Cells: From Surrogate Model-Assisted Reinforcement Learning and Multi-Algorithm Optimization Comparison to Transfer Learning},
	year = {2026},
	journal = {Materials},
