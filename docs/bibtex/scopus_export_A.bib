@ARTICLE{Yu2026,
	author = {Yu, Yue and Loskot, Pavel and Gao, Yu},
	title = {PhysEmbedFormer: a physics-guided interpretable architecture for days-ahead forecasting of PV power},
	year = {2026},
	journal = {Scientific Reports},
	volume = {16},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-025-34874-8},
