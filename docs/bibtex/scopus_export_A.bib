	url = {https://www.scopus.com/pages/publications/105044934835?origin=resultslist},
	affiliations = {School of Computer Science, School of Software, Nanjing University of Information Science and Technology, Nanjing, 210044, China; Jiangsu Province Engineering Research Center of Advanced Computing and Intelligent Services, Nanjing University of Information Science and Technology, Nanjing, 210044, China; Jiangsu Collaborative Innovation Center of Atmospheric Environment and Equipment Technology (CICAEET), Nanjing University of Information Science and Technology, Nanjing, 210044, China; Shanghai Meteorological Information and Technology Support Center, Shanghai, China},
	abstract = {Short-term solar radiation forecasting is a key issue in photovoltaic power generation assessment and renewable energy system scheduling. Existing methods mainly employ deep learning to fuse multi-source meteorological observation data, but face two core challenges: the spatiotemporal heterogeneity of multi-source data makes fusion difficult, and the lack of physical constraints makes it difficult for models to guarantee the physical rationality of predictions. To address these challenges, this paper proposes a Physically Enhanced Multimodal Fusion Network (PEF-Net). First, a multi-scale temporal convolution and covariance-guided mechanism are used to capture short-term abrupt changes in rapid cloud evolution and long-term trends in solar elevation angle changes. Second, cross-attention and adaptive modal weighting are designed to force each modality to query only other modalities to achieve deep cross-source information interaction, and the fusion ratio is dynamically adjusted through learnable weights to address data gaps. Finally, a data-driven physical parameter extraction module is introduced to learn key parameters of the radiative transfer equation (atmospheric transmittance, cloud albedo, and aerosol factor) from observational data, and fusion is performed at the feature layer rather than the loss function layer to avoid scale mismatch issues. Experiments show that, compared with the existing best method (FusionSF), PEF-Net reduces the mean absolute error by 27.4% (18.79→13.65 W/m<sup>2</sup>) and improves R<sup>2</sup> from 0.950 to 0.989, balancing high accuracy and physical interpretability. © 2026 Elsevier Ltd.},
