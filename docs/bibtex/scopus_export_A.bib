	keywords = {Learning systems; Meteorology; Probabilistic logics; Solar energy conversion; Solar power generation; Uncertainty analysis; Weather forecasting; Copula theory; Correlation; Data correlations; Dynamic forecasting; Generation forecast; Predictive models; Probabilistic solar generation forecast; Probabilistics; Solar generation; Wind forecasting; Solar energy},
	correspondence_address = {S. Eftekharnejad; Syracuse University, Department of Electrical Engineering and Computer Science, Syracuse, 13244, United States; email: seftekha@syr.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
