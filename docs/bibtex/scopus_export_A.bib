@ARTICLE{Mughees20254441,
	author = {Mughees, Neelam and Mughees, Abdullah and Mughees, Anam and Ejsmont, Krzysztof},
	title = {Optimizing electrical and thermal energy storage systems for hour-ahead integrated demand response in industries},
	year = {2025},
	journal = {Energy Reports},
	volume = {13},
	pages = {4441 - 4458},
	doi = {10.1016/j.egyr.2025.04.008},
	url = {https://www.scopus.com/pages/publications/105002317640?origin=resultslist},
	affiliations = {School of Engineering and Technology, National Textile University, Faisalabad, 37610, Pakistan; School of Electrical Engineering and Computer Science (SEECS), National University of Sciences and Technology (NUST), Islamabad, 44000, Pakistan; Department of Electrical Engineering, Government College University, Faisalabad, 38000, Pakistan; Faculty of Mechanical and Industrial Engineering, Warsaw University of Technology, Warsaw, 02-524, Poland},
	abstract = {Industrial multi-energy microgrids (MEMGs) are increasingly challenged to meet electrical and thermal energy demands at minimal cost without disrupting operational processes. The current literature lacks strategies for optimizing electrical and thermal energy storage systems for integrated demand response (IDR), which can reduce industrial energy costs without disrupting operations. Moreover, including new technologies such as concentrated photovoltaic thermal (CPVT) panels and energy conversion devices is seldom explored in industrial MEMGs. This study addresses these gaps by developing an artificial intelligence (AI)-based optimization framework and applying it to enhance industrial MEMG performance. The AI contribution includes the formulation of a non-convex hour-ahead optimization problem and the use of a hybrid algorithm combining state-action-reward-state-action (SARSA) reinforcement learning with variants of differential evolution to solve the optimization problem. Additionally, a bidirectional long-short-term-memory networks-based deep stacked sequence-to-sequence autoencoder is employed for accurate hour-ahead forecasting of electrical and thermal energy from CPVT panels and hybrid structure of wind energy conversion systems-superconducting magnetic energy storage systems. The deployment of these AI methods optimize operation of MEMG configuration, specifically aimed at reducing energy bills and energy storage deterioration costs. The model is implemented in MATLAB, where it evaluates the profitability of time-of-use (TOU) and real-time pricing (RTP) tariffs for industrial users adopting hour-ahead IDR strategies. The results demonstrate the potential of hour-ahead IDR strategies in saving up to 92.4 % on energy bills and generating up to 48.2 % in revenue. © 2025 The Authors},
	author_keywords = {Electrical energy forecasting; Energy storage optimization; Integrated demand response; Reinforcement learning; Thermal energy forecasting},
	keywords = {Solar power generation; Demand response; Electrical energy; Electrical energy forecasting; Energy; Energy forecasting; Energy storage optimization; Integrated demand response; Reinforcement learnings; Storage optimization; Thermal; Thermal energy forecasting; Costs},
	correspondence_address = {K. Ejsmont; Faculty of Mechanical and Industrial Engineering, Warsaw University of Technology, Warsaw, 02-524, Poland; email: krzysztof.ejsmont@pw.edu.pl},
	publisher = {Elsevier Ltd},
	issn = {23524847},
	language = {English},
	abbrev_source_title = {Energy Rep.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6; All Open Access; Gold Open Access}
}

