@ARTICLE{Ruiz Amantegui2026,
	author = {Ruiz Amantegui, Jorge and Vu, Hai-Canh and Do, Phuc and Pavlov, Marko},
	title = {An AI-Based Framework Combining Categorical Alarm and Continuous Data for Power Estimation and Anomaly Detection in Photovoltaic Systems},
	year = {2026},
