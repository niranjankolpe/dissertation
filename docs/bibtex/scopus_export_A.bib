@ARTICLE{Yang2026,
	author = {Yang, Ting and Chen, Butian and Cheng, Qi and Miao, Bo and Lu, Danhong and Wu, Han},
	title = {Improving Photovoltaic Power Forecasting Accuracy by Integrating Aerosol Optical Features: A Dual-Channel Deep Learning Approach},
