	author = {Kalinga, Tharushi and Banfield, Brendan and Knott, Jonathan C. and Robinson, Duane A.},
	title = {Comparison of Linear Regression and Neural Networks for Model-Free Voltage Estimation of Low Voltage Distribution Networks with High Penetration of Residential Rooftop Solar},
