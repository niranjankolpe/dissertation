	author = {Xiang, Shenpeng and Lin, Mohan and Chen, Zhe and Zeng, Pingliang and Wang, Xiangjin and Gong, Diyang},
	title = {Real-time dispatch strategy for microgrid considering source‒load uncertainty: a tailored TD3 reinforcement learning approach},
