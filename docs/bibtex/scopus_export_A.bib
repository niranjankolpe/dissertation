@ARTICLE{Behgouy2026,
	author = {Behgouy, Parastou and ugurenver, Abbas},
	title = {Robust power management in smart microgrids using an optimized LSTM-based predictive controller},
	year = {2026},
	journal = {International Journal of Electrical Power and Energy Systems},
	volume = {179},
	pages = {},
	doi = {10.1016/j.ijepes.2026.112034},
	url = {https://www.scopus.com/pages/publications/105043481159?origin=resultslist},
	affiliations = {Istanbul Aydın University, Electrical and Electronic Engineering Department, Istanbul, Turkey},
	abstract = {A robust power management strategy is fundamental for maintaining the stability and effectiveness of microgrid systems, however, balancing energy sources and load demand within the system is complex due to the uncertain power generation from renewable energy sources and the dynamic load. Therefore, a reliable centralized controller can help simplify this challenge by ensuring optimal power flow and minimizing instability in the system. This study used MATLABto develop a hybrid microgrid system integrating photovoltaic (PV) systems, battery energy storage systems (BESS), and electric vehicles (EV) as DC energy sources. A voltage source converter (VSC) links these sources to the AC loads and the main grid. The aim is to manage power flow in the system using a BO-LSTM (Bayesian Optimized Long Short-Term Memory) neural network as a centralized controller. The controller outputs include the grid switch status, power delivered to the VSC, and the reference current for the EV system. The training is performed via samples obtained from an optimal power flow (OPF) algorithm. Unlike conventional control strategies, neural network-based approaches particularly recurrent neural networks (RNNs) like LSTM offer superior capability in modeling nonlinear and dynamic systems. The coefficient of determination (R2) utilized as an assessment parameter to determine the accuracy of the proposed neural network. The R2 values for Outputs 1, 2, and 3 are 0.9803, 0.9474, and 0.9637, respectively. The results near to 1 illustrate the model’s ability to make accurate predictions and manage power effectively. The proposed model verification is performed under three scenarios: standard conditions, atypical solar irradiation, and a state where both the BESS and EV start with zero charge. Grid switch, VSC power, and EV reference current are illustrated in each scenario. Additionally, the MG system components’ power outputs are presented separately. Subsequently, the grid system voltag