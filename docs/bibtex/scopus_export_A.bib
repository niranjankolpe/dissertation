@ARTICLE{Kim2025,
	author = {Kim, Jinyong and Kim, Eunkyeong and Jung, Seunghwan and Kim, Minseok and Kim, Baekcheon and Kim, Sungshin},
	title = {Improved Surface Solar Irradiation Estimation Using Satellite Data and Feature Engineering},
	year = {2025},
	journal = {Remote Sensing},
	volume = {17},
	number = {1},
	pages = {},
	doi = {10.3390/rs17010065},
	url = {https://www.scopus.com/pages/publications/85214446636?origin=resultslist},
	affiliations = {Department of Electrical and Electronics Engineering, Pusan National University, Busan, 46241, South Korea},
	abstract = {Planning an optimal installation site to maximize power-generation efficiency is crucial for the effective operation of photovoltaic power plants. Achieving this requires accurate, reliable information on solar irradiation across different regions. However, ground-based measurements using pyranometers are resource-intensive, requiring substantial time and human effort, and their measurement range is limited, complicating data collection. To address this, we propose a method to accurately estimate surface solar irradiation (SSI) using satellite data and feature engineering. By leveraging satellite data as the primary input, we overcome the spatial and temporal limitations of ground-based measurements. Additionally, we improve SSI-estimation performance through designed features based on the geometric information of the Sun and satellite. A hybrid deep neural network model is used for SSI estimation, effectively handling data of varying dimensions. Hourly SSI data from 12 synoptic observation stations collected over one year, excluded from the model’s training and validation sets, are utilized to evaluate the proposed method. Experimental results demonstrate strong SSI-estimation performance, with an average root mean square error (RMSE) of 0.1813 MJ/m<sup>2</sup>, a relative RMSE of 0.1601, mean absolute error of 0.1159 MJ/m<sup>2</sup>, and coefficient of determination of 0.9680. © 2024 by the authors.},
	author_keywords = {feature engineering; hybrid deep neural network; satellite data; solar geometry; surface solar irradiation estimation},
	keywords = {Deep neural networks; Solar power plants; Solar power satellites; Data engineering; Estimation performance; Feature engineerings; Ground based measurement; Hybrid deep neural network; Neural-networks; Satellite data; Solar geometry; Solar irradiation; Surface solar irradiation estimation; Solar irradiance},
