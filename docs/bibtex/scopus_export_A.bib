	title = {Quantifying community carbon offsets - a method based on building and environment point cloud data segmentation},
	year = {2026},
	journal = {Energy and Buildings},
	volume = {369},
	pages = {},
	doi = {10.1016/j.enbuild.2026.117924},
	url = {https://www.scopus.com/pages/publications/105044251170?origin=resultslist},
	affiliations = {School of Civil Engineering and Architecture, Anhui University of Science and Technology, Anhui, Huainan, 232001, China; School of Architecture and and Urban Planning, Shandong Jianzhu University, Shandong, Jinan, 250101, China},
	abstract = {As one of the major sources of urban carbon emissions, communities play a crucial role in achieving carbon peaking goals. High-density residential communities are currently experiencing a continuous increase in energy consumption and carbon emissions. How to balance or reduce community-level carbon emissions through environmental carbon offset has become a key task in realizing the city's 2030 carbon peaking target. Due to spatial and environmental constraints, carbon offset in high-density communities primarily derives from rooftop PV and green carbon sinks. By accurately identifying the available rooftop areas for PV installation and quantifying community green space, it is possible to rapidly assess the potential environmental carbon offset capacity. In this study, UAV-derived point cloud data were processed through filtering, projection, and annotation to construct a comprehensive point cloud dataset, from which roof and vegetation point clouds were separately extracted and refined. In the rooftop data processing workflow, U-Net is employed for feature extraction, and an attention mechanism is incorporated to enhance the accuracy of roof point cloud segmentation. Effective installation areas are then extracted via point cloud back-projection and geometric reconstruction. For vegetation data, point cloud elevation stratification and grid-based analysis are applied to extract the effective coverage areas of shrubs and trees within the community. Finally, based on the obtained area data, the carbon compensation was calculated by combining the electricity carbon emission factor and the vegetation carbon sequestration factor. The results show that the annual emission reduction potential of the installable photovoltaic system in the sample community is approximately 128.31 tCO₂, while the annual carbon sequestration of vegetation is 86.79 tCO₂, resulting in a total annual carbon compensation of 215.10 tCO₂ for the community. Using the proposed method, the estimation error of community carbon offset is controlled within 5%, with accuracy significantly improved compared with remote sensing–based estimation, and computational efficiency more than three times higher than manual measurements. © 2026 Elsevier B.V.},
	author_keywords = {Carbon offset; Community; Machine learning; Point cloud segmentation},
	keywords = {Carbon; Carbon capture; Carbon capture and utilization; Carbon cycle; Carbon Economy; Carbon emissions; Carbon sequestration; Computational efficiency; Data handling; Energy utilization; Geometry; Green computing; Remote sensing; Roofs; Vegetation; Zero-carbon; Carbon emissions; Carbon offsets; Carbon sequestration; Community; Community IS; Data segmentation; Machine-learning; Point cloud data; Point cloud segmentation; Point-clouds; Learning systems},
	correspondence_address = {H. Zheng; School of Architecture and and Urban Planning, Shandong Jianzhu University, Jinan, Shandong, 250101, China; email: 24417@sdjzu.edu.cn},
	publisher = {Elsevier Ltd},
