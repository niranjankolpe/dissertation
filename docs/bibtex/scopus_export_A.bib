@ARTICLE{Sarango2026,
	author = {Sarango, Klever and Maldonado-Correa, Jorge and Torres-Cabrera, Joel and Samaniego-Ojeda, Carlos},
	title = {VMD-LSTM-transformer: A hybrid approach for robust solar irradiance forecasting in complex terrains with application to photovoltaic systems},
	year = {2026},
	journal = {Next Energy},
	volume = {13},
