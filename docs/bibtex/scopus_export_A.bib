@ARTICLE{Liu2026,
	author = {Liu, Yu-Kuei and Rafajlovski, Goran and Islam, Saiful},
	title = {GRU-Based Short-Term Forecasting for Microgrid Operation: Modeling and Simulation Using Simulink},
	year = {2026},
