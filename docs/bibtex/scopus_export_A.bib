	year = {2022},
	journal = {Energies},
	volume = {15},
	number = {7},
	pages = {},
	doi = {10.3390/en15072457},
	url = {https://www.scopus.com/pages/publications/85127770349?origin=resultslist},
	affiliations = {Latin American Institute of Technology, Infrastructure and Territory (ILATIT), Federal University of Latin American Integration (UNILA), PR, Foz do Iguaçu, 85867-000, Brazil; Research Group on Energy & Energy Sustainability (GPEnSE), PE, Cabo de Santo Agostinho, 54518-430, Brazil; Academic Unit of Cabo de Santo Agostinho (UACSA), Federal Rural University of Pernambuco (UFRPE), PE, Cabo de Santo Agostinho, 54518-430, Brazil},
	abstract = {The use of renewable energies, such as Photovoltaic (PV) solar power, is necessary to meet the growing energy consumption. PV solar power generation has intrinsic characteristics related to the climatic variables that cause intermittence during the generation process, promoting instabilities and insecurity in the electrical system. One of the solutions for this problem uses methods for the Prediction of Solar Photovoltaic Power Generation (PSPPG). In this context, the aim of this study is to develop and compare the prediction accuracy of solar irradiance between Artificial Neural Network (ANN) and Long-Term Short Memory (LSTM) network models, from a comprehensive analysis that simultaneously considers two distinct sets of exogenous meteorological input variables and three short-term prediction horizons (1, 15 and 60 min), in a controlled experimental environment. The results indicate that there is a significant difference (p < 0.001) in the prediction accuracy between the ANN and LSTM models, with better overall prediction accuracy skill for the LSTM models (MAPE = 19.5%), except for the 60 min prediction horizon. Furthermore, the accuracy difference between the ANN and LSTM models decreased as the prediction horizon increased, and no significant influence was observed on the accuracy of the prediction with both sets of evaluated meteorological input variables. © 2022 by the authors. Licensee MDPI, Basel, Switzerland.},
	author_keywords = {artificial neural networks; deep learning; long-term short memory; machine learning; solar irradiance forecasting},
	keywords = {Deep neural networks; Energy utilization; Forecasting; Solar cells; Solar energy; Solar power generation; Solar radiation; Accuracy comparisons; Deep learning; Input variables; Memory modeling; Meteorological input; Photovoltaic power; Prediction accuracy; Prediction horizon; Solar irradiance forecasting; Solar irradiances; Long short-term memory},
