@ARTICLE{Gholami2025,
	author = {Gholami, Khalil and Arif, Mohammad Taufiqul and Haque, Md Enamul},
	title = {Machine learning-driven stochastic bidding for hydrogen Refueling Station-integrated virtual power plants in energy market},
