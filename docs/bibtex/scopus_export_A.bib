@ARTICLE{Santana2021,
	author = {Santana, Everton Jose and Silva, Ricardo Petri and Zarpelão, Bruno Bogaz and Junior, Sylvio Barbon},
	title = {Detecting and mitigating adversarial examples in regression tasks: A photovoltaic power generation forecasting case study},
	year = {2021},
	journal = {Information (Switzerland)},
	volume = {12},
