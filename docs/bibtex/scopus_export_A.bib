@CONFERENCE{Benkirane2025,
	author = {Benkirane, Yassine and Ouhmida, Asmae and Raihani, Abdelhadi and Benhala, Bachir},
	title = {Photovoltaic power forecasting techniques: Application in Artificial Neural Networks},
	year = {2025},
