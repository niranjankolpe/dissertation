@ARTICLE{Sun2025,
	author = {Sun, Yongtao and Yu, Qihui and Wang, Xinhao and Gao, Shengyu and Sun, Guoxin},
	title = {Extraction of Basic Features and Typical Operating Conditions of Wind Power Generation for Sustainable Energy Systems},
	year = {2025},
