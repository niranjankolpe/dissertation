@ARTICLE{Amnuaypongsa2025,
	author = {Amnuaypongsa, Worachit and Wangdee, Wijarn and Songsiri, Jitkomut},
	title = {Neural network-based prediction interval estimation with large width penalization for renewable energy forecasting and system applications},
	year = {2025},
	journal = {Energy Conversion and Management: X},
	volume = {27},
	pages = {},
	doi = {10.1016/j.ecmx.2025.101119},
	url = {https://www.scopus.com/pages/publications/105010513924?origin=resultslist},
	affiliations = {Department of Electrical Engineering, Faculty of Engineering, Chulalongkorn University, Bangkok, Pathumwan, 10330, Thailand; Center of Excellence in Electrical Power Technology, Chulalongkorn University, Bangkok, Pathumwan, 10330, Thailand},
	abstract = {Increasing the penetration of renewable energy introduces significant uncertainty into power systems. Probabilistic forecasting, which quantifies this uncertainty through prediction intervals (PIs), is essential for guiding a generation operating reserve preparation. The amount of standby generation resources is directly reflected by a PI width and typically focuses on the worst-case scenario arising with large PI widths under extreme conditions. This paper aims to reduce the large PI widths by proposing a new PI-based loss function that utilizes the sum of the K-largest element functions to impose greater penalties on larger PI widths in developing a renewable energy forecasting model. The proposed methodology can identify and reduce large PI widths during the model training process while ensuring PI's reliability. The loss function is compatible with gradient-based algorithms, allowing for further integration with state-of-the-art neural networks and recent deep learning techniques. Experiments on synthetic and solar irradiance forecasting datasets utilizing ANN and LSTM models showcase our approach's effectiveness in attaining narrower PIs while maintaining prediction accuracy. A cost analysis of solar power reserve demonstrates that our method yields reduced reserve over-allocation and lower total costs for provision and deficit penalties under high uncertainty. This is due to an improved PI's lower bound, which better captures actual generation, thereby decreasing lost load penalties. Furthermore, in robust energy management, the net electricity cost range assessed using PI information exhibits the narrowest variation compared to benchmarked methods due to the conservatism reduction in PI widths of net load forecasts. © 2025 The Authors},
	author_keywords = {Neural networks; Prediction intervals (PIs); Probabilistic forecasting; Robust energy management system; Solar irradiance forecasting; Uncertainty quantification},
	keywords = {Benchmarking; Cost reduction; Deep learning; Electric load forecasting; Energy management; Learning algorithms; Learning systems; Solar energy; Solar irradiance; Technological forecasting; Management systems; Neural-networks; Prediction interval; Probabilistic forecasting; Robust energy; Robust energy management system; Solar irradiance forecasting; Solar irradiances; Uncertainty quantifications; Cost benefit analysis},
