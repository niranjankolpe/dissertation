@ARTICLE{Toprak2026,
	author = {Toprak, Ayşegül},
	title = {Predicting photovoltaic output parameters of perovskite solar cells using explainable machine learning with physics-informed and simulation-derived descriptors},
	year = {2026},
	journal = {Materials Today Communications},
