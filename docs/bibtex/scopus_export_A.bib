@ARTICLE{Ustundag2026140557,
	author = {Ustundag, Mehmet},
	title = {Multi-Scale Residual Network With Modified Coordinate Attention for Accurate Short-Term PV Power Forecasting},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {140557 - 140580},
