@ARTICLE{Abdullah2024,
	author = {Abdullah, Burhan U Din and Khanday, Shahbaz Ahmad and Islam, Nair Ul and Lata, Suman and Fatima, Hoor and Nengroo, Sarvar Hussain},
	title = {Comparative Analysis Using Multiple Regression Models for Forecasting Photovoltaic Power Generation},
	year = {2024},
	journal = {Energies},
	volume = {17},
	number = {7},
	pages = {},
	doi = {10.3390/en17071564},
	url = {https://www.scopus.com/pages/publications/85190234719?origin=resultslist},
