@ARTICLE{Nemati2025,
	author = {Nemati, Mohammad Hossein and Shaabani, Mohammad Hossein and Dehghan, Navid and Gharehpetian, Gevork B.},
	title = {High frequency resonance mitigation of microgrid-connected PV units using novel adaptive control based on virtual impedance and machine learning algorithm},
	year = {2025},
	journal = {Results in Engineering},
	volume = {27},
	pages = {},
	doi = {10.1016/j.rineng.2025.106501},
	url = {https://www.scopus.com/pages/publications/105012104515?origin=resultslist},
	affiliations = {Electrical Engineering Department, Amirkabir University of Technology, Tehran, Iran},
	abstract = {The increasing integration of photovoltaic (PV) systems in microgrids introduces significant stability challenges, particularly in the form of high-frequency resonance (HFR) resulting from interactions between the PV system output impedance and the microgrid equivalent impedance. This study proposes a novel adaptive control framework that combines virtual impedance (VI) methods with a machine learning-based tuning strategy using K-Nearest Neighbors (KNN) algorithm. The developed model dynamically adjusts VI parameters, ensuring wideband harmonic mitigation even under varying microgrid conditions and topology, in order to prevent high frequency resonances. A detailed impedance analysis and state-space modeling of the PV unit and microgrid are carried out, followed by implementation of the control method in MATLAB/Simulink. Simulation results confirm its effectiveness: total harmonic distortion (THD) is reduced from 20.13 %, 21.53 %, and 16.39 % to 0.41 %, 0.13 %, and 0.32 %, respectively, across microgrid configurations with compensation capacitors of 17 μF, 12 μF, and 10 μF. Furthermore, the proposed KNN-based approach achieves a high predictive accuracy with an R² score of 0.976 and RMSE of 0.01833 across all VI parameters. The simulation results across various scenarios demonstrate that the proposed adaptive approach significantly outperforms traditional fixed-parameter methods in suppressing resonance and maintaining system stability. This methodology offers a scalable and good solution for enhancing the dynamic performance of PV-integrated microgrids. © 2025 The Author(s)},
	author_keywords = {High-frequency resonance; Machine learning; Microgrid; PV system; Virtual impedance},
	keywords = {Adaptive control systems; Control system stability; Electric impedance; Learning systems; Machine learning; MATLAB; Microgrids; Motion compensation; Nearest neighbor search; State space methods; Topology; Adaptive Control; High-frequency resonance; Impedance parameters; Machine learning algorithms; Machine-learning; Microgrid; Photovoltaic systems; Photovoltaics; System output; Virtual impedance; Learning algorithms},
