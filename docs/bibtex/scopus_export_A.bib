	keywords = {Classification (of information); Cost benefit analysis; Cost estimating; Energy harvesting; Gallium arsenide; III-V semiconductors; Internet of things; Light; Light absorption; Supervised learning; Energy; Indoor light; Indoor light analyse; Light source classification; Low-cost sensors; Low-costs; Machine-learning; On-machines; PV energy; Source classification; Light sources},
