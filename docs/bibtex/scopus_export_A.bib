	affiliations = {Zhejiang Zheneng Energy Service Co., Ltd., Hangzhou, Zhejiang, 310000, China},
	abstract = {As PV power generation is inherently intermittent, accurate PV power forecasting is critical to grid stability and energy management. The study introduces an optimized ML system that predicts solar power output for three separate locations throughout the United States. SVR and RF models are developed and systematically enhanced using the Aquila Optimizer (AO) to achieve optimal hyperparameter configurations. The research introduces a new method that combines AO with kernel-based and ensemble learning models through a systematic approach that includes testing at various locations. It also includes a detailed evaluation of system performance and parameter impact. Comparative results demonstrate that SVR consistently outperforms RF in both standalone and hybrid forms, while AO-based optimization significantly improves predictive accuracy, yielding coefficient of determination (R<sup>2</sup>) values up to 0.999 in optimized configurations. The research team used RMSE, MAE, R<sup>2</sup>, KLD, and VAF statistical metrics to assess model performance while they applied PAWN sensitivity analysis for better model result comprehension. The study produces successful outcomes, yet it depends on location-based past data together with predetermined weather parameters, which could limit its applicability to various environmental settings. The research will continue to develop the existing framework by expanding its application to different climate zones while adding more physical measurements, satellite data, and testing new deep learning models to boost their ability to handle larger datasets and maintain stability in PV power prediction systems. © 2026 The Authors.},
	author_keywords = {Aquila Optimizer; ML; Photovoltaic; RF; Support Vector Regression},
	keywords = {Deep learning; Forecasting; Learning systems; Location; Optimization; Photovoltaics; Solar energy; Statistical tests; Sustainable development; Aquila optimizer; Learning models; ML; Optimization techniques; Optimizers; Performance forecasting; Photovoltaic performance; Photovoltaics; RF; Support vector regressions; Sensitivity analysis},
	correspondence_address = {C. Zhang; Zhejiang Zheneng Energy Service Co., Ltd., Zhejiang, Hangzhou, 310000, China; email: 13336088378@163.com},
	publisher = {KeAi Communications Co.},
