	volume = {14},
	pages = {108625 - 108648},
	doi = {10.1109/ACCESS.2026.3713367},
	url = {https://www.scopus.com/pages/publications/105045009065?origin=resultslist},
	affiliations = {Assiut University, Faculty of Engineering, Department of Electrical Engineering, Asyut, 71515, Egypt; New Assiut Technological University, Faculty of Industry and Energy, New Asyut, 71311, Egypt; Technical University of Munich (TUM), Chair of High-Power Converter Systems (HLU), Munich, 80333, Germany},
	abstract = {This study presents a techno-economic assessment of battery and hydrogen storage systems powered by a photovoltaic (PV) array and diesel generator as a backup system to supply a scaled electrical load of maximum demand 160 kW. Evaluation of the superiority of battery and hydrogen storage technologies in terms of various technical, economic, and performance indicators is presented. The study is based on the optimal design of system components using a Multi-Objective Genetic Algorithm (MOGA) to simultaneously minimize the levelized cost of electricity (COE) and CO2 emissions over a 25-year project lifetime. To improve the reliability of the planning process, a Long Short-Term Memory (LSTM) model is developed using 14 years of historical solar irradiance data to generate an hourly forecast for an entire year (8760 hours), which serves as the primary input for the subsequent optimization and assessment stages. Four configurations are evaluated: PV/Battery, PV/Battery/Diesel, PV/Hydrogen, and PV/Hydrogen/Diesel. A novel Hydrogen Readiness Index (RI) is introduced to integrate economic, environmental, and technical indicators into a unified assessment metric for comparing battery and hydrogen-based systems. Results indicate that the forecasting model achieves a correlation coefficient of 93.53%, an RMSE of 122.37W/m2 , and a daily averaged MAPE of 3.228%, ensuring reliable input data for system optimization. The PV/Battery/Diesel configuration achieves the lowest COE (0.1548/kWh), while the fully renewable PV/Battery system yields the lowest CO2 emissions (0.0618 kg/kWh). Hydrogen-based systems show higher COE values (up to 0.1915/kWh) due to electrolyzer and storage costs; however, hydrogen integration reduces diesel operating hours by 48.43% and start events by 37%, enhancing long-term operational sustainability. A break-even analysis reveals that hydrogen systems become economically competitive when a 22-30% reduction is achieved in the cost of hydrogen storage system components.  © 2026 The Authors.},
	author_keywords = {hybrid renewable energy systems; Hydrogen energy storage; lithium-ion battery degradation; LSTM neural network; readiness index; solar irradiance forecasting},
	keywords = {Battery storage; Cost benefit analysis; Digital storage; Economic analysis; Forecasting; Genetic algorithms; Hydrogen storage; Lithium-ion batteries; Optimal systems; Renewable energy; Solar irradiance; Solar power generation; Battery degradation; Energy systems; Hybrid renewable energies; Hybrid renewable energy system; Hydrogen energy storages; Ion batteries; Lithium ions; Lithium-ion battery degradation; Long short-term memory neural network; Neural-networks; Readiness index; Short term memory; Solar irradiance forecasting; Solar irradiances; Long short-term memory},
	correspondence_address = {M. Abdelrahem; Assiut University, Faculty of Engineering, Department of Electrical Engineering, Asyut, 71515, Egypt; email: mohamed.abdelrahem@tum.de},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21693536},
	language = {English},
	abbrev_source_title = {IEEE Access},
