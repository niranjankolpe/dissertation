@ARTICLE{Kamal2023,
	author = {Kamal, Mustafa and Pecho, Renzon Daniel Cosme and Fakhruldeen, Hassan Falah and Sharif, Hailer and Mrzljak, Vedran and Nowdeh, Saber Arabi and Poljak, Igor},
	title = {Photovoltaic/Hydrokinetic/Hydrogen Energy System Sizing Considering Uncertainty: A Stochastic Approach Using Two-Point Estimate Method and Improved Gradient-Based Optimizer},
	year = {2023},
