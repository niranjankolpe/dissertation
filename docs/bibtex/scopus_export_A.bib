	affiliations = {Technische Universität München, Munich, Germany; Imperial College London, Dyson School of Design Engineering, London, London, United Kingdom},
	abstract = {Forecasting wind and solar output is vital for managing electricity markets and systems. Machine learning can help, but relevant data is often spread across different organizations. This has sparked interest in linking electricity and data markets. In this context, renewable producers face a co-opetition dilemma: Selling data may harm their competitive position in electricity markets. While prior work has explored data-sharing externalities, electricity market settings remain underexplored. This paper explores this issue using non-cooperative game theory. A baseline model with two wind farms shows how data sharing impacts competition. We prove the existence and uniqueness of a Nash equilibrium and analyze outcomes using the WIND Toolkit data showing that data sharing often dominates. This is the first research contribution investigating cooperative data sharing in a competitive electricity market setting. It offers first insights into optimal strategies for renewable producers participating in these markets. © 2025 Copyright held by the owner/author(s).},
