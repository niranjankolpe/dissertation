@CONFERENCE{Gschwind2025107,
	author = {Gschwind, Julia and Keshav, Srinivasan},
	title = {SolExplore: A Successive Refinement Approach for Sizing of PV and Storage Systems in EV-Enabled Homes},
	year = {2025},
	journal = {BuildSys 2025 - Proceedings of the 2025 the 12th ACM International Conference on Systems for Energy-Efficient Buildings, Cities, and Transportation},
	pages = {107 - 116},
	doi = {10.1145/3736425.3770101},
	url = {https://www.scopus.com/pages/publications/105022979367?origin=resultslist},
	affiliations = {ETH, Zurich, Switzerland; University of Cambridge, Cambridge, United Kingdom},
	abstract = {The growing accessibility of solar photovoltaic (PV) systems offers a promising pathway for homeowners to decarbonize their buildings. However, determining the appropriate size of a PV system and battery storage remains a complex task, influenced by household energy demand, daily activity patterns, and local solar potential. This decision becomes more complex with the increasing adoption of electric vehicles (EVs), as commute patterns and charging strategies, including bidirectional charging, significantly influence electricity demand profiles. Existing approaches to sizing PV and battery systems rely on detailed simulations that, while accurate, are computationally intensive and often take several minutes to hours to complete. This latency reduces interactivity and limits users' ability to explore various scenarios. In this work, we introduce SolExplore, an interactive application that delivers instant, high-accuracy sizing recommendations based on simple user-provided inputs. SolExplore leverages a simple dual-branch MLP as a surrogate model to generate a wide range of sizing predictions for different scenarios that users can explore in real time. Our model enables large-scale scenario evaluations in milliseconds, representing a speedup of 600,000 times over traditional methods that require several hours of computation. By drastically reducing computation time, our approach enables users to efficiently evaluate multiple configurations and identify system designs that best meet their needs and preferences. To ensure reliability, the selected configuration is subsequently verified using detailed simulations. This combined approach of fast and approximate prediction followed by careful verification empowers users to make well-informed decisions and supports broader adoption of residential solar and battery technologies.  © 2025 Copyright held by the owner/author(s).},
	author_keywords = {electric vehicles; energy storage; neural networks; sizing; solar power},
	keywords = {Charging (batteries); Complex networks; Data storage equipment; Electric energy storage; Electric vehicles; Human computer interaction; Human engineering; Secondary batteries; Solar energy; Solar power generation; Systems analysis; Battery storage; Energy; Neural-networks; Photovoltaic systems; Power; Simple++; Sizing; Solar photovoltaic system; Storage systems; Successive refinement; Neural networks},
	publisher = {Association for Computing Machinery, Inc},
	isbn = {979-840071945-5},
	language = {English},
	abbrev_source_title = {BuildSys - Proc. ACM Int. Conf. Syst. for Energy-Effic. Build., Cities, Transp.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

