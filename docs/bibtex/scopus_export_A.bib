	keywords = {Cleaning; Deposition; Dust; Environmental technology; Life cycle; Photovoltaic effects; Photovoltaics; Cleaning frequencies; Cleaning frequency optimization; Cleaning strategies; Cleaning technology; Coupled effect; Dust deposition; Dust formation; Dynamic decision models; Frequency optimization; Photovoltaic modules; artificial intelligence; dust; empirical analysis; literature review; optimization; photovoltaic system; Real time systems},
