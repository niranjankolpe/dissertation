	title = {Research on Ultra-Short-Term Photovoltaic Power Forecasting Based on Parallel Architecture TCN-BiLSTM with Temporal-Spatial Attention Mechanism},
	year = {2026},
	journal = {Energy Engineering: Journal of the Association of Energy Engineering},
	volume = {123},
