@ARTICLE{Dhruva202656010,
	author = {Dhruva, Jainam J. and Silvestri, Simone},
	title = {Surrogate-Assisted Adaptive Evolutionary Algorithm for Efficient HVAC Control in Home Energy Management Systems},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {56010 - 56025},
