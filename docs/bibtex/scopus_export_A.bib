@ARTICLE{M.2026,
	author = {M., Shanker and Kulkarni, Vikram},
	title = {Residual-enhanced hybrid deep learning framework for day-ahead PV power forecasting with cross-site generalization},
	year = {2026},
	journal = {Next Energy},
	volume = {11},
	pages = {},
	doi = {10.1016/j.nxener.2026.100601},
