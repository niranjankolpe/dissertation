@ARTICLE{Ahmed2026576,
	author = {Ahmed, Ayat and Sultan, Khalid F.},
	title = {Experimental and Theoretical Study Based on Artificial Neural Networks of Photovoltaic Thermal Collector Using Air Cooling Through a Hybrid Solar Chimney},
	year = {2026},
	journal = {International Journal of Heat and Technology},
