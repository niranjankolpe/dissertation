	title = {Storage management optimization based on electrical consumption and production forecast in a photovoltaic system},
	year = {2024},
	journal = {Mathematics and Computers in Simulation},
	volume = {224},
	pages = {128 - 147},
	doi = {10.1016/j.matcom.2023.10.007},
