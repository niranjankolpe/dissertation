@ARTICLE{Olasupo2026375,
	author = {Olasupo, Oyebola and Ayodele, Temitope Raphael and Ogunjuyigbe, Ayodeji Samson Olatunji},
	title = {AN EVALUATION OF DIRECT AND INDIRECT STRATEGIES FOR HIERARCHICAL NET-LOAD FORECASTING},
