	title = {LSTM and transformer networks for solar irradiance forecasting in arid and semi-arid climates},
	year = {2026},
	journal = {Next Energy},
	volume = {13},
	pages = {},
	doi = {10.1016/j.nxener.2026.101040},
	url = {https://www.scopus.com/pages/publications/105051604936?origin=resultslist},
	affiliations = {Department of Renewable Energy, Rajasthan Technical University, Kota, 324010, India; Department of Mechanical Engineering, Rajasthan Technical University, Kota, 324010, India; Department of Electrical Engineering, College of Engineering, Majmaah University, Al-Majmaah, 11952, Saudi Arabia; Department of Mechanical Engineering, Al-Falah University, Haryana, Faridabad, 121004, India},
	abstract = {In arid and semi-arid climates, global horizontal irradiance forecasting has been quit challenging. It is especially difficult due to heavy dust-aerosol loading, episodic dust storms, and steep diurnal irradiance ramps. However, the absence of a control comparison between recurrent and attention-based deep learning architectures under these conditions has been a notable weakness of the study. This study presents a comparative evaluation of Long Short-Term Memory and Transformer-based self-attention architectures for six-hour-ahead GHI forecasting. These results are benchmarked against Multilayer Perceptron baselines, Persistence, and Support Vector Regression. This study constructed a synthetic dataset of 26,280 hourly observations over three years. The site represents an arid climate in Rajasthan, India, at 27°N. It incorporates dust-aerosol attenuation, eighteen episodic dust-storm events and also includes intermittent cloud cover on 8% of days, along with temperature-dependent efficiency losses. On the held-out test set, SVR achieved the best overall accuracy (RMSE = 99.70 W/m², R² = 0.8733), while the Transformer achieved the lowest mean absolute error (86.95 W/m²) and competitive accuracy (RMSE = 129.33 W/m², R² = 0.7868). Summer dust-storm conditions increased RMSE by 35–45% relative to winter across all models. Multi-head attention-weight visualization revealed three physically interpretable patterns short-term recency, diurnal periodicity, and dust-storm pre-event sensitivity offering new empirical and climate-specific insight to guide AI-based solar-forecasting technology development for arid and semi-arid regions. © 2026 The Author(s)},
	author_keywords = {Arid climate; Deep learning; Multi-head self-attention; Photovoltaic systems; Seasonal analysis; Solar irradiance forecasting; Transformer},
	correspondence_address = {I. Alsaduni; Department of Electrical Engineering, College of Engineering, Majmaah University, Al-Majmaah, 11952, Saudi Arabia; email: i.alsaduni@mu.edu.sa},
	publisher = {Elsevier B.V.},
