	keywords = {Forecasting; Forestry; Memory architecture; Nearest neighbor search; Random forests; Solar energy; Solar radiation; Wind power; Wind speed; Dynamic ensemble; Ensemble methods; Forecasting ensemble; Forecasting models; Machine-learning; Performance; Renewable energies; Solar irradiances; Solar/wind; Wind speed; accuracy assessment; alternative energy; ensemble forecasting; irradiance; machine learning; real time; solar power; solar radiation; weather forecasting; wind power; wind velocity; Machine learning},
