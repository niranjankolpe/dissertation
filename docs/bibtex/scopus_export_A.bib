@ARTICLE{Erniyazov20254962,
	author = {Erniyazov, Sarvarbek and Lim, Chang Gyoon},
	title = {GNN-enhanced temporal patch segmentation and frequency fusion model for robust solar energy production forecasting},
	year = {2025},
	journal = {Energy Reports},
	volume = {13},
	pages = {4962 - 4984},
	doi = {10.1016/j.egyr.2025.03.063},
	url = {https://www.scopus.com/pages/publications/105003274537?origin=resultslist},
	affiliations = {Department of Computer Engineering, Chonnam National University, Jeonnam, Yeosu, 59626, South Korea},
	abstract = {Solar energy is a renewable resource with the potential to become the primary global energy source, effectively addressing rising energy demands while reducing reliance on fossil fuels. Accurate forecasting of solar energy production is essential for efficient energy management and for maximizing the utilization of renewable resources. However, traditional time series forecasting models face challenges in capturing both local temporal patterns and global dependencies within solar energy data. Furthermore, these models often overlook the spatial relationships between neighboring solar stations, limiting their ability to learn from interactions across nearby geographic locations. To address these challenges, we propose a novel hybrid model that integrates Graph Neural Networks (GNNs) with the Temporal Patch Segmentation and Frequency Fusion (TPS-FF) approach for robust energy forecasting. The GNN model is designed to learn spatial relationships between different solar stations, enabling the model to leverage interactions accross geographically dispersed locations. Whereas, the TPS-FF mechanism segmentes time-series data into patches to better capture local temporal patterns, while frequency disentangling methods decompose the signal into multiple frequency components, thereby capturing both rapid fluctuations and supporting multi-step ahead forecasting (i.e., 12–72 h). Experimental results demonstrate that the GNN-enhanced TPS-FF model significantly outperforms state-of-the-art forecasting architectures, achieving superior accuracy across various forecasting scenarios and substantially reducing both MAE and MSE metrics. Specifically, the model reduces MSE by 46 %, 34 %, 32.5 %, 30 %, and 21 % across prediction horizons of 12, 24, 36, 48, and 72 h, respectively, while MAE reductions over the same periods are 38 %, 25 %, 27 %, 23 %, and 20 %. © 2025},
	author_keywords = {Energy forecasting; Frequency fusion (FF); Graph Neural Network (GNN); Solar energy production; Temporal patch segmentation (TPS); Time-series},
	keywords = {Energy forecasting; Energy productions; Frequency fusion; Fusion model; Graph neural network; Graph neural networks; Patch segmentation; Solar energy production; Temporal patch segmentation; Times series; Graph neural networks},
	correspondence_address = {C.G. Lim; Department of Computer Engineering, Chonnam National University, Yeosu, Jeonnam, 59626, South Korea; email: cglim@jnu.ac.kr},
