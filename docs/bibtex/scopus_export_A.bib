@ARTICLE{Pandu2022109,
	author = {Pandu, Sathish Babu and Sagai Francis Britto, A. and Sekhar, Pudi and Vijayarajan, P. and Albraikan, Amani Abdulrahman and Al-Wesabi, Fahd N. and Al Duhayyim, Mesfer},
	title = {Artificial intelligence based solar radiation predictivemodel using weather forecasts},
	year = {2022},
	journal = {Computers, Materials and Continua},
	volume = {71},
