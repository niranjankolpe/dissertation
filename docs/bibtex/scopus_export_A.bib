	title = {Prediction based Multiobjective Solution of Economic Emission and Load Dispatch for Solar Integrated Power Systems},
	year = {2024},
	journal = {Journal of Scientific and Industrial Research},
	volume = {83},
	number = {12},
	pages = {1295 - 1305},
	doi = {10.56042/jsir.v83i12.7679},
	url = {https://www.scopus.com/pages/publications/85211620842?origin=resultslist},
	affiliations = {Department of Electrical Engineering, Parala Maharaja Engineering College, Odisha, Berhampur, 761 003, India; Department of Electrical and Electronics Engineering, Birla Institute of Technology, Mesra, Jharkhand, Ranchi, 835 215, India},
	abstract = {In present day power systems, the conventional thermal generating stations are being interconnected with solar photovoltaic sources to reduce the running cost along with environmental emission. For proper load dispatch, short term forecasting of electric load is essential to avoid overloads, surges and instability because of varying demand. In this work, Improved Multi-Objective Teaching Learning-Based Optimization (IMOTLBO) algorithm has been developed for effective Economic Emission and Load Dispatch (EELD). Here, the predicted load of a real time load center on a test Solar Integrated System (SIS) has been utilized to obtain Pareto solution, considering cost and emission as two objectives. The performance of the proposed IMOTLBO algorithm is compared with four other MOEAs, namely, Non-dominated Sorting Genetic Algorithm-II (NSGA-II), Multi-Objective Particle Swarm Optimization (MOPSO), Modified Multiobjective Cat Swarm Optimization (MMOCSO) and Multi-Objective Differential Evolution with Recursive Distributed Constraint Handling (MODE-RDC). For efficient prediction of the expected electrical load demand, an efficient single layer low complexity neural network i.e. Functional Link Artificial Neural Network (FLANN) model is considered. The weights of FLANN model are optimized by utilizing four different algorithms; one derivative based i.e. Least Mean Squares (LMS), and three others heuristic algorithms, namely Particle Swarm Optimization (PSO), Jaya and TLBO. To compare the performance of the proposed TLBO based FLANN models with the other three models, the Root Mean Square Error (RMSE) has been considered as the performance index. The dominance of the proposed FLANN-TLBO models over others is investigated by conducting non-parametric statistical testing. © 2024 National Institute of Science Communication and Policy Research. All rights reserved.},
	author_keywords = {Constraint handling; Multiobjective optimization; Root mean square error; Short term load forecasting; Teaching learning based optimization},
	keywords = {algorithm; complexity; detection method; real time; solar power; testing method},
	correspondence_address = {S.K. Mishra; Department of Electrical and Electronics Engineering, Birla Institute of Technology, Ranchi, Mesra, Jharkhand, 835 215, India; email: sudhansumishra@bitmesra.ac.in},
	publisher = {National Institute of Science Communication and Policy Research},
	issn = {00224456},
	language = {English},
	abbrev_source_title = {J. Sci. Ind. Res.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

