@ARTICLE{Tanev2026,
	author = {Tanev, Tanyo and Stanev, Rad},
	title = {A Machine Learning Modelling Approach for Improved Solar Irradiance Prediction for Day-Ahead Photovoltaic Power Production Forecasting},
	year = {2026},
