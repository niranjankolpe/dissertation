@ARTICLE{Yin2026,
	author = {Yin, Xinxian and Xu, Shengjing and Cui, Peng and Shao, Xingling and Liu, Xuan and Zhang, Siyuan},
	title = {Morphology-Oriented Layout Optimization for Enhancing Building-Cluster Photovoltaic Potential in Severe Cold Regions},
