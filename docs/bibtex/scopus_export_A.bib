@ARTICLE{Riedel2024,
	author = {Riedel, Pascal and Belkilani, Kaouther and Reichert, Manfred and Heilscher, Gerd and von Schwerin, Reinhold},
	title = {Enhancing PV feed-in power forecasting through federated learning with differential privacy using LSTM and GRU},
	year = {2024},
	journal = {Energy and AI},
	volume = {18},
	pages = {},
	doi = {10.1016/j.egyai.2024.100452},
	url = {https://www.scopus.com/pages/publications/85210131221?origin=resultslist},
	affiliations = {Institute of Databases and Information Systems, Ulm University, Ulm, 89081, Germany; Smart Grids Research Group, Ulm University of Applied Sciences, Ulm, 89081, Germany},
	abstract = {Given the inherent fluctuation of photovoltaic (PV) generation, accurately forecasting solar power output and grid feed-in is crucial for optimizing grid operations. Data-driven methods facilitate efficient supply and demand management in smart grids, but predicting solar power remains challenging due to weather dependence and data privacy restrictions. Traditional deep learning (DL) approaches require access to centralized training data, leading to security and privacy risks. To navigate these challenges, this study utilizes federated learning (FL) to forecast feed-in power for the low-voltage grid. We propose a bottom-up, privacy-preserving prediction method using differential privacy (DP) to enhance data privacy for energy analytics on the customer side. This study aims at proving the viability of an enhanced FL approach by employing three years of meter data from three residential PV systems installed in a southern city of Germany, incorporating irradiance weather data for accurate PV power generation predictions. For the experiments, the DL models long short-term memory (LSTM) and gated recurrent unit (GRU) are federated and integrated with DP. Consequently, federated LSTM and GRU models are compared with centralized and local baseline models using rolling 5-fold cross-validation to evaluate their respective performances. By leveraging advanced FL algorithms such as FedYogi and FedAdam, we propose a method that not only predicts sequential energy data with high accuracy, achieving an R<sup>2</sup> of 97.68%, but also adheres to stringent privacy standards, offering a scalable solution for the challenges of smart grids analytics, thus clearly showing that the proposed approach is promising and worth being pursued further. © 2024},
	author_keywords = {Data privacy; Deep learning; Federated learning; Recurrent neural networks; Residential photovoltaic; Smart grid; Solar power forecasting},
	keywords = {Differential privacy; Long short-term memory; Deep learning; Differential privacies; Learning approach; Neural-networks; Power; Power forecasting; Residential photovoltaic; Short term memory; Smart grid; Solar power forecasting; Federated learning},
	correspondence_address = {P. Riedel; Institute of Databases and Information Systems, Ulm University, Ulm, 89081, Germany; email: pascal.riedel@uni-ulm.de},
	publisher = {Elsevier B.V.},
	issn = {26665468},
	language = {English},
	abbrev_source_title = {Energy. AI.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 29; All Open Access; Gold Open Access; Green Open Access}
}

