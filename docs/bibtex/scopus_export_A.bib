	keywords = {Boolean functions; Curve fitting; Differentiation (calculus); Energy conversion efficiency; Newton-Raphson method; Solar energy; Solar power generation; Diode modeling; Energy estimation; Lambert W function; Mathematical double diode model; Metaheuristic; Metaheuristic puma optimizer; Optimizers; Parameters identification; Solar photovoltaic energies; Solar photovoltaic energy estimation; Mean square error},
