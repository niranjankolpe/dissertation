	url = {https://www.scopus.com/pages/publications/105021363191?origin=resultslist},
	affiliations = {Department of Mechanical and Industrial Engineering, College of Engineering, Qatar University, Doha, Qatar},
	abstract = {Multigeneration systems (MGS) with integrated hydrogen (H<sub>2</sub>) production are emerging as vital solutions for meeting global energy demands while addressing environmental sustainability. This review presents the first comprehensive evaluation of MGS with integrated H<sub>2</sub> production driven by diverse energy sources, including solar, geothermal (Geo), biomass (BM), biogas (BG), natural gas (NG), and waste heat (WH). Through an in-depth analysis of 143 peer-reviewed papers, we assess the performance of these systems based on thermoeconomic, environmental, and sustainability metrics. Our findings reveal that hybrid systems, particularly those combining renewable and nonrenewable sources, stand out for their superior performance. Hybrid configurations utilizing solar and NG with advanced cycles like supercritical CO<sub>2</sub> (sCO<sub>2</sub>) achieve the highest overall efficiency, up to 90%, and exergy efficiencies exceeding 70%. In addition, hybrid systems demonstrate remarkable H<sub>2</sub> production capacities, with solar–NG systems generating up to 50 MW of power and producing 20 tons of H<sub>2</sub> per day, while reducing CO<sub>2</sub> emissions to as low as 0.2 kgCO<sub>2</sub>e/kW h. Optimization techniques, such as genetic algorithms (GAs) and particle swarm optimization (PSO), improve system performance by up to 20%, while machine learning (ML) enhances operational efficiency and predictive accuracy in real-time applications. This review also highlights the trade-off between system complexity and efficiency, where more intricate configurations, such as those involving multiple energy inputs and advanced thermodynamic cycles, deliver higher performance at the cost of increased system complexity. Our analysis provides novel insights and offers a road map for future research, confirming the critical role of MGS in achieving global decarbonization targets through cost-effective H<sub>2</sub> production and optimized performance. Copyright © 2025 Hamad M. Banshamlan et al. International Journal of Energy Research published by John Wiley & Sons Ltd.},
	author_keywords = {energy sources; H<sub>2</sub> production; multigeneration; performance analysis; polygeneration},
	keywords = {Carbon dioxide; Cost benefit analysis; Cost effectiveness; Energy efficiency; Energy utilization; Genetic algorithms; Global warming; Hybrid power; Hybrid systems; Hydrogen fuels; Hydrogen production; Particle swarm optimization (PSO); Solar power generation; Sustainable development; Energy source; Fuel production; Global energy demand; H 2 production; Integrated hydrogen; Multi generations; Performance; Performances analysis; Poly-generation; Systems complexity; Economic and social effects},
	correspondence_address = {A.K. Sleit; Department of Mechanical and Industrial Engineering, College of Engineering, Qatar University, Doha, Qatar; email: asleiti@qu.edu.qa},
	publisher = {John Wiley and Sons Ltd},
	issn = {0363907X},
