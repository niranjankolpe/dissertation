	volume = {2021},
	pages = {},
	doi = {10.1155/2021/6692626},
	url = {https://www.scopus.com/pages/publications/85103669430?origin=resultslist},
	affiliations = {Laboratory of Physic of Condensed Matter and Renewable Energy, Faculty of Sciences and Techniques, Hassan II Casablanca University, Mohammedia, 28806, Morocco; Department of Computer Science, Faculty of Sciences and Techniques, Hassan II Casablanca University, Mohammedia, 28806, Morocco; Laboratory of Computer Science, Polydisciplinary Faculty of Khouribga, Sultan Moulay Slimane University, Khouribga, 2500, Morocco},
	abstract = {Photovoltaic power generation depends significantly on solar radiation, which is variable and unpredictable in nature. As a result, the production of electricity from photovoltaic power cannot be guaranteed permanently during the operational phase. Forecasting global solar radiation can play a key role in overcoming this drawback of intermittency. This paper proposes a new hybrid method based on machine learning (ML) algorithms and daily classification technique to forecast 1 h ahead of global solar radiation in the city of Évora. Firstly, several comparative studies have been done between random forest (RF), gradient boosting (GB), support vector machines (SVM), and artificial neural network (ANN). These comparisons were made using annual, seasonal, and daily testing sets in order to determine the best ML algorithm under different meteorological conditions. Subsequently, the daily classification technique has been applied to classify the original training set into sunny and cloudy training subsets in order to enhance the forecasting accuracy. The evaluation of the proposed ML algorithms was carried out using the normalized root mean square error (nRMSE) and the normalized absolute mean error (nMAE). The results of the seasonal comparison show that the RF model performs well for spring and autumn seasons with nRMSE equaling 22.53% and 23.42%, respectively. While the SVR model gives good results for winter and summer seasons with nRMSE equaling 24.31% and 8.41%, respectively. In addition, the daily comparison demonstrates that the RF model performs well for cloudy days with nRMSE = 41.40%, while the SVR model yields good results for sunny days with nRMSE = 8.88%. The results show that the daily classification technique enhances the forecasting accuracy of ML models. Furthermore, this study demonstrates that the forecasting accuracy of ML algorithms depends significantly on sky conditions. © 2021 Hamza Ali-Ou-Salah et al.},
	keywords = {Classification (of information); Decision trees; Forecasting; Learning systems; Mean square error; Neural networks; Photovoltaic cells; Solar power generation; Solar power plants; Solar radiation; Support vector machines; Classification technique; Comparative studies; Forecasting accuracy; Global solar radiation; Meteorological condition; Photovoltaic power generation; Root mean square errors; Solar radiation forecasting; Learning algorithms},
