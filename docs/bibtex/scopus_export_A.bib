@ARTICLE{Kaffash2021,
	author = {Kaffash, Mahtab and Ceusters, Glenn and Deconinck, Geert},
	title = {Interval optimization to schedule a multi-energy system with data-driven PV uncertainty representation†},
	year = {2021},
	journal = {Energies},
	volume = {14},
