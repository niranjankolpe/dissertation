	year = {2025},
	journal = {Menoufia Journal of Electronic Engineering Research},
	volume = {34},
	number = {1},
	pages = {13 - 25},
	doi = {10.21608/mjeer.2025.330808.1097},
	url = {https://www.scopus.com/pages/publications/85217212707?origin=resultslist},
	affiliations = {Electronics Technology Department, Faculty of Technology and Education, Helwan University, Cairo, Egypt; Rad. Eng. Dept, National Center for Radiation Research and Technology, Egyptian Atomic Energy Authority, Cairo, Egypt},
	abstract = {Many countries are working to install small solar power plants on residential and local buildings' roofs. In Egypt, numerous public buildings, such as schools, have empty and unutilized roofs that are mostly free from shadows or obstacles. The research suggests the installation of small-scale solar stations on the building’s rooftops. These stations would make use of large portions of the roofs to produce clean electricity, powering the institutions and connecting them to the public electrical grid. The research explores ways to enhance the efficiency of these small-scale independent solar stations by examining various factors such as building dimensions, site coordinates, panel size, roof area available for installation, Sun angles each day, and roof heights. Key factors that affect photovoltaic panels include regional climatic conditions, panel inclination angles, distances between panel rows, solar radiation, and panel temperature. To analyze these variables, the research utilized numerous programs involving artificial intelligence, including PVSYST, Skelion, and Google Earth. These tools helped determine optimal distances between rows and optimal inclination angles for solar panel installation. They also enabled the assessment of climatic factors' impact on panel performance, calculations of the produced electrical energy, and estimations of annual energy production losses. The findings indicated that the optimal inclination angle for solar module ranges from 18 to 22º to minimize shadows’ effects on energy production. Furthermore, the results emphasized the significance of solar radiation, demonstrating a direct relationship between the average monthly sun radiation and the power produced by the panels. © 2025, Menoufia University, Faculty of Electronic Engineering. All rights reserved.},
	author_keywords = {Inclination angle; PV mathematical model; PV radiation effect; PV simulation; PV temperature effect; PVSYST software; Skelion software; SketchUp software},
	publisher = {Menoufia University, Faculty of Electronic Engineering},
	issn = {16871189},
	language = {English},
	abbrev_source_title = {Menoufia J. Electron. Eng. Res.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Iqbal202553039,
	author = {Iqbal, Saeed and Maaz Hasan, Syed and Ayaz, Yasar and Ud Din, Emad and Waqas, Adeel and Sajid, Muhammad},
	title = {Condition Monitoring of Photovoltaic Panels Through Electrical Impedance Spectroscopy and Machine Learning Focusing on Temperature, Dust, and Microcracks},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {53039 - 53052},
	doi = {10.1109/ACCESS.2025.3550738},
	url = {https://www.scopus.com/pages/publications/105001652505?origin=resultslist},
	affiliations = {National University of Sciences and Technology (NUST), School of Mechanical and Manufacturing Engineering (SMME), Islamabad, 44000, Pakistan; National University of Sciences and Technology (NUST), U.S. Pakistan Center For Advanced Studies in Energy (USPCAS-E), Islamabad, 44000, Pakistan; University College Dublin (UCD), School of Mechanical and Materials Engineering, Dublin 4 D04 V1W8, Ireland},
	abstract = {The efficiency of Photovoltaic (PV) systems depends on environmental conditions that include temperature variations, dust accumulation and microcracks. These factors severely affect the output power of PV systems particularly where PV is installed domestically for which monitoring and maintenance are challenging due to cost constraints. Traditional numerical schemes are limited because PV systems exhibit nonlinear behavior due to environmental factors. To address this issue, electrical impedance spectroscopy (EIS) combined with machine learning is studied, modeling different scenarios to monitor the impact of temperature variations, dust and microcracks on photovoltaic (PV) systems.The experiment was conducted in a controlled environment, generating datasets for machine learning using EIS on solar panels through direct current (DC) lines over a frequency range of 1 Hz to 25 MHz. The light gradient boosting machine (LGBM) demonstrated great performance, achieving an F1 score of 0.856 for temperature classification and 0.975 for detection of dust and microcracks. The results of this study suggest the integration of EIS with machine learning schemes presents a cost effective and viable solution for real time monitoring of PV systems. This approach not only mitigates the effect of environmental factors but also reduces the cost of maintenance and increases predictive maintenance ensuring enhanced PV system performance.  © 2025 IEEE.},
	author_keywords = {Decentralized energy systems (DES); electrical impedance spectroscopy; health monitoring; photovoltaics technology},
	keywords = {Adaptive boosting; Microcracking; Solar concentrators; Condition; Decentralized energy system; Electrical impedance spectroscopy; Environmental factors; Health monitoring; Machine-learning; Photovoltaic systems; Photovoltaic technology; Temperature variation; Predictive maintenance},
	correspondence_address = {M. Sajid; National University of Sciences and Technology (NUST), School of Mechanical and Manufacturing Engineering (SMME), Islamabad, 44000, Pakistan; email: muhammad.sajid@ucd.ie},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21693536},
	language = {English},
	abbrev_source_title = {IEEE Access},
	type = {Article},
