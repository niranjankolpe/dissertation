@ARTICLE{Nafa2025,
	author = {Nafa, Ali Zaki Mohammed and Obed, Adel A. and Abid, Ahmed J. and Yaqoob, Salam J. and Bajaj, Mohit and Blazek, Vojtech},
	title = {Adaptive neuro-fuzzy modeling for real-time solar irradiance prediction using PV module operating parameters},
	year = {2025},
