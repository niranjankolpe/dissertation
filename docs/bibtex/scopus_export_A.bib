	keywords = {Green buildings; Building energy consumption; Coupled optimization simulation; Deep learning; Energy-consumption; Optimization-simulation; Photovoltaic utilization; Photovoltaics; Simulation studies; Urban block form; Urban blocks; Carbon capture and utilization},
