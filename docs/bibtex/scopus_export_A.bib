@ARTICLE{Pongphaw2025245,
	author = {Pongphaw, Nitipon and Maneesai, Keerati and Sanonok, Pantong and Buaphan, Prommin},
	title = {Interpretable cloud cover prediction for dynamic solar prediction in low-data environments},
