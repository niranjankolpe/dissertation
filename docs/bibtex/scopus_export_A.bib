@CONFERENCE{Panahazari2023,
	author = {Panahazari, Mohammad and Koscak, Matthew and Zhang, Jianhua and Hou, Daqing and Wang, Jing and Gao, David Wenzhong},
	title = {A Hybrid Optimization and Deep Learning Algorithm for Cyber-resilient DER Control},
	year = {2023},
	journal = {2023 IEEE Power and Energy Society Innovative Smart Grid Technologies Conference, ISGT 2023},
