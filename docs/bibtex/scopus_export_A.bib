@CONFERENCE{Ehtsham2025,
	author = {Ehtsham, Muhammad and Rotilio, Marianna and Cucchiella, Federica and Di Giovanni, Gianni and Schettini, Domenico},
	title = {Investigating the effects of hyperparameter sensitivity on machine learning algorithms for PV forecasting},
	year = {2025},
	journal = {E3S Web of Conferences},
	volume = {612},
	pages = {},
	doi = {10.1051/e3sconf/202561201002},
	url = {https://www.scopus.com/pages/publications/85217677040?origin=resultslist},
	affiliations = {Department of Civil, Construction-Architectural and Environmental Engineering, University of l'Aquila, Italy; Department of Industrial and Information Engineering and Economics, University of l'Aquila, Italy},
	abstract = {Machine Learning (ML) models have been introduced in the past, and users have debated whether to tune the hyperparameters of the models. This study investigates the effects of tuning the hyperparameters of the ML models and summarizes the models that are most sensitive to hyperparameter tuning. This study leveraged the historic energy production data of two already operational PV plants. Four state-of-the-art ML models, namely Decision Trees (DT), Random Forest (RF), K-Nearest Neighbors (KNN), and Support Vector Regression (SVR) were investigated. All the ML models were trained with the same training features (meteorological estimates) obtained from the National Aeronautics and Space Administration's (NASA) Power project, with the daily PV energy production selected as the target variable. Models were developed and executed with default and tuned hyperparameters using an 85-15% train-test split. The results revealed that all the models showed improved performance with the tuned hyperparameters. However, the DT and SVR models depicted significantly improved RMSE after tuning of the hyperparameters. The RMSE of DT improved from 111 kWh/d to 75 kWh/d for one plant and from 442 kWh/d to 270 kWh/d for the second plant after tuning the hyperparameters. Similarly, the RMSE of SVR improved from 59 kWh/d to 50 kWh/d in the first case, and in the second case, the improvement of RMSE from 536 kWh/d to 294 kWh/d was observed. The efficiency of the RF and KNN models also improved to some extent after tuning, but the RMSE closely agreed with the default hyperparameters in one case study, making the RF and KNN less prone to hyperparameter sensitivity. This study concluded with the finding that it is necessary to tune the hyperparameters of the DT and SVR models, specifically for energy forecasting. Moreover, the results of this study also highlight the significance of meteorological estimates from NASA's Power project, as models successfully discerned the complex energy forecast patterns. The dataset is deemed suitable for energy forecasting for areas with sparse ground-based observatories and may serve as a baseline dataset for training the ML models.  © The Authors.},
	correspondence_address = {M. Ehtsham; Department of Civil, Construction-Architectural and Environmental Engineering, University of l'Aquila, Italy; email: muhammad.ehtsham@graduate.univaq.it},
	editor = {Chiang P.-C.},
	publisher = {EDP Sciences},
	issn = {25550403},
	language = {English},
	abbrev_source_title = {E3S Web Conf.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Moayyed2025193356,
	author = {Moayyed, Hamed and Abdeltawab, Hussein and Gomes, Luis and Vale, Zita},
	title = {Adaptive Federated Learning for Robust PV Power Forecasting Under Weather-Induced Concept Drift},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {193356 - 193376},
	doi = {10.1109/ACCESS.2025.3630992},
	url = {https://www.scopus.com/pages/publications/105021541996?origin=resultslist},
	affiliations = {Wake Forest University, Department of Engineering, Winston-Salem, 27101, NC, United States; LASI–Intelligent Systems Associate Laboratory, ISEP, Polytechnic of Porto, GECAD–Research Group on Intelligent Engineering and Computing for Advanced Innovation and Development, Porto, 4249-015, Portugal},
	abstract = {Photovoltaic (PV) power forecasting is vital for renewable energy integration but remains vulnerable to concept drift caused by dynamic weather conditions such as temperature, irradiance, and wind. This paper proposes an Adaptive Federated Learning (AFL) framework that combines federated learning with adaptive retraining to manage both abrupt and gradual drifts in decentralized PV systems. AFL integrates dual drift detectors, Rényi divergence for abrupt shifts and Wasserstein distance for gradual trends, together with adaptive thresholding and selective client retraining to ensure timely and efficient adaptation. Evaluations on real-world PV datasets show that AFL achieves 6–9% lower RMSE and ≈30% shorter recovery time than leading federated baselines (FedAvg, FedProx, FedDyn, APFL, and FedCurv), while maintaining consistent performance across non-stationary periods. The approach also demonstrates R<sup>2</sup> ≈ 0.91 under drift conditions and R<sup>2</sup> ≈ 0.96 during cross-site transfer tests between a smart-building system in Portugal and a microgrid in Norway, confirming strong generalization to unseen environments. AFL operates efficiently on CPU-based edge devices (8–16 GB RAM) without GPU acceleration, enabling practical deployment in distributed solar networks and microgrid controllers. Overall, the framework provides a scalable and computation-efficient solution for real-world non-IID PV forecasting, capable of continuous adaptation under seasonal variability, anomalies, and evolving operational conditions. © 2013 IEEE.},
	author_keywords = {Adaptive deep learning; concept drift adaptation; federated learning; photovoltaic power forecasting; renewable energy prediction; weather variability},
	keywords = {Deep learning; Distributed computer systems; Intelligent buildings; Learning systems; Microgrids; Photovoltaics; Program processors; Adaptive deep learning; Concept drift adaptation; Concept drifts; Energy prediction; Photovoltaic power; Photovoltaic power forecasting; Power forecasting; Renewable energies; Renewable energy prediction; Weather variability; Weather forecasting},
	correspondence_address = {H. Moayyed; Wake Forest University, Department of Engineering, Winston-Salem, 27101, United States; email: moayyeh@wfu.edu},
