	correspondence_address = {F.A.L. Vargas; Programa de Ingeniería Electrónica, Grupo de Investigación ITEM, Universidad Pontificia Bolivariana Seccional Montería, Montería, Colombia; email: fabian.lara@upb.edu.co},
