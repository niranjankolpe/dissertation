@ARTICLE{Haputhanthri2026,
	author = {Haputhanthri, Dilantha and De Silva, Daswin and Kaynak, Okyay and Mills, Nishan and Kahawala, Sachin and Moraliyage, Harsha and Jennings, Andrew},
	title = {Solar power forecasting with sparse deep learning for fast frequency response ancillary services},
