	keywords = {Clouds; Data fusion; Forecasting; Information fusion; Parameter extraction; Radiative transfer; Renewable energy; Solar irradiance; Solar power generation; Solar radiation; Cross-modal; Cross-modal attention fusion; Multi-source data fusion; Multi-Sources; Parameters extraction; Physic parameter extraction; Solar irradiance forecasting; Solar irradiances; Source data; Spatio-temporal models; Extraction},
