@ARTICLE{Dumas20221234,
	author = {Dumas, Jonathan and Cointe, Colin and Wehenkel, Antoine and Sutera, Antonio and Fettweis, Xavier and Cornelusse, Bertrand},
	title = {A Probabilistic Forecast-Driven Strategy for a Risk-Aware Participation in the Capacity Firming Market},
	year = {2022},
	journal = {IEEE Transactions on Sustainable Energy},
	volume = {13},
	number = {2},
	pages = {1234 - 1243},
	doi = {10.1109/TSTE.2021.3117594},
	url = {https://www.scopus.com/pages/publications/85115979565?origin=resultslist},
	affiliations = {Departments of Computer Science, Electrical Engineering and Geography, University of Liège, Liège, Belgium},
	abstract = {This paper addresses the energy management of a grid-connected renewable generation plant coupled with a battery energy storage device in the capacity firming market, designed to promote renewable power generation facilities in small non-interconnected grids. The core contribution is to propose a probabilistic forecast-driven strategy, modeled as a min-max-min robust optimization problem with recourse. It is solved using a Benders-dual cutting plane algorithm and a column and constraints generation algorithm in a tractable manner. A dynamic risk-averse parameters selection strategy based on the quantile forecasts distribution is proposed to improve the results. A secondary contribution is to use a recently developed deep learning model known as normalizing flows to generate quantile forecasts of renewable generation for the robust optimization problem. This technique provides a general mechanism for defining expressive probability distributions, only requiring the specification of a base distribution and a series of bijective transformations. Overall, the robust approach improves the results over a deterministic approach with nominal point forecasts by finding a trade-off between conservative and risk-seeking policies. The case study uses the photovoltaic generation monitored on-site at the University of Liège (ULiège), Belgium.  © 2010-2012 IEEE.},
	author_keywords = {Benders decomposition; Capacity firming; deep learning; electricity market; normalizing flows; renewable generation uncertainty; robust optimization},
	keywords = {Deep learning; Economic and social effects; Electric energy storage; Forecasting; Optimization; Power markets; Benders' decompositions; Capacity firming; Deep learning; Electricity market; Generation uncertainty; Normalizing flow; Probabilistic forecasts; Renewable generation; Renewable generation uncertainty; Robust optimization; Probability distributions},
	correspondence_address = {J. Dumas; Departments of Computer Science, Electrical Engineering and Geography, University of Liège, Liège, Belgium; email: jdumas@uliege.be},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {19493029},
	language = {English},
