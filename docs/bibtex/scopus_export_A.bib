@CONFERENCE{Su2026,
	author = {Su, Yongyi and Zhang, Weirong and Zhou, Ning and Shi, Honggang and Wang, Jianlin},
	title = {A Short-Term Photovoltaic Power Prediction Method for Residential Energy Systems and Its Application in Scheduling Strategies},
	year = {2026},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {1582},
	number = {1},
	pages = {},
	doi = {10.1088/1755-1315/1582/1/012012},
