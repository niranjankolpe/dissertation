@ARTICLE{Huang20241711,
	author = {Huang, Hao-Hsuan and Huang, Yun-Hsun},
	title = {Probabilistic forecasting of regional solar power incorporating weather pattern diversity},
	year = {2024},
	journal = {Energy Reports},
	volume = {11},
	pages = {1711 - 1722},
	doi = {10.1016/j.egyr.2024.01.039},
	url = {https://www.scopus.com/pages/publications/85183318442?origin=resultslist},
	affiliations = {Department of Resources Engineering, National Cheng Kung University, Tainan, 701, Taiwan},
	abstract = {Power grid stability depends on the ability to forecast solar power generation at the regional level. Most previous research on probabilistic forecasting has focused on the use of machine learning to predict the output of individual solar power plants rather than regional solar power generation, and few studies have considered the effects of seasonal weather patterns at the regional level. In this study, climate and geographic data were collected from 83 weather stations between 2019 and 2021 for use in developing a probabilistic model by which to predict regional solar power generation. The results of weather pattern analysis based on unsupervised machine learning and ensemble voting were used to build a probabilistic quantile regression model for the short-term prediction of regional solar power generation capacity. The efficacy of the model was assessed using data from 48 solar PV power plants, which included four sub-datasets pertaining to four target regions. Highly accurate results were consistently obtained across all regions in both the winter and summer seasons. The proposed probabilistic model outperformed conventional deterministic model by 6.55% and conventional probabilistic model by 4.03% in terms of total normalized mean absolute error (NMAE). Prediction intervals generated by the proposed model could be used as input parameters for regional power dispatch decisions. © 2024 The Authors},
	author_keywords = {Ensemble voting; Regional probabilistic forecasting; Regional weather patterns; Solar PV; Unsupervised learning},
	keywords = {Climate models; Concentrated solar power; Electric load dispatching; Machine learning; Regression analysis; Solar energy; Solar energy conversion; Weather forecasting; Ensemble voting; Pattern diversity; Probabilistic forecasting; Probabilistic models; Regional levels; Regional probabilistic forecasting; Regional weather; Regional weather pattern; Solar PVs; Weather patterns; Solar power generation},
