	title = {A review of deep learning transformer variants used in solar PV forecasting},
	year = {2026},
	journal = {Sustainable Energy Research},
	volume = {13},
	number = {1},
	pages = {},
	doi = {10.1186/s40807-026-00270-7},
	url = {https://www.scopus.com/pages/publications/105051900073?origin=resultslist},
	affiliations = {Department of Computer Science and Engineering, Career Point University,  Himachal Pradesh, Hamirpur, India; Department of Electronics and Communication Engineering, University Institute of Technology, Himachal Pradesh University,  Himachal Pradesh, Shimla, India; Centre for Green Energy and Nanotechnology, Himachal Pradesh University, Himachal Pradesh, Shimla, India},
	abstract = {Solar power has become one of the most important renewable energy sources as it is sustainable, its prices are reducing, and it could contribute to the transition to clean energy across the world. Nevertheless, the inherently intermittent nature of solar PV output due to the rapidly fluctuating weather conditions demands a very serious need to have accurate forecasting systems. The current reviews are primarily over traditional deep learning or statistical models, creating a knowledge gap on how transformer-based architectures intend to separate long-term dependencies and nonlinear behaviours of solar PV forecasting. Consequently, the objective of this review is to fill this gap by giving a detailed analysis of the variants of transformers that would be utilized when predicting PV power. A large variety of transformer models, among which are Simple Transformer, Informer, Temporal Fusion Transformer (TFT), Patch-Transformers, TSformer, and Hybrid Transformer models, among other recent models, are systematically analysed in this paper. Their architectural innovations, approach enhancement, benefits, and drawbacks in the forecasting of solar energy are described in the review. The strategy adopted also involves comparative appraisal, architecture-based classification, and analysis based on published benchmark investigations in terms of performance metrics. The result of this review demonstrates that transformer-based models are better than classic AI algorithms to capture long-range temporal patterns, process heterogeneous inputs, and achieve better forecasting results. The findings of the literature show further that strong increases in robustness, interpretability, and predictability of multiple horizons are achieved. Altogether, this review provides a unified picture of the modern transformer-based developments and defines the future research that ought to facilitate the improvement of scalability, uncertainty quantification, and the deployment of PV forecasting systems in the real world. © The Author(s) 2026.},
	author_keywords = {Deep machine learning; Hybrid transformer model; Informer transformer; Patch- transformer; Solar PV forecasting; Temporal fusion; Transformer},
	keywords = {Architecture; Benchmarking; Learning systems; Solar energy; Weather forecasting; Deep machine learning; Hybrid transformer model; Informer transformer; Machine-learning; Patch- transformer; Solar PV forecasting; Solar PVs; Temporal fusion; Transformer; Transformer modeling; alternative energy; benchmarking; forecasting method; innovation; machine learning; nonlinearity; photovoltaic system; prediction; solar power; temporal analysis; Deep learning},
	correspondence_address = {M. Kumar; Department of Electronics and Communication Engineering, University Institute of Technology, Himachal Pradesh University, Shimla,  Himachal Pradesh, India; email: naik.manish17@gmail.com},
	publisher = {Springer Science and Business Media B.V.},
	issn = {27319237},
	language = {English},
	abbrev_source_title = {Sustain. Energy. Research},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Verma2026,
