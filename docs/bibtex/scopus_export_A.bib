	affiliations = {Department of Electronics, Telecommunications and Space Technologies, Satbayev University, 22 Satbayev Avenue, Almaty, 050000, Kazakhstan; Department of Power Engineering, Satbayev University, 22 Satbayev Avenue, Almaty, 050000, Kazakhstan},
	abstract = {This study presents an AI-driven energy management framework for renewable-powered ozone generation systems based on dielectric barrier discharge (DBD) technology. The aim is to improve energy efficiency, operational reliability, and adaptability under variable renewable energy conditions. The proposed system integrates photovoltaic (PV) generation, battery storage, and an intelligent control strategy combining long short-term memory (LSTM) forecasting with reinforcement learning (RL)-based optimization. The novelty of this work lies in the development of an integrated control framework that combines nonlinear DBD ozone generator modeling, renewable energy variability, battery dynamics, predictive forecasting, and adaptive RL-based decision-making within a unified architecture. Unlike conventional approaches, the proposed method enables coordinated real-time optimization of power allocation, battery scheduling, and system operation. A comprehensive model is formulated as a multi-objective optimization problem to minimize energy consumption and unmet load while maximizing ozone production efficiency. Simulation results show that energy consumption is reduced by 20–30%, while ozone efficiency increases to approximately 30 g/kWh compared to 14 g/kWh for fixed operation. System reliability is improved, with unmet load reduced from 480 Wh to 20 Wh. Techno-economic analysis confirms reduced annual electricity costs, demonstrating the practical applicability of the proposed framework. © The Author(s) 2026.},
	author_keywords = {Dielectric barrier discharge; Energy management; Ozone generation; Photovoltaic systems; Reinforcement learning},
	publisher = {Engineered Science Publisher},
	issn = {25780646},
	language = {English},
	abbrev_source_title = {ES. Energy. Environ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Bronze Open Access}
}

