}

@ARTICLE{Almalaq2025,
	author = {Almalaq, Abdulaziz and Harrison, Ambe and Alsaleh, Ibrahim and Alassaf, Abdullah and Alangari, Mashari},
	title = {Comprehensive control strategy for standalone photovoltaic systems with integrated optimum power harvesting and voltage regulation through microcontroller in the loop experimentation},
	year = {2025},
