	author = {Papadopoulos, Demetrios N. and Kasper, Evi Monique and Qussous, Ramiz and Schmidt, Michael and Weidlich, Anke},
	title = {From predictions to power flow: Connecting forecasting accuracy and impacts in distribution grids},
	year = {2026},
	journal = {Sustainable Energy, Grids and Networks},
	volume = {47},
