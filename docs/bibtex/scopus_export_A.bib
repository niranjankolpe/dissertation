	author = {Rodríguez, Fermín and Azcárate, Iñigo and Vadillo, Javier and Galarza, Ainhoa},
	title = {Forecasting intra-hour solar photovoltaic energy by assembling wavelet based time-frequency analysis with deep learning neural networks},
	year = {2022},
