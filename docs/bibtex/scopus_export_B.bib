	author = {Alvarez-Alvarez, Carlos and Manso Conde, Javier and Gonzalez Gonzalo, Jorge E. and Mezquita, Yeray},
	title = {Privacy-Preserving One-Hour-Ahead Solar Power Forecasting via Federated Learning},
	year = {2026},
	journal = {Proceedings of 2026 International Conference on Infrastructure-as-a-Service (IaaS) and Platform-as-a-Service (PaaS) Solutions for Europe's Next-Gen Cloud Infrastructure, NOUS 2026},
	pages = {1 - 7},
	doi = {10.1145/3793828.3793845},
	url = {https://www.scopus.com/pages/publications/105045259564?origin=resultslist},
	affiliations = {AIR Institute, Deep Tech Lab, IoT Digital Innovation Hub, Salamanca, Spain; AIR Institute, Deep Tech Lab, Zamora, Spain},
	abstract = {Accurate short-term solar production forecasting is essential for grid operations and energy trading, yet centralizing multi-site data is often constrained by privacy, governance, and data-transfer limitations. We study federated learning (FL) for one-hour-ahead solar power prediction using a sequence model that maps the previous 24 hours of inputs to the next-hour production target. Using a fixed LSTM-based architecture and FedAvg aggregation, we evaluate FL at multiple federation scales (5, 20, 30, and 55 clients) and report predictive quality (sMAPE, RMSE, MAE, R<sup>2</sup>) together with federated wall-clock training time. Across comparable scales, FL attains performance close to centralized training, with metric-dependent trade-offs: at 30 clients, FL improves sMAPE (93.44% vs. 98.79%) while centralized training yields lower RMSE (5.52 vs. 6.05); at 55 clients, centralized training outperforms FL in both RMSE (3.75 vs. 4.80) and sMAPE (95.16% vs. 100.29), while FL achieves higher R<sup>2</sup> (0.9166 vs. 0.8884). Federated runtime increases with the number of clients but remains within a sub-hour budget (up to 47 minutes at 55 clients), supporting practical periodic retraining. We conclude with deployment-oriented guidance on client participation per round to balance convergence stability with operational constraints under non-IID client data. © 2026 Copyright held by the owner/author(s).},
	author_keywords = {Edge Training; Federated Learning; LSTM; Privacy-Preserving ML; Solar Forecasting; Time Series},
