@ARTICLE{Seghiour2026,
	author = {Seghiour, Abdellatif and Bendjeddou, Yacine and Mostefaoui, Imene Meriem and Chouder, Aissa and Alharbi, Hisham and Humayd, Abdullah S. Bin and Wondimeneh, Abebe Wondiferaw and Babqi, Abdulrahman},
	title = {Fault detection and diagnosis in photovoltaic systems using artificial intelligence and time–frequency analysis},
	year = {2026},
