@ARTICLE{Chen2026,
	author = {Chen, Dayin and Shi, Xiaodan and Jiang, Mingkun and Zhu, Shibo and Zhang, Haoran and Zhang, Dongxiao and Chen, Yuntian and Yan, Jinyue},
	title = {AutoPV: An intelligent framework for automated design of photovoltaic forecasting models},
	year = {2026},
	journal = {Applied Energy},
	volume = {415},
	pages = {},
	doi = {10.1016/j.apenergy.2026.127851},
	url = {https://www.scopus.com/pages/publications/105035519238?origin=resultslist},
	affiliations = {Department of Building Environment and Energy Engineering, The Hong Kong Polytechnic University, Hung Hom, Kowloon, Hong Kong; International Centre of Urban Energy Nexus, The Hong Kong Polytechnic University, Hung Hom, Kowloon, Hong Kong; Zhejiang Key Laboratory of Industrial Intelligence and Digital Twin, Eastern Institute of Technology, Ningbo, 315201, China; Ningbo Institute of Digital Twin, Eastern Institute of Technology, Ningbo, 315201, China; Department of Computer and Systems Sciences, Stockholm University, Stockholm, Sweden; School of Urban Planning and Design, Peking University, Shenzhen, 508055, China; SPIC Energy Science and Technology Institute, Shanghai, 200240, China; SPIC Qinghai PV Industry Innovation Center Co., Ltd., Xi'an, 710061, China},
	abstract = {Photovoltaic power forecasting (PVPF) is essential for the efficient integration of solar energy into power systems. Despite recent advances in machine learning and deep learning, designing optimal forecasting models for specific PVPF tasks remains challenging due to the varying performance of models across different scenarios and the need for domain expertise in architecture selection. While neural architecture search (NAS) has shown potential in automating model design in fields such as computer vision, its application in time series forecasting (TSF) is limited, largely due to the structural diversity of TSF models. This study proposes a modular approach to TSF model design and constructs a tailored search space specifically for PVPF tasks. Based on this search space, we develop AutoPV, an automated model design framework that constructs optimal forecasting architectures by considering task type and data distribution. Experiments on a real-world PV dataset with 8856 hourly samples and 11 features, covering 12 forecasting tasks across two scenarios (with and without future weather reports) and horizons from half-day to one-month ahead, show that AutoPV achieves the lowest MAE on most tasks and reduces average forecasting error by roughly 5–20% compared with strong deep learning and Transformer-based baselines, while keeping the searched architectures compact and deployment-friendly. © 2026 The Author(s)},
	author_keywords = {Energy conversion; Neural architecture search; Photovoltaic power forecasting; Time series forecasting},
	keywords = {Architecture; Automation; Computer architecture; Deep learning; Learning systems; Neural networks; Photovoltaics; Solar energy; Time series; Weather forecasting; Energy; Forecasting models; Modeling designs; Neural architecture search; Neural architectures; Photovoltaic power; Photovoltaic power forecasting; Power forecasting; Time series forecasting; Time series forecasting models; computer vision; experimental study; forecasting method; instrumentation; machine learning; photovoltaic system; solar power; Solar power generation},
