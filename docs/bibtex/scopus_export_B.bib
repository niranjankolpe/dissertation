@ARTICLE{Gregor20233257,
	author = {Gregor, Philipp and Zinner, Tobias and Jakub, Fabian and Mayer, Bernhard},
	title = {Validation of a camera-based intra-hour irradiance nowcasting model using synthetic cloud data},
	year = {2023},
	journal = {Atmospheric Measurement Techniques},
	volume = {16},
	number = {12},
	pages = {3257 - 3271},
	doi = {10.5194/amt-16-3257-2023},
	url = {https://www.scopus.com/pages/publications/85164266962?origin=resultslist},
	affiliations = {Meteorologisches Institut, Ludwig-Maximilians-Universität München, Munich, Germany},
	abstract = {This work introduces a model for all-sky-image-based cloud and direct irradiance nowcasting (MACIN), which predicts direct normal irradiance (DNI) for solar energy applications based on hemispheric sky images from two all-sky imagers (ASIs). With a synthetic setup based on simulated cloud scenes, the model and its components are validated in depth. We train a convolutional neural network on real ASI images to identify clouds. Cloud masks are generated for the synthetic ASI images with this network. Cloud height and motion are derived using sparse matching. In contrast to other studies, all derived cloud information, from both ASIs and multiple time steps, is combined into an optimal model state using techniques from data assimilation. This state is advected to predict future cloud positions and compute DNI for lead times of up to 20min. For the cloud masks derived from the ASI images, we found a pixel accuracy of 94.66ĝ€¯% compared to the references available in the synthetic setup. The relative error of derived cloud-base heights is 4% and cloud motion error is in the range of ±0.1ms-1. For the DNI nowcasts, we found an improvement over persistence for lead times larger than 1min. Using the synthetic setup, we computed a DNI reference for a point and also an area of 500m×500m. Errors for area nowcasts as required, e.g., for photovoltaic plants, are smaller compared with errors for point nowcasts. Overall, the novel ASI nowcasting model and its components proved to work within the synthetic setup.  © Copyright: },
	keywords = {cloud phenomena; electronic equipment; image; irradiance; model validation; nowcasting},
	correspondence_address = {P. Gregor; Meteorologisches Institut, Ludwig-Maximilians-Universität München, Munich, Germany; email: philipp.gregor@lmu.de},
