@ARTICLE{Li2026,
	author = {Li, Feng and Bai, Fengfeng and Gao, Yang and Zheng, Qipeng},
	title = {Research on photovoltaic power forecasting driven by data characteristics},
	year = {2026},
	journal = {AIP Advances},
	volume = {16},
