	keywords = {Electric load dispatching; Electric power system economics; Electric power transmission networks; Forecasting; Learning algorithms; Learning systems; Optimization; Scheduling algorithms; Base models; Energy; Ensemble algorithms; Improved whale optimization algorithm; Optimization algorithms; Photovoltaic forecasting; Photovoltaics; Renewable energies; Stacked ensemble algorithm; Transportation energy scheduling; Long short-term memory},
