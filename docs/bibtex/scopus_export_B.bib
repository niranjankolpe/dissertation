	keywords = {Architecture; Benchmarking; Computer software selection and evaluation; Deep learning; Learning systems; Network architecture; Statistical tests; Weather forecasting; AI software evaluation; Deep learning architecture; Learning architectures; Mean absolute error; Photovoltaic power; Photovoltaic power forecasting; Power forecasting; Reproducible benchmarking; Software evaluation; Trustworthy AI; Aggregates},
	correspondence_address = {H. Mauladdawilah; School of Civil Engineering, University of Granada, Granada, 18001, Spain; email: mauladdawilah@correo.ugr.es},
