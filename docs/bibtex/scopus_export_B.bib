	keywords = {Digital twin; Dimensionality reduction; Heuristic methods; Learning systems; Long short-term memory; Prediction models; Random forests; Support vector regression; Ensemble learning; Feature representation; Features fusions; Interval prediction; Photovoltaic forecasting; Photovoltaics; Root mean squared errors; Short term memory; Uncertainty; Uncertainty quantifications; Principal component analysis},
	correspondence_address = {R. Al-Hmouz; Abdullah Al Salem University, College of Computer and Systems Engineering, Khaldiya Campus, 72303, Kuwait; email: rami.alhmouz@aasu.edu.kw},
