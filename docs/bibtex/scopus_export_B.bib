}

@ARTICLE{Manzolini2024591,
	author = {Manzolini, Giampaolo and Fusco, Andrea and Gioffrè, Domenico and Matrone, Silvana and Ramaschi, Riccardo and Saleptsis, Marios and Simonetti, Riccardo and Sobic, Filip and Wood, Michael James and Ogliari, Emanuele and Leva, Sonia},
	title = {Impact of PV and EV Forecasting in the Operation of a Microgrid},
	year = {2024},
	journal = {Forecasting},
	volume = {6},
