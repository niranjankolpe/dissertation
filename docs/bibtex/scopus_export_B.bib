	author = {Aracne, Maira and Lops, Camilla and Caroprese, Luciano and Ruga, Tommaso and Zumpano, Ester and Montelpare, Sergio},
	title = {Point-wise vs. cumulative solar forecasting: From daily operations to long-term planning},
	year = {2026},
	journal = {Engineering Science and Technology, an International Journal},
	volume = {77},
