	keywords = {Electric power system economics; Hybrid power; Photovoltaics; Adaptive asymmetric loss; Data-driven model; Dynamic numerical weather prediction correction; Feature enhancement; Numerical weather prediction; Photovoltaic power; Photovoltaic power forecasting; Physic-guided feature enhancement; Power forecasting; Prediction-correction; Weather forecasting},
