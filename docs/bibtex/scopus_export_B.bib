@ARTICLE{A2026,
	author = {A, Rajaperumal T. and Chinnappan, Christopher Columbus},
	title = {Physics-constrained neural networks for reliable solar power forecasting with uncertainty quantification},
	year = {2026},
	journal = {Results in Engineering},
	volume = {29},
	pages = {},
	doi = {10.1016/j.rineng.2026.109521},
	url = {https://www.scopus.com/pages/publications/105030039083?origin=resultslist},
	affiliations = {School of Electrical Engineering, Vellore Institute of Technology, Tamil Nadu, Chennai, India; School of Computer Science and Engineering, Vellore Institute of Technology, Tamil Nadu, Chennai, India},
	abstract = {While accurate forecasting with uncertainty estimation is highly important, Machine Learning (ML) and Deep Learning (DL) models often ignore fundamental physical principles and typically do not provide reliable uncertainty estimates. This study proposes a constraint-guided physics integration realized through a Physics-Constrained Neural Network (PCNN), which incorporates first-principles photovoltaic operational constraints into the neural architecture and applies Bayesian uncertainty estimation to quantify both epistemic and aleatoric uncertainty components. The methodology applies Monte Carlo Dropout along with ensemble techniques to produce a hybrid method for uncertainty estimation. To demonstrate the method's effectiveness, three validation studies were conducted: (1) validation using real-time weather inputs from renewables.ninja API, (2) validation through benchmarking tests against Random Forest, Extreme Gradient Boosting, and Long Short-Term Memory models for accuracy and uncertainty estimation, and (3) validation against synthetic National Solar Radiation Database (NSRDB) data with uncertainty calibration analysis. Results indicate that the PCNN model outperforms all baseline models, achieving R² = 0.9983 on real-time data and exceeding the baseline models on NSRDB data, with an MAE of 0.0213, an RMSE of 0.0347, and an R² of 0.9865. Additionally, the PCNN model exhibited excellent physics-based consistencies and produced calibrated uncertainty estimates. These were characterized by a 95% prediction interval coverage probability of 94.72%, and a continuous ranked probability score of 0.0137. Compared with conventional ML/DL approaches, PCNN outperforms them in terms of accuracy, reliability, and computational efficiency. The framework provides measures of model uncertainty and solar irradiance variability, enabling smart grid applications and improved energy management through predictive accuracy. Copyright © 2026. Published by Elsevier B.V.},
	author_keywords = {Data-driven methods; Grid integration; Physics-constrained neural networks; Solar power prediction; Uncertainty quantification},
	keywords = {Benchmarking; Data integration; Forecasting; Learning systems; Memory architecture; Neural networks; Solar energy; Uncertainty analysis; Data-driven methods; Grid integration; Machine-learning; Neural-networks; Physic-constrained neural network; Power predictions; Solar power prediction; Uncertainty estimates; Uncertainty estimation; Uncertainty quantifications; Computational efficiency},
	correspondence_address = {C.C. Chinnappan; School of Computer Science and Engineering, Vellore Institute of Technology, Chennai, Tamil Nadu, India; email: christopher.columbus@vit.ac.in},
	publisher = {Elsevier B.V.},
