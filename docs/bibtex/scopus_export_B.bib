@ARTICLE{Sigauke2023,
	author = {Sigauke, Caston and Chandiwana, Edina and Bere, Alphonce},
	title = {Spatio-Temporal Forecasting of Global Horizontal Irradiance Using Bayesian Inference},
	year = {2023},
	journal = {Applied Sciences (Switzerland)},
	volume = {13},
	number = {1},
	pages = {},
