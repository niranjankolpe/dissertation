@ARTICLE{Zhai2026,
	author = {Zhai, Zhihua and Zhang, Yuanyuan and Zhou, Liming and Liang, Chengzhong and Chen, Xiangjun and Wang, Ruonan and Qiao, Yu and Guan, Lu},
	title = {Hetero-ST-CrossNet: A physics-guided spatio-temporal model for joint wind–solar microgrid forecasting under extreme ramp events},
	year = {2026},
	journal = {Energy Conversion and Management: X},
	volume = {31},
	pages = {},
	doi = {10.1016/j.ecmx.2026.102109},
	url = {https://www.scopus.com/pages/publications/105044762926?origin=resultslist},
	affiliations = {Jining Polytechnic, Jin Yu Road 77, Jining, 272037, China},
	abstract = {Joint forecasting of distributed wind and solar power is a crucial component for flexible microgrid dispatch, directly advancing Sustainable Development Goal 7 by ensuring reliable and clean energy integration. However, existing deep learning models typically process heterogeneous energy sources homogeneously, entangling wind's non-stationary stochasticity with solar's diurnal periodicity. Furthermore, when optimized via standard global metrics, these models frequently struggle to capture high-gradient power ramps due to mean-reverting optimization biases. To address these architectural limitations, we propose the Heterogeneous Spatio-Temporal Cross-Network (Hetero-ST-CrossNet), a physics-guided and explainable deep learning framework. First, modality-specific adaptive Fast Fourier Transform (FFT) filters, guided by an orthogonal decoupling loss, explicitly isolate distinct frequency signatures into independent latent subspaces. Second, a physics-informed feature-wise linear modulation (WeatherFiLM) mechanism modulates temporal features from heterogeneous shared encoders using meteorological priors as dynamic affine conditions. Finally, soft-adjacency graph convolutions capture spatial synergies, while a customized Ramp-Weighted loss explicitly penalizes severe fluctuations. Extensive experiments are primarily conducted on the 500-scenario DDRE-33 benchmark, complemented by evaluations on the 80-node National Renewable Energy Laboratory database. Empirical results demonstrate that Hetero-ST-CrossNet yields a Global MSE of 0.00113 and a Ramp MAE of 0.02123 on the primary benchmark. Notably, when benchmarked against state-of-the-art spatio-temporal and Transformer-based architectures, the proposed model maintains highly competitive global accuracy while substantially mitigating prediction errors during severe power ramp events. By transforming opaque data-driven forecasting into a physically transparent process, this work equips distribution system operators with a robust tool to manage grid instability during extreme weather transitions. © 2026},
	author_keywords = {Explainable deep learning; Extreme ramp events; Modality decoupling; Renewable energy microgrids; Spatio-temporal forecasting},
	keywords = {Metadata; Microgrids; Solar energy; Stochastic systems; Sustainable development; Weather forecasting; Wind power; Decouplings; Explainable deep learning; Extreme ramp event; Microgrid; Modality decoupling; Ramp events; Renewable energies; Renewable energy microgrid; Spatio-temporal; Spatio-temporal forecasting; Deep learning},
	correspondence_address = {Y. Zhang; Jining Polytechnic, Jining, Jin Yu Road 77, 272037, China; email: zyyxgd@163.com},
