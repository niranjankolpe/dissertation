@ARTICLE{Moayyed2025193356,
	author = {Moayyed, Hamed and Abdeltawab, Hussein and Gomes, Luis and Vale, Zita},
	title = {Adaptive Federated Learning for Robust PV Power Forecasting Under Weather-Induced Concept Drift},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {193356 - 193376},
	doi = {10.1109/ACCESS.2025.3630992},
	url = {https://www.scopus.com/pages/publications/105021541996?origin=resultslist},
	affiliations = {Wake Forest University, Department of Engineering, Winston-Salem, 27101, NC, United States; LASI–Intelligent Systems Associate Laboratory, ISEP, Polytechnic of Porto, GECAD–Research Group on Intelligent Engineering and Computing for Advanced Innovation and Development, Porto, 4249-015, Portugal},
	abstract = {Photovoltaic (PV) power forecasting is vital for renewable energy integration but remains vulnerable to concept drift caused by dynamic weather conditions such as temperature, irradiance, and wind. This paper proposes an Adaptive Federated Learning (AFL) framework that combines federated learning with adaptive retraining to manage both abrupt and gradual drifts in decentralized PV systems. AFL integrates dual drift detectors, Rényi divergence for abrupt shifts and Wasserstein distance for gradual trends, together with adaptive thresholding and selective client retraining to ensure timely and efficient adaptation. Evaluations on real-world PV datasets show that AFL achieves 6–9% lower RMSE and ≈30% shorter recovery time than leading federated baselines (FedAvg, FedProx, FedDyn, APFL, and FedCurv), while maintaining consistent performance across non-stationary periods. The approach also demonstrates R<sup>2</sup> ≈ 0.91 under drift conditions and R<sup>2</sup> ≈ 0.96 during cross-site transfer tests between a smart-building system in Portugal and a microgrid in Norway, confirming strong generalization to unseen environments. AFL operates efficiently on CPU-based edge devices (8–16 GB RAM) without GPU acceleration, enabling practical deployment in distributed solar networks and microgrid controllers. Overall, the framework provides a scalable and computation-efficient solution for real-world non-IID PV forecasting, capable of continuous adaptation under seasonal variability, anomalies, and evolving operational conditions. © 2013 IEEE.},
	author_keywords = {Adaptive deep learning; concept drift adaptation; federated learning; photovoltaic power forecasting; renewable energy prediction; weather variability},
	keywords = {Deep learning; Distributed computer systems; Intelligent buildings; Learning systems; Microgrids; Photovoltaics; Program processors; Adaptive deep learning; Concept drift adaptation; Concept drifts; Energy prediction; Photovoltaic power; Photovoltaic power forecasting; Power forecasting; Renewable energies; Renewable energy prediction; Weather variability; Weather forecasting},
