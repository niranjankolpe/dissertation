	correspondence_address = {M. Mansouri; Sultan Qaboos University, College of Engineering, Department of Electrical and Computer Engineering, Muscat, 123, Oman; email: m.mansouri@squ.edu.om; H. Nounou; Hamad Bin Khalifa University, Education City, College of Science and Engineering, Doha, Qatar; email: hnounou@hbku.edu.qa},
