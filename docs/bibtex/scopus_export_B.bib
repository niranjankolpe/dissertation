	author = {Huang, Xiaohong and Ding, Xiuzhen and Han, Yating and Sima, Qi and Li, Xiaokang and Bao, Yukun},
	title = {Day-Ahead Photovoltaic Power Forecasting Based on SN-Transformer-BiMixer},
	year = {2025},
