	keywords = {Architectural design; Convolutional neural networks; Forecasting; Photovoltaics; Convnext; Inductive bias; Multi-step-ahead predictions; Multisteps; Photovoltaic power; Photovoltaic power forecasting; Photovoltaics; Power forecasting; Structural robustness; Ultra-short-term forecasting; Convolution},
