@ARTICLE{Gbémou2022445,
	author = {Gbémou, Shab and Eynard, Julien and Thil, Stéphane and Grieu, Stéphane},
	title = {Comparison between Time- and Observation-Based Gaussian Process Regression Models for Global Horizontal Irradiance Forecasting},
	year = {2022},
