@ARTICLE{Yang2026,
	author = {Yang, Ting and Chen, Butian and Wang, Yuying and Cheng, Qi and Lu, Danhong},
	title = {Lightweight Multimode Day-Ahead PV Power Forecasting for Intelligent Control Terminals Using CURE Clustering and Self-Updating Batch-Lasso},
	year = {2026},
	journal = {Sustainability (Switzerland)},
	volume = {18},
