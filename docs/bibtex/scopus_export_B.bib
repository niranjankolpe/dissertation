	url = {https://www.scopus.com/pages/publications/105039145819?origin=resultslist},
	affiliations = {Instituto de Automática e Informática Industrial (ai2), Universitat Politècnica de València, València, 46022, Spain; Universitat Politècnica de València, Institute for Energy Engineering, València, 46022, Spain},
	abstract = {The growing penetration of photovoltaic (PV) energy into modern electrical systems highlights the need for accurate forecasting methods that address the inherent intermittency of solar resources. This paper presents a new hybrid methodology that integrates physical modeling and machine learning to enhance PV power prediction. The proposed approach combines theoretical estimates obtained from PVlib - using irradiance, temperature, and module parameters - with a Light Gradient Boosting Machine (LightGBM) model, where the physical outputs serve as exogenous variables. This integration exploits the interpretability of physics-based models and the adaptability of data-driven algorithms. The methodology was validated using high-resolution experimental data from the GEDERlab facility at the Universitat Politècnica de València, which includes a 2.1 kW PV installation and corresponding meteorological sensors. Models were trained with 21 days of data and validated over five, with an additional experiment using four training days to simulate limited-data conditions. Forecasting accuracy was evaluated using the mean absolute error (MAE), root mean square error (RMSE), and coefficient of determination (R2), along with other accuracy metrics. At a one-minute resolution, the hybrid model achieved an MAE of 64.63 W, an RMSE of 146.09 W, and an R2 of 0.9317, outperforming standalone LightGBM and purely physical or statistical models. Under scarce training data, the hybrid configuration maintained superior accuracy, confirming that physical knowledge enhances model stability and generalization. Comparisons with SARIMAX and its hybrid variant further validated these benefits. The proposed framework improves robustness, interpretability, and adaptability in PV forecasting and is extendable to broader climatic and system contexts. © 2026 The Authors.},
