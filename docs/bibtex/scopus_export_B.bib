@ARTICLE{Tziolis2023102038,
	author = {Tziolis, Georgios and Livera, Andreas and Montes-Romero, Jesus and Theocharides, Spyros and Makrides, George and Georghiou, George E.},
	title = {Direct Short-Term Net Load Forecasting Based on Machine Learning Principles for Solar-Integrated Microgrids},
	year = {2023},
