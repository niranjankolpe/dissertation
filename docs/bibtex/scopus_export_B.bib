	title = {A Hybrid Interval Prediction Framework for Photovoltaic Power Prediction Using BiLSTM–Transformer and Adaptive Kernel Density Estimation},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
