	author = {Varaschin, Lorenzo F.C. and Silva, Danilo},
	title = {Benchmarking deep learning methods for irradiance estimation from sky images with applications to video prediction-based irradiance nowcasting},
	year = {2025},
	journal = {Solar Energy},
	volume = {302},
	pages = {},
	doi = {10.1016/j.solener.2025.114000},
