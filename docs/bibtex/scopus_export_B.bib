@ARTICLE{Somefun2026,
	author = {Somefun, Tobiloba Emmanuel and Ebenezer, Esenogho},
	title = {Techno-economic sizing of constrained microgrids using multivariate deep learning and Dc-coupled solar-plus-storage integration},
