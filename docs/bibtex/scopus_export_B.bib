@ARTICLE{Zaro2026249,
	author = {Zaro, Fouad},
	title = {Fault-Aware AI-Based Load Scheduling for Industrial Facilities Using Machine Learning–Driven Demand-Side Management},
	year = {2026},
	journal = {WSEAS Transactions on Systems and Control},
	volume = {21},
	pages = {249 - 261},
