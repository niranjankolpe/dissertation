	author = {Mwigereri, Dorcas G. and Ochieng, Francis Xavier and Ouma, Joseph and Mwai, Zacharia and Mwalili, Tobias},
	title = {Evaluation of weather research forecasting-solar radiation schemes for solar power forecasting in equatorial Africa},
