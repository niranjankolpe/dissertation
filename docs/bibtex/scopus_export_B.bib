	author = {Suemitsu, Issei and Kono, Toru and Wakabayashi, Ryo and Tsunoda, Jun and Yamaguchi, Yosuke and Wei, Wenpeng},
	title = {From Empirical Analysis to Mixture-of-Experts Modeling: Zero-Shot Cross-Frequency Forecasting in Real-Time Photovoltaic Management},
