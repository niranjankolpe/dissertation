@ARTICLE{Chen2025,
	author = {Chen, Yun and Liu, Jilei and Liu, Bei and Liu, Shipeng and Zhang, Dongdong},
	title = {Research on Photovoltaic Long-Term Power Prediction Model Based on Superposition Generalization Method},
	year = {2025},
	journal = {Processes},
	volume = {13},
