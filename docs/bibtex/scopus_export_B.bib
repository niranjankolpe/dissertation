	author = {Alsafrani, Abdulrahman and Sherazi, Hammad I. and Alrumayh, Omar and Habib, Shabana and Alburidy, Abdullah A. and Islam, Muhammad},
	title = {Photovoltaic Power Forecasting for Sustainable Grid Integration: A Hybrid Deep Learning Approach},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {216013 - 216025},
