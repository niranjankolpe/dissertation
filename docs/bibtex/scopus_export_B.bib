	year = {2022},
	journal = {Energies},
	volume = {15},
	number = {17},
	pages = {},
	doi = {10.3390/en15176191},
	url = {https://www.scopus.com/pages/publications/85137857160?origin=resultslist},
	affiliations = {Laboratory of Atmospheric Physics, Physics Department, University of Patras, Patras, 26500, Greece; German Aerospace Center (DLR), Institute of Solar Research, Paseo de Almería 73, Almería, 04001, Spain; Bern, Meteotest, 3012, Switzerland; CIEMAT Energy Department, Renewable Energy Division, Av. Complutense 40, Madrid, 28040, Spain; National Renewable Energy Laboratory, 1617 Cole Blvd, Golden, 80401, CO, United States; CSEM Center Alpnach, Alpnach Dorf, 6055, Switzerland; PROMES-CNRS, Rambla de la Thermodynamique, Perpignan, 66100, France; Copernicus Institute of Sustainable Development, Utrecht University, Princetonlaan 8, Utrecht, 3584 CB, Netherlands; EKO INSTRUMENTS Europe B.V., AL, Den Haag, 2521, Netherlands; PROMECA Ingénierie, 1 rue des Iles, Domène, 38420, France; PROMES Laboratory of Processes, Materials and Solar Energy, Rambla de la Thermodynamique, Université de Perpignan, Perpignan, 66100, France},
	abstract = {Solar forecasting constitutes a critical tool for operating, producing and storing generated power from solar farms. In the framework of the International Energy Agency’s Photovoltaic Power Systems Program Task 16, the solar irradiance nowcast algorithms, based on five all-sky imagers (ASIs), are used to investigate the feasibility of ASIs to foresee ramp events. ASIs 1–2 and ASIs 3–5 can capture the true ramp events by 26.0–51.0% and 49.0–92.0% of the cases, respectively. ASIs 1–2 provided the lowest (<10.0%) falsely documented ramp events while ASIs 3–5 recorded false ramp events up to 85.0%. On the other hand, ASIs 3–5 revealed the lowest falsely documented no ramp events (8.0–51.0%). ASIs 1–2 are developed to provide spatial solar irradiance forecasts and have been delimited only to a small area for the purposes of this benchmark, which penalizes these approaches. These findings show that ASI-based nowcasts could be considered as a valuable tool for predicting solar irradiance ramp events for a variety of solar energy technologies. The combination of physical and deep learning-based methods is identified as a potential approach to further improve the ramp event forecasts. © 2022 by the authors.},
	author_keywords = {all-sky imagers; forecasting; ramp events; solar irradiance ramp event forecasting},
	keywords = {Deep learning; Solar energy; Solar power generation; Solar radiation; All-sky imager; International energy agency; Nowcast; Photovoltaic power systems; Power; Ramp events; Solar forecasting; Solar irradiance ramp event forecasting; Solar irradiances; Forecasting},
