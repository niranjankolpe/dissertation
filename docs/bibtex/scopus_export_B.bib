	pages = {},
	doi = {10.1016/j.apenergy.2022.120020},
	url = {https://www.scopus.com/pages/publications/85139847762?origin=resultslist},
	affiliations = {Technical University of Denmark (DTU), Energy Economics and Modeling Section, Produktionstorvet, Building 424, Kongens Lyngby, 2800, Denmark; Technische Universität Berlin, Working Group Production and Operations Management, Office ID H85, Straße des 17. Juni 135, Berlin, 10623, Germany},
	abstract = {Buildings are one of the main drivers of global energy consumption and CO<sub>2</sub> emissions. Efficient energy management systems will have to integrate renewable energy sources with heating and/or cooling to mitigate climate change. In this study, we analyze the potential of deep reinforcement learning (DRL) to control a smart home with a modulating air-to-water heat pump, a photovoltaic system, a battery energy, and a thermal storage system for floor heating and hot water supply. We transform a mixed-integer linear program (MILP) into a DRL implementation. In our numerical analysis, we compare our results based on the deep deterministic policy gradient (DDPG) algorithm to the theoretical upper bound of the model predictive control (MPC) result under full information, as well as a practice-oriented rule-based benchmark. We show that our proposed DRL implementation outperforms the rule-based approach and achieves a self-sufficiency of 75% with only limited comfort violations. Analyzing different DRL formulations, we conclude that domain knowledge is key to formalizing an efficient decision problem with stable results. Our input data and models, developed using the Julia programming language, are available open source. © 2022 The Authors},
	author_keywords = {Building energy management; Deep deterministic policy gradient (DDPG); Heat pump; Home energy management; Photovoltaics (PV); Reinforcement learning},
	keywords = {Automation; Climate change; Deep learning; Digital storage; Energy efficiency; Energy management; Energy management systems; Energy utilization; Heat pump systems; Heat storage; Integer programming; Learning systems; Model predictive control; Predictive control systems; Pumps; Building energy managements; Deep deterministic policy gradient; Deterministics; Heat pumps; Home energy managements; Photovoltaic; Photovoltaic systems; Photovoltaics; Policy gradient; Reinforcement learnings; alternative energy; energy management; self sufficiency; Reinforcement learning},
	correspondence_address = {L. Langer; Technical University of Denmark (DTU), Energy Economics and Modeling Section, Kongens Lyngby, Produktionstorvet, Building 424, 2800, Denmark; email: lilang@dtu.dk},
