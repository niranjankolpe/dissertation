@CONFERENCE{Gerges2023102,
	author = {Gerges, Firas and Boufadel, Michel C. and Bou-Zeid, Elie and Nassif, Hani and Wang, Jason T. L.},
	title = {Deep Learning-Enabled Prediction of Daily Solar Irradiance from Simulated Climate Data},
	year = {2023},
	journal = {ACM International Conference Proceeding Series},
