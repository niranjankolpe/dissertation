	volume = {426},
	pages = {1178 - 1190},
	doi = {10.3233/FAIA260965},
	url = {https://www.scopus.com/pages/publications/105052576063?origin=resultslist},
	affiliations = {School of Electrical, Electronics and Computer Engineering, Mapua University, Manila, Philippines},
	abstract = {The global shift towards renewable energy has elevated solar power as a critical resource, yet inefficiencies in energy management persist, particularly in small-scale and off-grid solar systems. These systems, often using simple controllers, struggle with fluctuating weather conditions, leading to energy waste, battery degradation, and system downtime, a challenge especially relevant in solar-rich regions like the Philippines. This study aimed to design and implement a smart, ESP32-based wireless sensor node powered by a 100W solar panel and a LiFePO4 battery to optimize energy use. The project's scope involved integrating environmental and power sensors (DHT22, BH1750, INA226) to collect real-time data, developing two solar forecasting models - a Feedforward Neural Network (FNN) and Logistic Regression (LR) - and deploying them directly on the ESP32 microcontroller. The methodology centered on a comparative experimental design, evaluating system performance under three configurations: FNN-based management, LR-based management, and a baseline with no machine learning. The results demonstrated that the FNN model achieved superior forecasting accuracy (98.93%) and the highest energy harvesting efficiency (92.4%), extending battery life by 18.6% compared to the non-ML baseline. The LR model also showed significant improvements over the baseline, offering a balance of performance and computational efficiency. It was concluded that integrating lightweight machine learning models, particularly FNNs, directly onto sensor nodes provides a robust and effective solution for optimizing solar energy utilization, enhancing predictive accuracy, and significantly extending battery lifespan in autonomous, off-grid applications. © 2026 The Authors.},
	author_keywords = {Energy Management System; Feedforward Neural Network (FNN); Logistics Regression; Solar Energy Forecasting; Wireless Sensor Networks (WSNs)},
	keywords = {Battery management systems; Computational efficiency; Energy efficiency; Energy harvesting; Energy utilization; Forecasting; Learning systems; Logistic regression; Logistics; Machine learning; Phosphorus compounds; Secondary batteries; Solar energy; Energy; Energy forecasting; Feed forward; Feedforward neural network; Logistics regressions; Management systems; Neural-networks; Sensors network; Solar energy forecasting; Wireless sensor; Wireless sensor network; Sensor nodes},
