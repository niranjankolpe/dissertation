	affiliations = {Faculty of Electrical and Control Engineering, Liaoning Technical University, Liaoning, Huludao, China},
	abstract = {Accurate short-term forecasting of hybrid solar-wind renewable power is essential for improving grid stability and renewable energy dispatch efficiency under highly variable meteorological conditions. However, conventional deep learning forecasting models often require extensive offline training and high computational resources, limiting their applicability in low-latency edge-side renewable forecasting environments. To address these challenges, a physics-guided adaptive-forgetting multi-input single-output model-free adaptive control (PI-AF-MISO-MFAC) framework is developed for ultra-short-term renewable power forecasting. The method combines recursive pseudo-partial derivative estimation with a dual-source adaptive forgetting mechanism and lightweight physics-guided projection constraints to improve online prediction stability under rapidly changing renewable operating conditions. Unlike conventional MFAC control applications, the recursive formulation is interpreted here as an online forecasting update mechanism driven by historical meteorological observations. Experiments on the German 2016 renewable energy dataset demonstrate that PI-AF-MISO-MFAC achieves lower one-step-ahead forecasting errors than several statistical, machine learning, and deep learning benchmark models, including ARIMA, XGBoost, Informer, TCN, and N-BEATS. For hybrid renewable generation forecasting, the proposed method achieves an MAE of 23.6 kW while maintaining low computational complexity and stable parameter evolution across different seasonal and meteorological conditions. These results indicate that the developed approach provides a physically guided and computationally efficient recursive forecasting solution for ultra-short-term renewable energy prediction. © 2026 The Author(s). IET Generation, Transmission & Distribution published by John Wiley & Sons Ltd on behalf of The Institution of Engineering and Technology.},
	author_keywords = {adaptive forgetting; hybrid solar-wind generation; model-free adaptive control; online recursive prediction; physics-guided constraints; ultra-short-term renewable power forecasting},
	keywords = {Adaptive control systems; Deep learning; Electric power system stability; Hybrid power; Learning systems; Solar power generation; Solar wind; Weather forecasting; Wind forecasting; Wind power; Adaptive forgetting; Hybrid solar-wind; Hybrid solar-wind generation; Model-free adaptive control; Online recursive prediction; Physic-guided constraint; Power forecasting; Recursive prediction; Renewable Power; Ultra-short-term renewable power forecasting; Wind generation; Meteorology},
	correspondence_address = {Z. Zhang; Faculty of Electrical and Control Engineering, Liaoning Technical University, Huludao, Liaoning, China; email: zzyi2099@163.com},
	publisher = {John Wiley and Sons Inc},
	issn = {17518687},
	language = {English},
	abbrev_source_title = {IET Gener. Transm. Distrib.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

