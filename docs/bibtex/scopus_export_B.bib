@ARTICLE{Visser202386,
	author = {Visser, Lennard and AlSkaif, Tarek and Hu, Jing and Louwen, Atse and van Sark, Wilfried},
	title = {On the value of expert knowledge in estimation and forecasting of solar photovoltaic power generation},
	year = {2023},
	journal = {Solar Energy},
	volume = {251},
	pages = {86 - 105},
	doi = {10.1016/j.solener.2023.01.019},
	url = {https://www.scopus.com/pages/publications/85146452123?origin=resultslist},
	affiliations = {Copernicus Institute of Sustainable Development, Utrecht University, Princetonlaan 8a, Utrecht, 3584 CB, Netherlands; Institute for Renewable Energy, EURAC Research, Viale Druso 1, Bolzano, 39100, Italy; Information Technology Group, Wageningen University and Research, Droevendaalsesteeg 4, Wageningen, 6708 PB, Netherlands},
	abstract = {Reliable estimates and forecasts of Photovoltaic (PV) power output form a fundamental basis to support its large-scale integration. This is recognized in literature, where a growing amount of studies deal with the development of PV power estimation and forecasting models. In particular, machine learning techniques received significant attention in the past decade. Yet, the importance of predictor variables are consistently ignored in such developments and as a result those models fail to acknowledge the value of including physics-based models. In this study we quantify the value of predictor variables for PV power estimation and forecasting, assess deficiencies in estimation and forecasting models, and introduce a number of pre-processing steps to improve the overall estimation or forecasting performance. To this end, we use common physical models to create so-called expert variables and test their impact on the performance of single-point and probabilistic models. In addition, we investigate the optimal selection of predictor variables for PV power estimation and forecasting. By means of a sensitivity analysis, the paper shows how the value of expert variables is affected by the tilt angle of the PV system. To allow for a deeper insight into the importance of predictor variables, two case studies in different climate regions are considered in the numerical evaluation. © 2023 The Author(s)},
	author_keywords = {Meteorological variables; Photovoltaics; Predictor variables; Solar power estimation; Solar power forecasting},
	keywords = {Forecasting; Learning systems; Sensitivity analysis; Solar power generation; Estimation models; Forecasting models; Meteorological variables; Photovoltaic power; Photovoltaics; Power estimations; Power forecasting; Predictor variables; Solar power estimation; Solar power forecasting; estimation method; machine learning; meteorology; performance assessment; photovoltaic system; power generation; solar power; Solar energy},
