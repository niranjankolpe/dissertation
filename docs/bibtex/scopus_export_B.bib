@ARTICLE{Zhang2024,
	author = {Zhang, Yuhao and Li, Ting and Ma, Tianyi and Yang, Dongsheng and Sun, Xiaolong},
	title = {Short-Term Photovoltaic Power Prediction Based on Extreme Learning Machine with Improved Dung Beetle Optimization Algorithm},
	year = {2024},
