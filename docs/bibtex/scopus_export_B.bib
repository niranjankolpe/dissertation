	title = {A Novel Reinforcement-Learning-Based Compensation Strategy for DMPC-Based Day-Ahead Energy Management of Shipboard Power Systems},
	year = {2024},
	journal = {IEEE Transactions on Smart Grid},
	volume = {15},
	number = {5},
