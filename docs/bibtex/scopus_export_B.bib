@ARTICLE{Zidoum2026,
	author = {Zidoum, Hamza and Ibrahim, Haneen},
	title = {A cross-location evaluation of temporal fusion transformers and LSTM for long-term solar PV forecasting in arid environments},
	year = {2026},
	journal = {Energy Informatics},
