@ARTICLE{Davidescu2026,
	author = {Davidescu, Adriana Ana Maria and Petcu, Monica Aureliana and Curea, Stefania Cristina and Manta, Eduard Mihai and Popa, Diana},
	title = {The economic impact of the innovative forecast of solar energy production based on machine learning and neural network models},
	year = {2026},
