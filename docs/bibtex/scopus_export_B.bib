@ARTICLE{Demir2026,
	author = {Demir, Ahmet and Najafi, Atabak},
	title = {Diffusion-Augmented LSTM for Improved Generalization in Cross-Site Solar Power Forecasting},
	year = {2026},
	journal = {International Transactions on Electrical Energy Systems},
	volume = {2026},
	number = {1},
	pages = {},
