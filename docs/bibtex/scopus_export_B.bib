@ARTICLE{Oliveira2026,
	author = {Oliveira, João and Santos, Tiago and Correia, Fernanda Brito and Farinha, José Torres and Monteiro, Jânio and Mendes, Mateus},
	title = {A Digital Twin Inspired Simulation Framework for Optimizing Renewable Energy Communities},
	year = {2026},
	journal = {Algorithms},
	volume = {19},
	number = {8},
	pages = {},
	doi = {10.3390/a19080690},
	url = {https://www.scopus.com/pages/publications/105048320811?origin=resultslist},
	affiliations = {Coimbra Institute of Engineering, Polytechnic University of Coimbra, Rua da Misericórdia, Lagar dos Cortiços–S. Martinho do Bispo, Coimbra, 3045-093, Portugal; RCM2+ — Research Centre in Asset Management and Systems Engineering, Polytechnic University of Coimbra, Rua Pedro Nunes, Coimbra, 3030-199, Portugal; Instituto Superior de Engenharia, Universidade do Algarve, Faro, 8005-139, Portugal},
	abstract = {The energy transition requires efficient management of decentralized resources, in which Renewable Energy Communities (RECs) play an increasingly important role. However, the variability of solar generation and the unpredictability of consumption create complex balancing challenges. To address the limitations of existing planning tools—which often rely on synthetic profiles or small-scale validations—this study presents a data-driven Digital Twin-inspired simulation framework The unique contribution of this work lies in the combination of three elements: the use of high-resolution sub-hourly smart-meter data, the application of a novel demographic filtering methodology to accurately isolate permanent community load profiles, and the integration of an AI-driven N-HiTS (Neural Hierarchical Interpolation for Time Series) forecasting model. The framework was implemented using the PyECOM simulation engine and applied to the Culatra Island Energy Community, Portugal, processing empirical data from 338 dwellings. Multiple scenarios were evaluated, including demand flexibility, photovoltaic (PV) expansion, and battery energy storage (BESS) deployment. The baseline scenario revealed a substantial dependence on the external grid, with a Self-Sufficiency (SS) rate of 12.51%. Expanding PV capacity by 200 kWp increased SS to 32.1% but generated significant energy surpluses. The optimal configuration, integrating a 600 kWh BESS, increased SS to 37.3% while restoring the Self-Consumption (SC) rate to 99.8%. Furthermore, the integrated N-HiTS predictive model achieved a coefficient of determination of 0.64 under highly variable weather conditions. Ultimately, the results demonstrate the critical value of combining empirical simulation, optimized storage sizing, and advanced forecasting techniques to support robust REC planning. © 2026 by the authors.},
	author_keywords = {battery energy storage system; digital twin; microgrid optimization; N-HiTS forecasting; renewable energy community},
	keywords = {Balancing; Data handling; Digital storage; Forecasting; Secondary batteries; Solar energy; Solar power generation; Battery energy storage systems; Energy; Microgrid; Microgrid optimization; Neural hierarchical interpolation for time series forecasting; Optimisations; Photovoltaics; Renewable energy community; Simulation framework; Time series forecasting; Digital twin},
	correspondence_address = {J. Oliveira; Coimbra Institute of Engineering, Polytechnic University of Coimbra, Coimbra, Portugal; email: a2023136541@isec.pt; M. Mendes; Coimbra Institute of Engineering, Polytechnic University of Coimbra, Coimbra, Rua da Misericórdia, Lagar dos Cortiços–S. Martinho do Bispo, 3045-093, Portugal; email: mmendes@isec.pt; T. Santos; RCM2+ — Research Centre in Asset Management and Systems Engineering, Polytechnic University of Coimbra, Coimbra, Rua Pedro Nunes, 3030-199, Portugal; email: tiago@ualg.pt},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {19994893},
	language = {English},
	abbrev_source_title = {Algorithms},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Sfar2026,
	author = {Sfar, Wissal and Amhaimar, Lahcen and Khalidi, Abderrahim and Talbi, Bouchra},
	title = {A hybrid long-term photovoltaic power prediction model integrating a BiLSTM network with residual correction via CatBoost},
	year = {2026},
	journal = {Results in Engineering},
	volume = {29},
	pages = {},
	doi = {10.1016/j.rineng.2025.108898},
	url = {https://www.scopus.com/pages/publications/105027925768?origin=resultslist},
	affiliations = {Modeling and Simulation of Intelligent Industrial Systems Laboratory, Design, Information Technology and Artificial Intelligence Team, ENSAD, ENSET, Hassan II University, Casablanca, Morocco},
	abstract = {To improve the power output of PV solar panels and facilitate their integration into the power grid, accurate PV power forecasting is important for managing the instability of their output, given the variation in weather conditions. This study uses a hybrid approach that applies bidirectional long short-term memory (BiLSTM) with categorical boosting algorithm (CatBoost) for long-term PV power forecasting. The proposed framework aims to improve the accuracy of photovoltaic production forecasts by using BiLSTM to perform temporal forecasting and the CatBoost model for the residual correction. The BiLSTM–CatBoost hybrid model is evaluated under three real-weather conditions (sunny, cloudy, and rainy) using real-world photovoltaic data, ensuring that the assessment reflects actual operating scenarios. To validate the performance of the proposed model, we compare the BiLSTM–CatBoost hybrid against several baseline and reference architectures, including the persistence model, LSTM, BiLSTM, LSTM–XGBoost, LSTM–CatBoost, and BiLSTM–XGBoost. Using real-world PV data, the experimental results show that the BiLSTM–CatBoost model consistently achieves superior accuracy across all weather conditions, reaching a mean absolute error (MAE) of 2.808 kW and an average R^2 score of 0.9998. These comparative results demonstrate not only the robustness of the hybrid approach under diverse atmospheric scenarios but also its strong potential for reliable, real-time photovoltaic forecasting. © 2025 The Author(s).},
	author_keywords = {Artificial intelligence; BiLSTM; CatBoost; Hybrid deep learning model; Long-term prediction; Pv power forecasting},
	keywords = {Hybrid power; Learning systems; Memory architecture; Meteorology; Photovoltaics; Weather forecasting; Bidirectional long short-term memory; Boosting algorithm; Categorical boosting algorithm; Condition; Hybrid deep learning model; Learning models; Long-term prediction; Power forecasting; Pv power forecasting; Short term memory; Long short-term memory},
	correspondence_address = {W. Sfar; Modeling and Simulation of Intelligent Industrial Systems Laboratory, Design, Information Technology and Artificial Intelligence Team, ENSAD, ENSET, Hassan II University, Casablanca, Morocco; email: sfarwissal2@gmail.com},
	publisher = {Elsevier B.V.},
	issn = {25901230},
	language = {English},
	abbrev_source_title = {Result.  Eng.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Surathunmanun2026,
	author = {Surathunmanun, Surasak and Ongsakul, Weerakorn and Singh, Jai Govind and Mehran, Kamyar},
	title = {Short-term solar PV forecasting in microgrids using cloud top temperature and vision transformer based models},
	year = {2026},
	journal = {Frontiers in Energy Research},
	volume = {13},
	pages = {},
	doi = {10.3389/fenrg.2025.1691881},
	url = {https://www.scopus.com/pages/publications/105027923107?origin=resultslist},
	affiliations = {Department of Energy and Climate Change, School of Environment, Resources and Development, Asian Institute of Technology, Pathum Thani, Thailand; School of Electronic Engineering and Computer Science, Queen Mary University of London, London, United Kingdom},
	abstract = {Introduction: Expanding clean-energy microgrids in remote areas is essential for achieving global decarbonisation and energy transition goals. Accurate short-term solar photovoltaic (PV) forecasting plays a key role in reducing diesel dependence, improving battery scheduling, and enabling reliable integration of renewable energy. However, forecasting remains challenging in many developing regions due to the lack of ground-based irradiance sensors, cloud cameras, and real-time monitoring infrastructure. Methods: This paper proposes a novel forecasting framework, termed CTT–ViT–Transformer, which integrates Generative AI techniques to enhance short-term solar PV forecasting in sensor-constrained microgrids. The framework employs Cloud Top Temperature (CTT) satellite imagery, capturing cloud height and thermal characteristics, processed through a Vision Transformer (ViT) for spatial feature extraction and a Transformer model for time-series prediction. Results: The proposed framework is evaluated using operational data from a real-world islanded microgrid. Results indicate that a standard Transformer model outperforms LSTM and CNN-LSTM baselines, achieving a mean absolute error (MAE) of 23.45 kW, root mean square error (RMSE) of 28.24 kW, and R² of 0.93. The CTT–ViT–Transformer further improves forecasting accuracy, reducing errors to an MAE of 15.99 kW and RMSE of 24.28 kW with an R² of 0.97, and consistently outperforms models relying on RGB satellite imagery. High predictive accuracy is maintained across four-step-ahead forecasts, with R² values exceeding 0.96. Discussion: The proposed approach requires no ground-based irradiance sensors, lowering adoption barriers for resource-constrained microgrids while remaining compatible with sensor-based data when available. Its scalability supports proactive energy management in the carbon-neutral microgrid on Koh Paluay Island by enabling more efficient scheduling of renewable generation and energy storage, thereby reducing fossil fuel use and operational costs. By enabling affordable and accurate forecasting, this framework aligns with Sustainable Development Goal 7 (Affordable and Clean Energy) and Sustainable Development Goal 13 (Climate Action), contributing to a just and sustainable global energy transition. Copyright © 2026 Surathunmanun, Ongsakul, Singh and Mehran.},
	author_keywords = {cloud top temperature; microgrid; photovoltaic power prediction; sensorless forecasting; solar forecasting; transformer; vision transformer},
	keywords = {Digital storage; Energy management; Fossil fuels; Fuel storage; Image enhancement; Microgrids; Potassium hydroxide; Renewable energy; Solar power generation; Weather forecasting; Cloud-top temperatures; Microgrid; Photovoltaic power; Photovoltaic power prediction; Power predictions; Sensorless; Sensorless forecasting; Solar forecasting; Transformer; Vision transformer; Mean square error; Satellite imagery},
	correspondence_address = {S. Surathunmanun; Department of Energy and Climate Change, School of Environment, Resources and Development, Asian Institute of Technology, Pathum Thani, Thailand; email: st124740@ait.ac.th; W. Ongsakul; Department of Energy and Climate Change, School of Environment, Resources and Development, Asian Institute of Technology, Pathum Thani, Thailand; email: ongsakul@ait.asia},
	publisher = {Frontiers Media SA},
	issn = {2296598X},
	language = {English},
	abbrev_source_title = {Front. Energy Res.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Bashe20264371,
	author = {Bashe, Mantombi and Shoko, Claris and Ravele, Thakhani and Sigauke, Caston},
	title = {Leveraging Hierarchical Time Series to Enhance Short - Term Electricity Consumption Forecasts: A Case Study of South Africa},
	year = {2026},
	journal = {Statistics, Optimization and Information Computing},
	volume = {15},
	number = {5},
	pages = {4371 - 4398},
	doi = {10.19139/soic-2310-5070-3194},
	url = {https://www.scopus.com/pages/publications/105035841027?origin=resultslist},
	affiliations = {Eskom Holdings SOC Ltd, South Africa; Department of Statistics, University of Botswana, Botswana; Department of Mathematical and Computational Sciences, University of Venda, South Africa},
	abstract = {Accurate short-term electricity consumption forecasts are essential for maintaining grid stability and for developing effective energy policies. In this study, we propose a novel multilevel forecasting methodology that enhances forecast accuracy by carefully combining and reconciling the outputs of multiple machine learning models. Using high-frequency data from South Africa, we apply Stochastic Gradient Boosting (SGB) and XGBoost to model the consumption attributed to key energy sources: solar (PV and CSP), coal, diesel, nuclear, and wind. One of the important implications is that forecast performance varies across energy sources. The performance of XGBoost outperforms that of the SGB model for solar, coal, and diesel consumption, while the SGB model performs best for nuclear and wind energy. This split points to the importance of source-specific models. We also demonstrate that a reconciled ensemble of these models yields the most accurate and robust overall forecasts, particularly for complex, non-renewable sources. Beyond point estimates, we evaluate probabilistic prediction intervals and demonstrate that linear quantile regression provides a significant improvement over the benchmark linear regression, resulting in sharper intervals with narrower widths and better scores, without sacrificing coverage. This study fills a gap in the literature by providing a validated, scalable framework that utilises a reconciled ensemble of methods to enhance forecast quality. The results provide clear, actionable guidance for energy planners and policymakers seeking to optimise the generation mix to provide a reliable electricity supply. Copyright © 2026 International Academic Press},
	author_keywords = {electricity consumption; energy sources; Forecast combinations; hierarchical time series; renewable energy},
	correspondence_address = {T. Ravele; Department of Mathematical and Computational Sciences, University of Venda, South Africa; email: thakhani.ravele@univen.ac.za},
	publisher = {International Academic Press},
	issn = {2311004X},
	language = {English},
	abbrev_source_title = {Stat. Optim. Inf. Comput.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Alqahtani2026,
	author = {Alqahtani, Mohammed H. and Aljumah, Ali S. and Shaheen, Abdullah M. and Atiea, Mohammed A.},
	title = {Robust PV fault diagnosis under data constraints using a hybrid vision transformer with cross-attention fusion and uncertainty-aware explainability},
	year = {2026},
	journal = {Scientific Reports},
	volume = {16},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-026-66049-4},
	url = {https://www.scopus.com/pages/publications/105047651666?origin=resultslist},
	affiliations = {Department of Electrical Engineering, College of Engineering, Prince Sattam bin Abdulaziz University, Al Kharj, 16278, Saudi Arabia; Department of Electrical Engineering, Faculty of Engineering, Suez University, P.O. Box: 43221, Suez, Egypt; Computer Science Department, Faculty of Computers and Information, Suez University, P.O. Box: 43221, Suez, Egypt},
	abstract = {Solar photovoltaic (PV) systems are crucial in modern energy infrastructures for the shift to sustainable renewable energy, making accurate and reliable fault diagnosis essential for maximizing energy yield, operational efficiency, and system availability. However, reliable automated fault diagnosis faces challenges like data scarcity, class imbalance, and lack of calibrated uncertainty in deep learning models. This paper introduces HyViX-PV, a hybrid deep learning framework that integrates EfficientNet-B3 and Vision Transformer (ViT-B/16) through a novel cross-attention fusion mechanism to enhance renewable PV monitoring and its associated energy efficiency. Unlike conventional static fusion approaches, the proposed HyViX-PV module dynamically combines local texture features and global contextual representations via learnable query–key interactions, enabling adaptive feature prioritization based on input characteristics. The presented framework incorporates Monte Carlo dropout for uncertainty quantification, facilitating confidence-aware decision-making and selective prediction abstention. In addition, a multi-granularity explainability pipeline, combining Grad-CAM, attention roll-out, and fusion weight analysis, provides transparent and interpretable diagnostic insights aligned with domain expert reasoning. The proposed model is evaluated using a five-fold cross-validation, a locked test set, and hash-based data leakage prevention. Experimental results demonstrate that HyViX-PV achieves 92.22% accuracy and 0.9230 macro F1-score, outperforming state-of-the-art CNN, ViT, and hybrid baselines while maintaining efficient inference. Cross-dataset validation shows strong generalization with only a 1.05% performance drop. Furthermore, it attains 92.66% accuracy and 0.9364 macro F1-score robustness under severe class imbalance realistic scenarios. By enabling dependable, interpretable, and uncertainty-aware fault diagnosis, the proposed framework supports improved reliability, reduced maintenance costs, and enhanced operational performance of solar PV installations, contributing to the broader adoption and effective utilization of renewable energy systems. © The Author(s) 2026.},
	author_keywords = {Cross-attention fusion; Explainable AI (XAI); Hybrid vision transformer; Photovoltaic fault detection; Renewable energy monitoring; Uncertainty quantification},
	keywords = {article; cross validation; deep learning; diagnosis; energy yield; explainable artificial intelligence; human; hybrid; photovoltaics; prediction; prevention; reliability; renewable energy; uncertainty; vision},
	correspondence_address = {A.M. Shaheen; Department of Electrical Engineering, Faculty of Engineering, Suez University, Suez, P.O. Box: 43221, Egypt; email: abdullah.mohamed.eng19@suezuni.edu.eg},
	publisher = {Nature Research},
	issn = {20452322},
	pmid = {42613391},
	language = {English},
	abbrev_source_title = {Sci. Rep.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Khalimonenko2026,
	author = {Khalimonenko, Nazar and Kozak, Liudmyla and Petrenko, Bohdan and Kronberg, Elena A.},
	title = {Forecasting geomagnetic Kp index using Long Short-Term Memory-Attention model},
	year = {2026},
	journal = {Journal of Atmospheric and Solar-Terrestrial Physics},
	volume = {284},
	pages = {},
	doi = {10.1016/j.jastp.2026.106839},
	url = {https://www.scopus.com/pages/publications/105039653122?origin=resultslist},
	affiliations = {Taras Shevchenko National University of Kyiv, Volodymyrska Street, 60, Kyiv, 01601, Ukraine; Space Research Institute of the National Academy of Sciences of Ukraine and the State Space Academy of Ukraine, 40 bld.4/1, Akademika Hlushkova avenue, Kyiv, 03187, Ukraine; Geophysics Department of Earth and Environmental Sciences, Ludwig-Maximilians-Universität München, Munich, Germany},
	abstract = {Forecasting geomagnetic activity is a critical challenge in space weather research due to its impact on satellite operations, navigation systems, power grid stability, and aviation safety. This paper presents a deep learning approach for predicting the planetary geomagnetic index Kp by employing a hybrid sequence-to-sequence architecture that combines Long Short-Term Memory (LSTM) units with a Multi-Head Attention mechanism. The architecture is designed to capture both short- and long-term dependencies within solar wind and interplanetary magnetic field parameters, as well as historical Kp values. Utilizing data spanning two solar cycles (1995–2020) from the OMNIWeb database, the original hourly solar wind and plasma characteristics were aggregated into 3-hour blocks to align with standard Kp intervals. We framed the forecasting problem as a multi-class classification task predicting across 28 discrete Kp classes. To address the severe class imbalance inherent in geomagnetic data, where quiet conditions vastly outnumber extreme storms, we implemented a custom weighted Sparse Categorical Crossentropy loss function. By applying class-specific sample weights capped at a strict threshold, we shifted the network’s sensitivity toward detecting rare, severe magnetic storms (Kp≥5.0) while managing the trade-off with false alarms. Experimental results, evaluated using the F<sub>2</sub>-score with a physically acceptable ±1.0 Kp tolerance, reveal a distinct temporal shift in predictive capabilities compared to a rigorously tuned baseline LSTM model. While the standard LSTM effectively captures short-term precursors (3 to 12 h ahead), it loses predictive skill over extended horizons. In contrast, the integration of the Multi-Head Attention mechanism enables the hybrid model to isolate and retain sparse historical triggers, preserving the predictive signal for severe storms at longer forecasting horizons (15 to 18 h). Copyright © 2026. Published by Elsevier Ltd.},
	author_keywords = {Attention; Geomagnetic activity forecasting; Kp index; LSTM},
	keywords = {Forecasting; Geomagnetism; Long short-term memory; Magnetoplasma; Memory architecture; Solar power satellites; Solar system; Solar wind; Storms; Activity forecasting; Attention; Attention mechanisms; Attention model; Geomagnetic activities; Geomagnetic activity forecasting; Geomagnetics; Kp index; Short term memory; Solar/wind; Economic and social effects},
	correspondence_address = {N. Khalimonenko; Taras Shevchenko National University of Kyiv, Kyiv, Volodymyrska Street, 60, 01601, Ukraine; email: uzer2012uhu@gmail.com},
	publisher = {Elsevier Ltd},
	issn = {13646826},
	language = {English},
	abbrev_source_title = {J. Atmos. Sol.-Terr. Phys.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@ARTICLE{Gjylapi2026356,
	author = {Gjylapi, Dezdemona and Hyso, Alketa and Denaj, Astrit},
	title = {Hybrid Physics-Informed Temporal Attention Model with External Physical Constraints for PV Power Forecasting},
	year = {2026},
	journal = {Baltic Journal of Modern Computing},
	volume = {14},
	number = {2},
	pages = {356 - 375},
	doi = {10.22364/bjmc.2026.14.2.05},
	url = {https://www.scopus.com/pages/publications/105043692944?origin=resultslist},
	affiliations = {University "Ismail Qemali" of Vlora, Vlora, Albania},
	abstract = {This paper introduces the Hybrid Physics-Informed Temporal Attention (H-PITA) model, a novel framework for accurate, physically consistent daily photovoltaic (PV) energy (kWh) forecasting. By integrating a temporal-attention encoder with external physical priors via gated fusion and a lightweight residual pathway, H-PITA balances data-driven learning with domain-specific constraints. The model incorporates physical knowledge through symmetric and asymmetric penalties, non-negativity constraints, and dynamic loss weighting, as well as an optional inference-time safety cap. Evaluated on a real-world PV system in Southeast Europe using a longitudinal dataset (2014–2025), H-PITA demonstrates superior performance over baselines including LSTM, XGBoost, persistence, climatology, and linear/ridge models, achieving a test R² of 0.78. Results indicate that data filtering and physical grounding significantly enhance generalization, reducing MAPE and RMSE. Overall, H-PITA provides a robust, modular, and transferable solution for risk-aware PV forecasting, making it highly suitable for operational grid integration and solar asset management. © 2026, University of Latvia. All rights reserved.},
	author_keywords = {Hybrid deep learning; Photovoltaic energy forecasting; Physical constraints; Physics-informed neural networks; PV systems; Renewable energy prediction; Temporal attention},
	publisher = {University of Latvia},
	issn = {22558942},
	language = {English},
	abbrev_source_title = {Baltic J. Mod. Comp.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Ferkous2025519,
	author = {Ferkous, Khaled and Bekkar, Belgacem and Menakh, Sarra and Guermoui, Mawloud},
	title = {A Robust Hybrid CEEMDAN-IF-BiLSTM Framework for Accurate Short-Term Photovoltaic Power Forecasting},
	year = {2025},
	journal = {WSEAS Transactions on Power Systems},
	volume = {20},
	pages = {519 - 528},
	doi = {10.37394/232016.2025.20.42},
	url = {https://www.scopus.com/pages/publications/105040196235?origin=resultslist},
	affiliations = {Laboratory of Materials, Technology of Energy Systems and Environment (LMTESE), Univercité de Ghardaia, Algeria; Laboratory of New and Renewable Energy in Aride Zones (LENREZA), University Kasdi Merbah – Ouargla, Algeria; Renewable Energy Applied Research Unit (URAER), Ghardaia, Algeria},
	abstract = {Predicting how much power solar panels will produce is a major hurdle for stable energy grids, largely because solar output is notoriously unpredictable, nonlinear, and constantly shifting. To tackle this, we’ve developed a hybrid deep learning framework designed for more accurate short-term forecasting. Our approach uses CEEMDAN to break down complex solar data into manageable components, paired with Iterative Filtering (IF) to pull out the most meaningful hidden patterns. These refined insights are then processed through a Bidirectional Long Short-Term Memory (BiLSTM) network. By combining these tools, our model captures the deep, time-sensitive relationships in solar generation that traditional methods often miss. Each component is then modeled using BiLSTM networks to capture bidirectional temporal dependencies, and the final forecast is obtained through signal reconstruction. The proposed model is evaluated using real-world PV datasets collected from Tindouf (Algeria), and its performance is compared with benchmark deep learning and decomposition-based approaches. Testing proves that this framework markedly boosts both the accuracy and reliability of solar power predictions. With an R<sup>2</sup> of 99.06 %, an RMSE of 158.20 kW, and an nRMSE of 6.15%, the model consistently leads the way over standard LSTM models and other hybrid setups. These outcomes validate the idea that combining CEEMDAN decomposition, precise time-frequency feature extraction, and bidirectional deep learning creates a powerful, dependable solution for short-term forecasting. By blending these specific techniques, the system manages to capture the nuance of solar data more effectively than previous methods. © 2025, World Scientific and Engineering Academy and Society. All rights reserved.},
	author_keywords = {BiLSTM; CEEMDAN; Hybrid Deep Learning; Instantaneous Frequency; Photovoltaic Power Forecasting; Time-Series Decomposition},
	publisher = {World Scientific and Engineering Academy and Society},
	issn = {17905060},
	language = {English},
	abbrev_source_title = {WSEAS Transact. Power Syst.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Tziolis2026,
	author = {Tziolis, Georgios and Livera, Andreas and Lopez-Lorente, Javier and Herodotou, Panagiotis and Makrides, George and Georghiou, George E.},
	title = {Machine learning-based short-term net load forecasting for residential buildings with integrated photovoltaic systems},
	year = {2026},
	journal = {Energy Reports},
	volume = {16},
	pages = {},
	doi = {10.1016/j.egyr.2026.109562},
	url = {https://www.scopus.com/pages/publications/105045922636?origin=resultslist},
	affiliations = {PV Technology Laboratory, Department of Electrical and Computer Engineering, University of Cyprus (UCY), Cyprus; PHAETHON Centre of Excellence (CoE) for Intelligent, Efficient and Sustainable Energy Solutions, Nicosia, Cyprus; DNV, Arnhem, 6812 AR, Netherlands},
	abstract = {Short-term net load forecasting (STNLF) is crucial for the efficient operation and management of residential buildings integrated with photovoltaic (PV) systems. However, the inherent variability of PV generation introduces significant uncertainty, leading to increased forecasting errors. To address this challenge, this study proposes a machine learning model based on Bayesian neural networks (BNNs) for direct STNLF in solar-integrated residential buildings. BNNs were selected due to their high forecasting accuracy under highly variable operating conditions. Historical data from households with rooftop PV systems in Cyprus were used for the model evaluation procedure. As such, the BNN model was tested across individual and aggregated households at 30- and 60-minute resolutions and benchmarked against a reference naïve persistence model (NPM). The BNN model achieved normalized root mean square error (nRMSE) values below 10% across all investigated households and resolutions. Furthermore, it recorded skill scores of up to 49.18% over the NPM. Moreover, the BNN model consistently outperformed the NPM under various irradiance conditions, demonstrating improved accuracy and robustness. Overall, the results prove the superiority of the BNN model and its potential for integration into grid operators' decision-making tools/platforms to enhance residential energy management. © 2026 The Authors.},
	author_keywords = {Machine learning; Net load forecasting; Photovoltaic systems; Residential buildings},
	keywords = {Bayesian networks; Decision making; Electric load forecasting; Housing; Machine learning; Mean square error; Neural networks; Photovoltaics; Bayesian neural network models; Bayesian neural networks; Building integrated; Load forecasting; Machine-learning; Net load forecasting; Operation and management; Persistence models; Photovoltaic systems; Residential building; Learning systems},
