@ARTICLE{Fan2026,
	author = {Fan, Yukun and Abuduwayiti, Xiwang},
	title = {Short-Term PV Power Generation Forecasting Based on Clustering CPO-VMD and Transformer Ensemble Neural Networks},
	year = {2026},
