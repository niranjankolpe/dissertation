	keywords = {Biomimetics; Convolution; Deep neural networks; Learning systems; Orchards; Privacy-preserving techniques; Recurrent neural networks; Sensitive data; Transfer learning; Convolutional neural network; Deep learning; Federated learning; Learning Transfer; Photovoltaic power; Photovoltaic power forecasting; Photovoltaic systems; Power forecasting; Privacy preserving; Transfer learning; Convolutional neural networks},
