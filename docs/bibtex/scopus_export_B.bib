@ARTICLE{Garcia Vera2025,
	author = {Garcia Vera, Yimy and Gallego, Andres and Camargo Cala, David and Mesa, Fredy},
	title = {Machine Learning Prediction of Thermal Losses in MonoPERC Solar Modules: A Novel Clustering Approach for Tropical Climate Applications},
	year = {2025},
	journal = {Energies},
	volume = {18},
