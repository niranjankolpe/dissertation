	note = {Cited by: 31; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Rokicki2026,
	author = {Rokicki, Tomasz and Bórawski, Piotr and Bełdycka-Bórawska, Aneta and Klepacki, Bogdan},
	title = {Predicting Negative Day-Ahead Electricity Prices Across 12 European Bidding Zones: A Gate-Closure-Audited Explainable Machine Learning Framework},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
